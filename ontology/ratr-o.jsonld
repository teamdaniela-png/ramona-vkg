      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#PalermoMeans",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The MEANS element of the Palermo Protocol Article 3(a) definition: 'the threat or use of force or other forms of coercion, of abduction, of fraud, of deception, of the abuse of power or of a position of vulnerability or of the giving or receiving of payments or benefits to achieve the consent of a person having control over another person'."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Palermo Means"
      },
      {
        "@language": "es",
        "@value": "Medio (Palermo)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.ohchr.org/en/instruments-mechanisms/instruments/protocol-prevent-suppress-and-punish-trafficking-persons"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Eight canonical sub-concepts from Article 3(a)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#OrganRemovalRecruitmentScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The offer promises medical treatment, paid egg donation, or a health procedure. The real purpose is extraction of organs (most commonly kidneys) or tissue for sale on the black market. Traffickers promise US$500 to US$10,000 that the victim often never receives. Documented in detail by the UNODC Assessment Toolkit on Trafficking in Persons for the Purpose of Organ Removal (2015, 60+ pages). Explicitly named as a purpose of trafficking by Article 3(a) of the Palermo Protocol (2000). Recruitment uses social media, word of mouth in vulnerable communities, and classifieds."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Organ removal recruitment scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de reclutamiento para extracción de órganos"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.unodc.org/documents/human-trafficking/2015/UNODC_Assessment_Toolkit_TIP_for_the_Purpose_of_Organ_Removal.pdf"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
