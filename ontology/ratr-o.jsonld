      {
        "@language": "en",
        "@value": "recruitment method name"
      },
      {
        "@language": "es",
        "@value": "nombre del método de reclutamiento"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
