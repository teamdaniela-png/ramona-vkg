  {
    "@id": "https://w3id.org/ratr-o#TIPEvent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A trafficking-in-persons event as defined by the International Classification Standard for Administrative Data on Trafficking in Persons (ICS-TIP, IOM and UNODC, 2023). The TIP event is the central unit of classification in ICS-TIP. In RATR-O a TIPEvent aggregates one victim with at least one Palermo Action, at least one Palermo Means, and at least one Palermo Purpose."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "TIP event"
      },
      {
        "@language": "es",
        "@value": "Evento de trata de personas"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Central unit of classification in ICS-TIP (IOM+UNODC 2023). Aggregates one Victim, at least one PalermoAction, one PalermoMeans and one PalermoPurpose."
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#CriminalLifeAspirationPost",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Condition AVC of Colmex 2025: the post expresses the desire to join criminal life as a life project (e.g. 'Al unico circulo social que me interesa pertenecer (en proceso)', 'Disfruto mi vida quizas manana ya no este')."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
