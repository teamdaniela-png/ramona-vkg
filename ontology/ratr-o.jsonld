    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#PressArticle",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An item of journalism used as the evidence anchor for a documented case. A subclass of :EvidenceSource. Press records in RATR-O are aggregated at the article level, with outlet, title, URL and classification only, and carry no personal data about the people the article names."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Press article"
      },
      {
        "@language": "es",
        "@value": "Artículo de prensa"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#EvidenceSource"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#TraffickingRisk",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Risk that the offer is recruitment for trafficking in persons in the sense of the Palermo Protocol: for forced labour, sexual exploitation, forced criminality, forced marriage or organ removal."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Trafficking recruitment risk"
      },
      {
        "@language": "es",
        "@value": "Riesgo de reclutamiento para trata"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#RiskClassification"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#Country",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A country or territory used as the origin, destination, stopover or jurisdiction of an offer, a route, a platform, a recruiter or a TIP event. Identified by its ISO 3166-1 code through :countryISOCode."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Country"
      },
      {
        "@language": "es",
        "@value": "País"
      }
    ]
  },
