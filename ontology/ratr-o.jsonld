    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The organisation or natural person named in a job offer as the party that would employ the candidate. Kept disjoint from :Recruiter so that offers where the two coincide must assert both roles explicitly, and offers that impersonate a real company can be distinguished from offers made by that company."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Employer"
      },
      {
        "@language": "es",
        "@value": "Empleador"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#Agent"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/ratr-o#Recruiter"
      }
    ]
  },
