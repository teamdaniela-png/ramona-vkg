      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#Recruiter",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An agent that makes first contact with a candidate and conducts the recruitment interaction, whether or not it is the party that would employ the candidate. Disjoint with :Employer, because in Ramona's casework the deceptive party is typically the recruiter and the named employer either does not exist or is impersonated."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Recruiter"
      },
      {
        "@language": "es",
        "@value": "Reclutador"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#Agent"
      }
    ]
  },
  {
    "@id": "http://purl.org/dc/elements/1.1/creator",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#exhibitsAction",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
