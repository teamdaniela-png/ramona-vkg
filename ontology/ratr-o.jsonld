      {
        "@id": "https://w3id.org/ratr-o#SocialMediaRecruitmentSignal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#FatalismSignal",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Normalises early death or no exit ('quizas manana ya no este', 'de aqui ya no sales'). Colmex 2025, images 16 and 18."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Fatalism"
      },
      {
        "@language": "es",
        "@value": "Fatalismo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#SocialMediaRecruitmentSignal"
      }
    ]
  },
