    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The frequency band of the pattern as a literal, one of hot, warm or cold. It duplicates :hasDominanceBucket deliberately, so that a client can read the band without following an object property."
      }
    ],
