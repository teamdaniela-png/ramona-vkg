  {
    "@id": "https://w3id.org/ratr-o#GangRecruitmentSchoolsScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Specific subtype of child recruitment where the entry point is the school ground or school exit. Recruiters are often students slightly older than the target or adults posing as relatives. Common in Central America (MS-13, Barrio 18) and in Mexican states with heavy cartel presence (Michoacán, Guerrero, Jalisco, Tamaulipas). The Gobierno de Zapopan published a public prevention programme in 2026. The Ramona press corpus holds 26 items from REDIM's data and advocacy blog (count recomputed 10 November 2026 from data/processed/press_summary.json)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Gang recruitment at schools scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de reclutamiento de pandillas o cárteles en escuelas"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.zapopan.gob.mx/v3/inclusion/noticias/policia-de-zapopan-refuerza-acciones-preventivas-contra-la-desaparicion-de-personas-y-el"
      },
      {
        "@id": "http://web.archive.org/web/20260723014408/https://www.zapopan.gob.mx/v3/inclusion/noticias/policia-de-zapopan-refuerza-acciones-preventivas-contra-la-desaparicion-de-personas-y-el"
      },
      {
        "@id": "https://blog.derechosinfancia.org.mx/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#ChildRecruitmentCriminalScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "The zapopan.gob.mx page is cited together with its Internet Archive snapshot of 23 July 2026."
      }
    ]
  },
