    "@id": "https://w3id.org/ratr-o#OpenDatasetRecord",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A single anonymised case record drawn from an open anti-trafficking dataset such as CTDC or UNODC."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Open dataset record"
      },
      {
        "@language": "es",
        "@value": "Registro de dataset abierto"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#EvidenceSource"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#routeIsTransnational",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Whether the route crosses an international border. Internal routes matter in Mexico, where most documented recruitment-to-exploitation movement is domestic."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#TraffickingRoute"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "route is transnational"
      },
      {
        "@language": "es",
        "@value": "la ruta es transnacional"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Literal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Intended datatype xsd:boolean. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:boolean literals."
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#offerTargetProfile",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Profile the offer asks for, in the words of the offer, for example that the candidate come alone or be a young woman."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#JobOffer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "target profile"
      },
      {
        "@language": "es",
        "@value": "perfil buscado"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#offeredByEmployer",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a job offer to the employer that made it. A subproperty of :offeredBy."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#JobOffer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "offered by employer"
      },
      {
        "@language": "es",
        "@value": "ofrecida por el empleador"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#Employer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/ratr-o#offeredBy"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#RecruiterReplyComment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A short reply by the post author or an associated account redirecting to a private channel or welcoming the applicant (e.g. 'manda mensaje', 'DM', 'bienvenido cuando quieras'). Colmex 2025, images 4, 13-14 and 18."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Recruiter reply comment"
      },
      {
        "@language": "es",
        "@value": "Respuesta del reclutador"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#SocialMediaComment"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#Victim",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A person documented as having been exploited or attempted-to-be-exploited in a trafficking or fraudulent-employment scheme. Sourced from anonymised CTDC records and publicly reported press cases."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Victim"
      },
      {
        "@language": "es",
        "@value": "Víctima"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.unodc.org/unodc/data-and-analysis/glotip.html"
      },
      {
        "@id": "https://www.ctdatacollaborative.org/page/global-synthetic-dataset"
      }
    ]
  },
  {
    "@id": "http://purl.org/vocab/vann/preferredNamespacePrefix",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#ModelingAgencyScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A supposed modelling, acting, influencer or image agency recruits young women, occasionally men, with the promise of bookings abroad. The first 'casting' is used to produce compromising photographs and to extract personal data. Subsequent 'shoots' lead to sexual exploitation, pornographic production without consent or forced escort work. Documented end-state of recruitment on Facebook Marketplace and Instagram DMs in Mexico and Colombia."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Modelling agency scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de agencia de modelaje"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#datasetRecordId",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Identifier of the record in the open dataset it came from, so that any figure can be traced back to the published dataset."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#OpenDatasetRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "dataset record id"
      },
      {
        "@language": "es",
        "@value": "identificador de registro del dataset"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#offerScreenshotUrl",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "URL of the stored screenshot of the offer. Screenshots are kept because deceptive offers are typically deleted by the recruiter within days."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#JobOffer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "offer screenshot URL"
      },
      {
        "@language": "es",
        "@value": "URL de la captura de pantalla de la oferta"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  }
]