      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#FakeMaquilaScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Offer of employment at an export-processing factory in the Mexican north border or in border free-trade zones. The maquila is either non-existent (workers arrive to find no facility), a cover for forced labour in a related industry (for example drug packaging, human-trafficking logistics), or a real facility operating under abusive conditions below the legal minimum. Candidates commonly relocate from southern Mexico and Central America."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Fake maquila scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de maquila fantasma"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#OnlineCryptoJobScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Advertised as 'crypto trader', 'forex analyst', 'Web3 community manager' or 'blockchain assistant' with high salary, full remote and no experience required. Often used as cover for pay-to-work (candidate buys a 'training course' or deposits 'starting capital'), identity theft (KYC data collected for money-laundering accounts), or cross-border trafficking into Southeast Asian crypto-scam compounds."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Crypto / forex job scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de empleo cripto / forex"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#victimPriorEmployment",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Employment situation of the victim before recruitment, as recorded by the source dataset."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#Victim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "prior employment status"
      },
      {
        "@language": "es",
        "@value": "situación laboral previa"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#Gender",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The gender recorded for a demographic profile or targeted by a fraud scheme. Modelled as a class of individuals rather than a literal so that the value set stays open and can be aligned to the categories of external datasets without changing the TBox."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Gender"
      },
      {
        "@language": "es",
        "@value": "Género"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#leadsToExploitation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Only asserted when the offer has been confirmed to have produced an exploitation outcome (from press case or dataset confirmation)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#JobOffer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "leads to exploitation"
      },
      {
        "@language": "es",
        "@value": "conduce a explotación"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#TypeOfExploitation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#inLanguage",
