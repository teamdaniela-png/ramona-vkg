      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#CentralAmericanMigrantLabourScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Offer of work in the United States or northern Mexico, targeted at Guatemalan, Honduran or Salvadoran candidates, that routes the victim via Tapachula and the Mexican migration corridor. On arrival, the victim is placed in construction, agriculture or hospitality under conditions of debt bondage: smuggling fees, document retention, threats of denunciation to immigration authorities. CTDC documents the GTM-USA corridor with 842 victims 2009-2023 and the HND and SLV citizenship clusters. Recognised by UNODC GLOTIP as a principal Latin-American corridor."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Central-American migrant labour exploitation scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de explotación laboral de migrantes centroamericanos"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.ctdatacollaborative.org/page/global-synthetic-dataset"
      },
      {
        "@id": "https://www.unodc.org/unodc/data-and-analysis/glotip.html"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#DebtBondageTraffickingScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#MeansPaymentOrBenefit",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The MEANS 'giving or receiving of payments or benefits to achieve the consent of a person having control over another person' in the sense of Palermo Protocol Article 3(a)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Giving or receiving of payments or benefits to obtain consent"
      },
      {
        "@language": "es",
        "@value": "Dar o recibir pagos o beneficios para obtener consentimiento"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#PalermoMeans"
      }
    ]
  },
