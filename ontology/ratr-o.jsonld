      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#Language"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#hasDemographicProfile",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a victim to their demographic profile. The profile is reified so that age group, gender, nationality and vulnerability factors can be recorded without ever attaching identifying attributes to the victim individual."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#Victim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has demographic profile"
      },
      {
        "@language": "es",
        "@value": "tiene perfil demográfico"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#DemographicProfile"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#hasRecruitmentMethod",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
