      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a lexicon term to the evidence source that documents it. Every term in the TikTok recruitment lexicon carries this link to the research report and page it was taken from."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
