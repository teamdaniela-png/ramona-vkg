      {
        "@language": "en",
        "@value": "Category the lexicon term belongs to, for example the role offered, the pay or the weapon."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#LexiconTerm"
      }
    ],
