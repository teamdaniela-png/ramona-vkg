  {
    "@id": "https://w3id.org/ratr-o#ChildRecruitmentCriminalScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Recruitment of minors by organised-crime organisations as halcones (lookouts), runners, enforcers, or in the production and logistics of drug trafficking. Extensively documented in Mexico by REDIM (Red por los Derechos de la Infancia en México) in their 2010-2024 series. Recognised by the CNDH and ongoing federal legislative debate. Entry points include offers disguised as 'security', 'warehouse work' or 'deliveries', plus in-school contact and social-media grooming. UNICEF treats recruitment of minors by armed groups as a grave violation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Child recruitment into criminal organisations"
      },
      {
        "@language": "es",
        "@value": "Esquema de reclutamiento infantil por grupos delictivos"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://blog.derechosinfancia.org.mx/2025/12/09/reclutamiento-y-utilizacion-de-ninas-ninos-y-adolescentes-por-agrupaciones-delictivas-en-mexico-2010-2024/"
      },
      {
        "@id": "https://blog.derechosinfancia.org.mx/2025/12/10/reclutamiento-y-utilizacion-de-ninas-ninos-y-adolescentes-por-agrupaciones-delictivas-en-michoacan-2010-2024/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#ForcedCriminalityScheme"
      }
    ]
  },
