      {
        "@id": "https://w3id.org/ratr-o#PalermoMeans"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#languageName",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Name of the language in English."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#Language"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "language name"
      },
      {
        "@language": "es",
        "@value": "nombre del idioma"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#TraffickingRoute",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An origin-to-destination pair, optionally with stopover countries, along which victims are moved. Routes in the demonstrator are derived from aggregated citizenship and country-of-exploitation pairs in the CTDC global synthetic dataset, never from individual case records."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Trafficking route"
      },
      {
        "@language": "es",
        "@value": "Ruta de trata"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf"
      },
      {
        "@id": "https://bioportal.bioontology.org/ontologies/HUTRO"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#closeMatch": [
      {
        "@id": "https://bioportal.bioontology.org/ontologies/HUTROtrafficking_transit_places"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Close match to the HUTRO concept 'trafficking transit places' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Trafficking Transit Places'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile."
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#itemPostedAt",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Timestamp at which the social-media item was posted."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#SocialMediaItem"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "item posted at"
      },
      {
        "@language": "es",
        "@value": "fecha de publicación"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#platformModeratedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a platform to the agent responsible for its moderation, used to record to whom a reported offer can be escalated."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#Platform"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "platform moderated by"
      },
      {
        "@language": "es",
        "@value": "plataforma moderada por"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#Agent"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/2004/02/skos/core#note",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#RiskClassification",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An assessment of an offer along Ramona's risk axes. Three independent dimensions are covered, each modelled as a subclass: :FraudRisk, :ExploitationRisk and :TraffickingRisk."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Risk classification"
      },
      {
        "@language": "es",
        "@value": "Clasificación de riesgo"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#VisaFraudScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The offer promises employment in a foreign country (commonly Canada, the United States or Western Europe for Latin American victims) and demands payment for visa, gestor or recruiter services. The intermediary disappears after collecting payment. Commonly marketed as domestic work, caregiving, nanny placement or hospitality abroad."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Migration / visa fraud scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de fraude migratorio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#audioDescription",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Description of the audio track of the post, including the song used. The audio is recorded because in the Colmex corpus the belico soundtrack is part of what makes the post legible as a recruitment post."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#SocialMediaPost"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "audio description"
      },
      {
        "@language": "es",
        "@value": "descripción del audio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#visualDescription",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Description of what the post shows."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#SocialMediaPost"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "visual description"
      },
      {
        "@language": "es",
        "@value": "descripción visual"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#PayToWorkScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The candidate is asked to pay the recruiter or a third party before being hired, under the guise of onboarding fees, training, interview fees, uniform costs, administrative processing, background check, or starter kit. Often the candidate is never contacted again."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Pay-to-work scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de pago por trabajar"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#schemeTypicalRoute",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a fraud scheme to a trafficking route along which its victims are typically moved."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "typical trafficking route for scheme"
      },
      {
        "@language": "es",
        "@value": "ruta de trata típica del esquema"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#TraffickingRoute"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#DominanceBucket",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A qualitative frequency band used to describe how often a pattern is observed in the observatory corpus: hot is at least 5 percent of cases, warm is 1 to 5 percent, cold is below 1 percent. The band is a class with one individual per value so that a query can group patterns by band; :dominanceBucketValue carries the same information as a literal for clients that do not traverse the object property."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Dominance bucket"
      },
      {
        "@language": "es",
        "@value": "Rango de dominancia"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#CredibleLethalRedFlag",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A logistic signal inside an otherwise plausible offer: nameless company, WhatsApp without logo, meeting in a multi-use building, asked to come alone or without ID, Messenger-to-WhatsApp funnel, atypical hours, personal-data harvesting, plausible bait role, last-minute relocation. The value is in :flagType."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Credible-lethal red flag (Type B)"
      },
      {
        "@language": "es",
        "@value": "Bandera roja creible-letal (Tipo B)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#RedFlag"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#victimHasChildrenCount",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "ICS-TIP additional disaggregating variable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#Victim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "number of children"
      },
      {
        "@language": "es",
        "@value": "número de hijas e hijos"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#postedVia",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a job offer to the platform on which it was published or through which first contact happened."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#JobOffer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "posted via"
      },
      {
        "@language": "es",
        "@value": "publicada a través de"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#Platform"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#DocumentationType",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An identity or travel document demanded or withheld during recruitment. Includes the case of falsified documents."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Documentation type"
      },
      {
        "@language": "es",
        "@value": "Tipo de documentación"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://bioportal.bioontology.org/ontologies/HUTRO"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#closeMatch": [
      {
        "@id": "https://bioportal.bioontology.org/ontologies/HUTROdocumentation_type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Close match to the HUTRO concept 'documentation type' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Documentation Type'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile."
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#riskScore",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Aggregate risk score computed for the offer by the classifier version recorded on the classification."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#JobOffer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "risk score"
      },
      {
        "@language": "es",
        "@value": "puntuación de riesgo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#itemHashtags",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Hashtags carried by the item, as a space-separated list."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#SocialMediaItem"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "item hashtags"
      },
      {
        "@language": "es",
        "@value": "hashtags"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#CommunicationPattern",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A pattern describing which communication tool was used for the first or dominant contact (WhatsApp, Messenger, Telegram, SMS, in-person, etc.)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Communication pattern"
      },
      {
        "@language": "es",
        "@value": "Patrón de comunicación"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#SurvivorTestimonyPattern"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#operatesIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a fraud scheme to a country where it has been documented."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "scheme operates in country"
      },
      {
        "@language": "es",
        "@value": "el esquema opera en el país"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#Country"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#AcousticFramingPost",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Condition A of Colmex 2025: background music or sound (corridos belicos, gunfire, radio chatter) that gives an emotional frame to criminal activity."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Acoustic framing post (A)"
      },
      {
        "@language": "es",
        "@value": "Publicación con acústica (A)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#SocialMediaPost"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#PalermoAction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The ACT element of the Palermo Protocol Article 3(a) definition of trafficking in persons: 'the recruitment, transportation, transfer, harbouring or receipt of persons'."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Palermo Action"
      },
      {
        "@language": "es",
        "@value": "Acción (Palermo)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.ohchr.org/en/instruments-mechanisms/instruments/protocol-prevent-suppress-and-punish-trafficking-persons"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Five canonical sub-concepts from Article 3(a) of the Palermo Protocol."
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#GroupEmojiSignal",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Emojis used as identity markers (devil, ninja, skull, salute, rooster). Colmex 2025, images 10, 17, 18, 19, 22."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Group emoji"
      },
      {
        "@language": "es",
        "@value": "Emoji de grupo"
