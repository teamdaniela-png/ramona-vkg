  {
    "@id": "https://w3id.org/ratr-o#hasEvidenceSource",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Provenance, stated without restricting the kind of thing being traced. Routes, victim records, patterns and offers all carry at least one evidence source, so this property has a range but no domain, and the kind-specific properties :derivedFrom (patterns) and :offerDocumentedIn (offers) are subproperties of it. A query that asks what any fact rests on uses this property; a query about one kind of fact uses the subproperty."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has evidence source"
      },
      {
        "@language": "es",
        "@value": "tiene fuente de evidencia"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#EvidenceSource"
      }
    ]
  },
