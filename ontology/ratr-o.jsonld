  {
    "@id": "https://w3id.org/ratr-o#DomesticWorkerLockInScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The candidate is hired as a live-in domestic worker, caregiver or nanny and then isolated inside the employer's household: documents withheld, phone confiscated or rationed, days-off refused, movement outside the home forbidden. Wages are withheld or paid to a family member. Common end-state of VisaFraudScheme placements abroad and of internal placements from rural to urban Mexico."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Domestic worker lock-in scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de encierro en trabajo doméstico"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
