      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#yearOfRegistration",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Year in which the victim's case was registered by the source dataset. The year is the finest time granularity RATR-O records about a victim."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#Victim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "year of registration"
      },
      {
        "@language": "es",
        "@value": "año de registro"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Literal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Intended datatype xsd:gYear. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:gYear literals."
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#submittedOffer",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
