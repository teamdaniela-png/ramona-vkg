        "@value": "How the victim was identified: self-report, NGO, law enforcement, embassy, hotline."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#Victim"
