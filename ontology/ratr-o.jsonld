      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#recruitsFor",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a recruiter to the fraud scheme they recruit for."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#Recruiter"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "recruits for scheme"
      },
      {
        "@language": "es",
        "@value": "recluta para el esquema"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#itemMatchesTerm",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a social-media item to a lexicon term it matches."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#SocialMediaItem"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "item matches lexicon term"
      },
      {
        "@language": "es",
        "@value": "coincide con término"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#LexiconTerm"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#schemeCode",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The local name of the :FraudScheme subclass an individual scheme occurrence belongs to, as a string (for example PayToWorkScheme). It lets a query group occurrences by scheme without querying the class hierarchy."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "scheme code"
      },
      {
        "@language": "es",
        "@value": "código del esquema"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#FraudScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A named operational pattern by which a fraudulent job offer harms the candidate. Independent of the RiskClassification axes: a single offer can exhibit one or more named schemes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Fraud scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de fraude"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://ramonaaliadalaboral.com/"
      },
      {
        "@id": "https://www.unodc.org/unodc/en/human-trafficking/faqs.html"
      },
      {
        "@id": "https://www.ilo.org/publications/caught-sea-forced-labour-and-trafficking-fisheries"
      },
      {
        "@id": "https://fifpro.org/en/supporting-players/safe-working-environments/human-trafficking/"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#itemIsSynthetic",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Whether the item is synthetic. Every synthetic item in the demonstrator carries this property set to true, so that no figure can be computed over real and generated items without distinguishing them."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#SocialMediaItem"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "item is synthetic"
      },
      {
        "@language": "es",
        "@value": "es sintético"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Literal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Intended datatype xsd:boolean. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:boolean literals."
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#MeansCoercion",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The MEANS 'other forms of coercion' in the sense of Palermo Protocol Article 3(a)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Coercion"
      },
      {
        "@language": "es",
        "@value": "Coacción"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#PalermoMeans"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#sourceKind",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The kind of evidence source as recorded at ingestion: press_article or press, ctdc, unodc, rnpdno, organisation_material, statistics_report."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#EvidenceSource"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "source kind"
      },
      {
        "@language": "es",
        "@value": "tipo de fuente"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#candidateDefraudedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a candidate to the fraud scheme they were defrauded by, as reconstructed from their report."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#Candidate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "candidate defrauded by scheme"
      },
      {
        "@language": "es",
        "@value": "candidato defraudado por el esquema"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#exhibitsMeans",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a job offer to the Palermo Means it realises, normally :MeansDeception or :MeansFraud."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#JobOffer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "exhibits Palermo means"
      },
      {
        "@language": "es",
        "@value": "exhibe el medio de Palermo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#PalermoMeans"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#BeggingRingScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Offer of 'help' or 'a job in the city' that leads to forced begging under the control of a ring leader. Common victims are minors, persons with disabilities, and migrants with precarious status. The ring leader confiscates earnings and controls movement. Named explicitly in the UNODC Protocol against Trafficking in Persons glossary and discussed by UNICEF in urban contexts in Mexico, Honduras and Guatemala. Maps to :PurposeForcedLabour or :PurposeSlavery depending on the context."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Forced begging ring scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de mendicidad forzada"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.unodc.org/unodc/en/human-trafficking/faqs.html"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#CallCenterScamScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The candidate is hired as a legitimate customer-service, collections or sales agent in a call centre that is in fact a fraud operation (time-share extortion, fake investment, virtual kidnapping, romance scams). The worker realises they are defrauding clients and attempts to leave, at which point threats, wage withholding or confiscated documents prevent them from doing so. Documented in Mexico, Costa Rica and the Philippines."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Call-centre scam employment scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de empleo en call center estafador"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#hostsOffer",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a platform to a job offer published on it. Inverse of :postedVia."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#Platform"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "hosts offer"
      },
      {
        "@language": "es",
        "@value": "aloja la oferta"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#JobOffer"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://w3id.org/ratr-o#postedVia"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#ConstructionLabourBondageScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Offer of construction work abroad or in another state with housing and 'flight to site' included. Upon arrival the worker finds pay deductions for housing, transport and tools that exceed the wage; documents are retained; movement off site is restricted. Documented by ILO in the Gulf States labour corridor (most notoriously Qatar World Cup preparation) and by HRW and Polaris in the US-Mexico corridor for Mexican and Central-American workers. Also attested internally in Mexico for workers displaced from southern states to the northern border."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Construction labour bondage scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de servidumbre en construcción"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.unodc.org/documents/human-trafficking/2015/Recruitment_Fees_Report-Final-22_June_2015_AG_Final.pdf"
      },
      {
        "@id": "https://www.hrw.org/news/2012/06/12/qatar-migrant-construction-workers-face-abuse"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#transportationMeansName",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Controlled vocabulary: bus, car, foot, boat, air, train, truck, mixed, unknown."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#TransportationMeans"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transportation means name"
      },
      {
        "@language": "es",
        "@value": "nombre del medio de transporte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#Recruitment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The ACT of recruitment in the sense of Palermo Protocol Article 3(a). In RATR-O it is the act that a deceptive job offer realises, which is why recruitment-stage fraud is in scope of a trafficking ontology and not only of a consumer-fraud one."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Recruitment (act)"
      },
      {
        "@language": "es",
        "@value": "Reclutamiento (acción)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#PalermoAction"
      }
    ]
  },
  {
    "@id": "http://purl.org/dc/terms/publisher",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#hasNationality",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a demographic profile to a country of nationality."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#DemographicProfile"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has nationality"
      },
      {
        "@language": "es",
        "@value": "tiene nacionalidad"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#Country"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#OnlineInfluencerSalesScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The candidate is offered a paid role as 'brand ambassador', 'community manager trainee' or 'social media sales associate'. The role requires the candidate to set up their own social accounts, purchase the product catalogue, and 'earn' from commission and from recruiting further ambassadors. In effect a pyramid or MLM structure presented as a creator-economy job. Commonly used by cosmetic, fashion and digital-education brands."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Influencer sales scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de ventas como influencer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#MinorAgeMentionSignal",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The item mentions an age under 18 ('puedo entrar con 16'). Colmex 2025, image 22. Links the item to child recruitment."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Minor age mention"
      },
      {
        "@language": "es",
        "@value": "Menciona edad de menor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#SocialMediaRecruitmentSignal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#MeansAbuseOfPower",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The MEANS 'abuse of power' in the sense of Palermo Protocol Article 3(a)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Abuse of power"
      },
      {
        "@language": "es",
        "@value": "Abuso de poder"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#PalermoMeans"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#ExploitationRisk",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Risk that the offer leads to substandard working conditions, wage theft, excessive hours or other exploitation that does not rise to the legal definition of trafficking."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Labour exploitation risk"
      },
      {
        "@language": "es",
        "@value": "Riesgo de explotación laboral"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#RiskClassification"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#destinationCountry",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a trafficking route to its country of destination."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#TraffickingRoute"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "destination country"
      },
      {
        "@language": "es",
        "@value": "país de destino"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#Country"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#ClassicRedFlagPattern",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A survivor-testimony pattern drawn from Ramona's 7-flag canonical taxonomy (high salary, flexible hours, no experience, upfront pay, urgent acceptance, distant interview, out-of-state job)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Classic red-flag pattern"
      },
      {
        "@language": "es",
        "@value": "Patrón de bandera roja clásica"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#SurvivorTestimonyPattern"
      }
    ]
  },
