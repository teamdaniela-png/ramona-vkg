  {
    "@id": "https://w3id.org/ratr-o#CommunicationTool",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A tool used for communication between recruiters, smugglers, traffickers or victims. Distinct from Platform because it describes the tool itself, not the platform it runs on."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Communication tool"
      },
      {
        "@language": "es",
        "@value": "Herramienta de comunicación"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://bioportal.bioontology.org/ontologies/HUTRO"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#closeMatch": [
      {
        "@id": "https://bioportal.bioontology.org/ontologies/HUTROsmuggler_trafficker_communication_tools"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Close match to the HUTRO concept 'smuggler and trafficker communication tools' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Smuggler and Trafficker Communication Tools'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile. HUTRO writes the local name without the conjunction: smuggler_trafficker_communication_tools."
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#countryISOCode",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
