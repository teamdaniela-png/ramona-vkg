    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#PalermoPurpose"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#FishingVesselLabourScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Offer of work on deep-sea fishing vessels with promised wages and return dates. Victims are taken to international waters where they are held for months or years without pay, with document confiscation, physical abuse and no possibility of exit. Extensively documented by the International Labour Organization ('Caught at Sea', 2013) and by the Environmental Justice Foundation. Principal victim populations include Myanmar, Cambodia, Indonesia and the Philippines; vessels often registered in Thailand, Taiwan, Korea."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Fishing vessel labour scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de explotación laboral en pesca"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.ilo.org/publications/caught-sea-forced-labour-and-trafficking-fisheries"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#TypeOfExploitation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The exploitation outcome associated with a trafficking case. Controlled vocabulary covers labour, sexual, forced criminality, forced marriage, organ removal, mixed."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Type of exploitation"
      },
      {
        "@language": "es",
        "@value": "Tipo de explotación"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf"
      },
      {
        "@id": "https://bioportal.bioontology.org/ontologies/HUTRO"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#closeMatch": [
      {
        "@id": "https://bioportal.bioontology.org/ontologies/HUTROtype_of_exploitation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Close match to the HUTRO concept 'type of exploitation' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Type of exploitation'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile."
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#offeredRole",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Job title or role as named in the offer, in the words of the offer."
