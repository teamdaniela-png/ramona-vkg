    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#lexiconIsVerbatim",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "true if the term appears literally in the source report; false if it is a project variant (spelling, generic hashtag)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#LexiconTerm"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "verbatim from source"
      },
      {
        "@language": "es",
        "@value": "textual de la fuente"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Literal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Intended datatype xsd:boolean. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:boolean literals."
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#DirectRecruitmentPost",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Condition NR of Colmex 2025: the post explicitly invites the audience to join a criminal group (e.g. 'Quieres jale? Todavia hay plazas', 'seguimos con el reclutamiento activo'). Such a post is a job offer, and every such offer exhibits some forced-criminality scheme (existential axiom, allowed on the right-hand side in OWL 2 QL)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Direct recruitment post (NR)"
      },
      {
        "@language": "es",
        "@value": "Publicación con narrativa de reclutamiento directo (NR)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#SocialMediaPost"
      },
      {
        "@id": "https://w3id.org/ratr-o#JobOffer"
      },
      {
        "@id": "_:ne6d2504888794487b7a6574b5e207e73b1"
      },
      {
        "@id": "https://w3id.org/ratr-o#CriminalRecruitmentOffer"
      }
    ]
  },
  {
    "@id": "_:ne6d2504888794487b7a6574b5e207e73b1",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "https://w3id.org/ratr-o#exhibitsFraudScheme"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "https://w3id.org/ratr-o#ForcedCriminalityScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#termDocumentedIn",
