      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#PalermoPurpose",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The PURPOSE element of the Palermo Protocol Article 3(a): 'for the purpose of exploitation', which the Protocol exemplifies as 'the exploitation of the prostitution of others or other forms of sexual exploitation, forced labour or services, slavery or practices similar to slavery, servitude or the removal of organs'."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Palermo Purpose"
      },
      {
        "@language": "es",
        "@value": "Finalidad (Palermo)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.ohchr.org/en/instruments-mechanisms/instruments/protocol-prevent-suppress-and-punish-trafficking-persons"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Five canonical sub-concepts from Article 3(a)."
      }
    ]
  },
