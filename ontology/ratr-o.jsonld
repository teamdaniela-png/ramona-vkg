  {
    "@id": "https://w3id.org/ratr-o#GigEconomyFakeDriverScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The candidate is offered work as a ride-hailing or delivery driver for a platform (Uber, DiDi, Cabify, Beat, Rappi, DiDi Food). The recruiter provides a 'rented' vehicle on terms that include daily rent, insurance fees and maintenance charges. The arithmetic guarantees the driver ends each week in deficit, binding them through accumulating debt. The vehicle is often stolen or fraudulently registered and is used to extract labour under the threat of criminal complaint."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Gig-economy fake driver scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de conductor gig fraudulento"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#EmotionalConnectionStoryPost",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Second recruitment story of Colmex 2025 (pp. 43-47). Sufficient condition NR AND A is computed in the mapping."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Story: emotional connection (NR*A)"
      },
      {
        "@language": "es",
        "@value": "Relato: conexion emocional (NR*A)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#DirectRecruitmentPost"
      },
      {
        "@id": "https://w3id.org/ratr-o#AcousticFramingPost"
      }
    ]
  },
  {
    "@id": "http://purl.org/dc/terms/issued",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#ColmexScrollAlJale2025",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/ratr-o#ResearchReport"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "es",
        "@value": "Del scroll al 'jale': como se recluta en TikTok (El Colegio de Mexico, 2025)"
      }
    ],
    "https://w3id.org/ratr-o#sourceAuthor": [
      {
        "@value": "Arias Vasquez, A. (coord.); Pena Gonzalez, R. (dir.); Aguayo Quezada, S. (coord. gral.)"
      }
    ],
    "https://w3id.org/ratr-o#sourceOutlet": [
      {
        "@value": "Seminario sobre Violencia y Paz, El Colegio de Mexico"
      }
    ],
    "https://w3id.org/ratr-o#sourceTitle": [
      {
        "@value": "Del scroll al 'jale': como se recluta en TikTok"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#InPersonLureScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The offer exists solely to bring the candidate to a physical location under the appearance of a hiring event or interview. The real purpose is kidnapping, assault, sexual violence or femicide. Characterised by plausible role, nameless company, multi-use building address, request to come alone and without identification. Documented archetypal case: Edith Guadalupe Valdez Saldívar, Benito Juárez CDMX, April 2026."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "In-person lure scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de citación presencial"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#promisedWeeklyPayMXN",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Weekly pay promised in the post, in Mexican pesos."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#SocialMediaPost"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "promised weekly pay (MXN)"
      },
      {
        "@language": "es",
        "@value": "pago semanal prometido (MXN)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#schemeJurisdictionScope",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "local, national, regional, continental, global."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "scheme jurisdiction scope"
      },
      {
        "@language": "es",
        "@value": "ámbito jurisdiccional del esquema"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#ForeignLanguageTeacherScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The candidate is offered a teaching position abroad (typically Spanish in Asia or English in Latin America) with housing, visa and flight paid by the agency. On arrival the promised contract does not exist: the candidate is placed in a different role, forced to pay back 'travel expenses', has documents retained, or finds the school is a front for sex tourism or forced domestic work. Documented corridors include Mexico-China, Mexico-Korea, and Peru-Japan."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Foreign-language teacher scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de maestro de idiomas en el extranjero"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#CredibleLethalPattern",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A survivor-testimony pattern where the offer itself looks plausible and the risk sits in the logistics of the first contact (nameless WhatsApp, multi-use building, 'come alone', 'no ID', Messenger-to-WhatsApp funnel, personal-data filter). Type B in Ramona's dual-track classification."
      }
    ],
