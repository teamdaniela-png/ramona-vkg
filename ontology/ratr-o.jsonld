  {
    "@id": "https://w3id.org/ratr-o#IdentityTheftScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The offer's purpose is to harvest the candidate's personal data (CURP, INE, bank details) to commit downstream fraud against the candidate or third parties. Hiring is never actually intended."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Identity theft scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema de robo de identidad"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
