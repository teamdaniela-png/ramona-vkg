        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#commentsOn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a social-media comment to the post it replies to. Recruiter replies in comment threads are modelled because in the Colmex corpus the recruitment contact is frequently made there rather than in the post itself."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#SocialMediaComment"
      }
    ],
