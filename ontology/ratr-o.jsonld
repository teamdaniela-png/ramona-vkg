[
  {
    "@id": "https://w3id.org/ratr-o#PyramidScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The candidate's actual income depends on recruiting further candidates, not on the advertised job. Covers classic pyramid schemes and multi-level-marketing operations disguised as employment."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Pyramid / MLM scheme"
      },
      {
        "@language": "es",
        "@value": "Esquema piramidal / multinivel"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#FraudScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#hasVulnerabilityFactor",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a demographic profile to a vulnerability factor, in the sense of the ICS-TIP vulnerability variable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/ratr-o#DemographicProfile"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has vulnerability factor"
      },
      {
        "@language": "es",
        "@value": "tiene factor de vulnerabilidad"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/ratr-o#VulnerabilityFactor"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#RecruitmentPattern",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A pattern describing how the recruiter established contact with the candidate (social media, family, friend, intimate partner, abduction, classifieds, street)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Recruitment pattern"
      },
      {
        "@language": "es",
        "@value": "Patrón de reclutamiento"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#SurvivorTestimonyPattern"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#TransportationMeans",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The means of transport used at a stage of the trafficking route."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Transportation means"
      },
      {
        "@language": "es",
        "@value": "Medio de transporte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://bioportal.bioontology.org/ontologies/HUTRO"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#closeMatch": [
      {
        "@id": "https://bioportal.bioontology.org/ontologies/HUTROtransportation_means"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Close match to the HUTRO concept 'transportation means' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Transportation Means'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile."
      }
    ]
  },
  {
    "@id": "https://w3id.org/ratr-o#CriminalRecruitmentOffer",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A job offer whose purpose is to recruit into organised-crime activity (lookout, hitman, armed 'security', drug logistics), whatever the channel."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Criminal recruitment offer"
      },
      {
        "@language": "es",
        "@value": "Oferta de reclutamiento criminal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ratr-o#JobOffer"
      },
      {
        "@id": "_:ne6d2504888794487b7a6574b5e207e73b2"
      }
    ]
  },
