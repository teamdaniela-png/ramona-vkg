@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dc:    <http://purl.org/dc/elements/1.1/> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix vann:  <http://purl.org/vocab/vann/> .
@prefix hutro: <https://bioportal.bioontology.org/ontologies/HUTRO> .

#################################################################
#    Ontology metadata
#################################################################

<https://w3id.org/ratr-o> a owl:Ontology ;
    dc:title "Ramona Anti-Trafficking and Recruitment-fraud Ontology (RATR-O)"@en ;
    dc:title "Ontología Ramona contra el Reclutamiento Fraudulento y la Trata (RATR-O)"@es ;
    dc:creator "Daniela Camberos, Ramona AI" ;
    dct:contributor "Magdalena Ortiz, Institute of Logic and Computation, TU Wien (scientific host of the Dialogue Residency)" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dc:description "OWL 2 QL ontology for detecting fraudulent job offers, recruitment fraud and trafficking recruitment in Latin America, designed as the conceptual layer of a Virtual Knowledge Graph."@en ;
    owl:versionInfo "1.11.0" ;
    owl:versionIRI <https://w3id.org/ratr-o/1.11.0> ;
    owl:priorVersion <https://w3id.org/ratr-o/1.10.10> ;
    dct:issued "2026-04-21"^^xsd:date ;
    dct:created "2026-04-21"^^xsd:date ;
    dct:modified "2026-11-14"^^xsd:date ;
    dct:publisher "Ramona AI" ;
    vann:preferredNamespaceUri "https://w3id.org/ratr-o#" ;
    vann:preferredNamespacePrefix "ratro" ;
    dct:bibliographicCitation "Camberos, D. (2026). Ramona Anti-Trafficking and Recruitment-fraud Ontology (RATR-O), version 1.11.0. https://w3id.org/ratr-o"@en ;
    skos:note "In the OWL 2 QL profile under the OWL API checker and consistent under HermiT, alone and together with its data; see docs/validation/VALIDATION_REPORT.md. Every term carries an English and a Spanish label and a definition."@en ;
    rdfs:comment "A domain ontology in OWL 2 QL (DL-Lite) for the detection of fraudulent job offers, labour-recruitment fraud, and human-trafficking recruitment patterns in Latin America. RATR-O models the full continuum of recruitment-based harm: from offers that defraud candidates (identity theft, financial scams, unpaid work) through offers that lead to labour exploitation, through to offers whose purpose is trafficking into forced labour, sexual exploitation, or forced criminality. A single JobOffer can exhibit indicators of any combination of these three outcomes, and RATR-O expresses them as distinct but compatible risk axes. The ontology is designed to operate as the conceptual layer of a Virtual Knowledge Graph over Ramona AI operational data and over open anti-trafficking datasets (CTDC, UNODC), following Xiao, Ding, Cogrel and Calvanese (2019). It aligns the generalisable fragment of HUTRO (Human Trafficking Ontology, BioPortal, 2025) with Ramona's domain-specific taxonomy of online recruitment fraud in Mexico and Latin America."@en ;
    rdfs:seeAlso <https://bioportal.bioontology.org/ontologies/HUTRO> .

#################################################################
#    Annotation properties (declared so the file is in the OWL 2 QL profile
#    under the OWL API checker; they carry no logical meaning)
#################################################################

dc:title a owl:AnnotationProperty .
dc:creator a owl:AnnotationProperty .
dc:description a owl:AnnotationProperty .
dct:contributor a owl:AnnotationProperty .
dct:license a owl:AnnotationProperty .
dct:issued a owl:AnnotationProperty .
dct:modified a owl:AnnotationProperty .
dct:created a owl:AnnotationProperty .
dct:publisher a owl:AnnotationProperty .
dct:bibliographicCitation a owl:AnnotationProperty .
vann:preferredNamespaceUri a owl:AnnotationProperty .
vann:preferredNamespacePrefix a owl:AnnotationProperty .
skos:note a owl:AnnotationProperty .
skos:closeMatch a owl:AnnotationProperty .

#################################################################
#    Core Classes — Agents, offers, submissions
#################################################################

:Agent a owl:Class ;
    rdfs:label "Agent"@en, "Agente"@es ;
    rdfs:comment "An actor who can post or be associated with a job offer."@en .

:Recruiter a owl:Class ;
    rdfs:subClassOf :Agent ;
    rdfs:label "Recruiter"@en, "Reclutador"@es ;
    rdfs:comment "An agent that makes first contact with a candidate and conducts the recruitment interaction, whether or not it is the party that would employ the candidate. Disjoint with :Employer, because in Ramona's casework the deceptive party is typically the recruiter and the named employer either does not exist or is impersonated."@en .

:Employer a owl:Class ;
    rdfs:subClassOf :Agent ;
    rdfs:label "Employer"@en, "Empleador"@es ;
    rdfs:comment "The organisation or natural person named in a job offer as the party that would employ the candidate. Kept disjoint from :Recruiter so that offers where the two coincide must assert both roles explicitly, and offers that impersonate a real company can be distinguished from offers made by that company."@en .

:JobOffer a owl:Class ;
    rdfs:label "Job offer"@en, "Oferta laboral"@es ;
    rdfs:comment "A posting advertising employment, submitted to Ramona or harvested from public channels."@en .

:Platform a owl:Class ;
    rdfs:label "Platform"@en, "Plataforma"@es ;
    rdfs:comment "A digital service on which a job offer or a social-media item is published or through which first contact happens (for example a social network, a messaging application or a job board). Platform identity is recorded because the channel is one of the few attributes present in almost every report Ramona receives."@en .

:OnlineRecruitmentChannel a owl:Class ;
    rdfs:subClassOf :Platform ;
    rdfs:label "Online recruitment channel"@en, "Canal de reclutamiento en línea"@es ;
    rdfs:comment "A digital communication channel used by recruiters to contact candidates. Controlled vocabulary covers Messenger, WhatsApp, Telegram, Marketplace, TikTok, SMS, classifieds and other."@en .

:Candidate a owl:Class ;
    rdfs:label "Candidate"@en, "Candidato"@es ;
    rdfs:comment "User who submitted an offer to Ramona for verification."@en .

:Submission a owl:Class ;
    rdfs:label "Submission"@en, "Solicitud"@es ;
    rdfs:comment "An act by a Candidate of submitting an offer for Ramona verification."@en .

#################################################################
#    Risk and detection classes
#################################################################

:RedFlag a owl:Class ;
    rdfs:label "Red flag"@en, "Bandera roja"@es ;
    rdfs:comment "A detected indicator of potential fraud or trafficking recruitment risk. Seven canonical flags are defined by Ramona AI."@en .

:RiskClassification a owl:Class ;
    rdfs:label "Risk classification"@en, "Clasificación de riesgo"@es ;
    rdfs:comment "An assessment of an offer along Ramona's risk axes. Three independent dimensions are covered, each modelled as a subclass: :FraudRisk, :ExploitationRisk and :TraffickingRisk."@en .

:FraudRisk a owl:Class ;
    rdfs:subClassOf :RiskClassification ;
    rdfs:label "Labour fraud risk"@en, "Riesgo de fraude laboral"@es ;
    rdfs:comment "Risk that the offer is a fraud designed to extract money, data or unpaid work from the candidate, without necessarily leading to trafficking or exploitation."@en .

:ExploitationRisk a owl:Class ;
    rdfs:subClassOf :RiskClassification ;
    rdfs:label "Labour exploitation risk"@en, "Riesgo de explotación laboral"@es ;
    rdfs:comment "Risk that the offer leads to substandard working conditions, wage theft, excessive hours or other exploitation that does not rise to the legal definition of trafficking."@en .

:TraffickingRisk a owl:Class ;
    rdfs:subClassOf :RiskClassification ;
    rdfs:label "Trafficking recruitment risk"@en, "Riesgo de reclutamiento para trata"@es ;
    rdfs:comment "Risk that the offer is recruitment for trafficking in persons in the sense of the Palermo Protocol: for forced labour, sexual exploitation, forced criminality, forced marriage or organ removal."@en .

#################################################################
#    FraudScheme taxonomy
#    Named schemes documented in Mexico and Latin America. Each scheme is a
#    specific way a fraudulent job offer is operationalised against candidates
#    in the region.
#################################################################

:FraudScheme a owl:Class ;
    rdfs:label "Fraud scheme"@en, "Esquema de fraude"@es ;
    rdfs:comment "A named operational pattern by which a fraudulent job offer harms the candidate. Independent of the RiskClassification axes: a single offer can exhibit one or more named schemes."@en .

:IdentityTheftScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Identity theft scheme"@en, "Esquema de robo de identidad"@es ;
    rdfs:comment "The offer's purpose is to harvest the candidate's personal data (CURP, INE, bank details) to commit downstream fraud against the candidate or third parties. Hiring is never actually intended."@en .

:PyramidScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Pyramid / MLM scheme"@en, "Esquema piramidal / multinivel"@es ;
    rdfs:comment "The candidate's actual income depends on recruiting further candidates, not on the advertised job. Covers classic pyramid schemes and multi-level-marketing operations disguised as employment."@en .

:PayToWorkScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Pay-to-work scheme"@en, "Esquema de pago por trabajar"@es ;
    rdfs:comment "The candidate is asked to pay the recruiter or a third party before being hired, under the guise of onboarding fees, training, interview fees, uniform costs, administrative processing, background check, or starter kit. Often the candidate is never contacted again."@en .

:VisaFraudScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Migration / visa fraud scheme"@en, "Esquema de fraude migratorio"@es ;
    rdfs:comment "The offer promises employment in a foreign country (commonly Canada, the United States or Western Europe for Latin American victims) and demands payment for visa, gestor or recruiter services. The intermediary disappears after collecting payment. Commonly marketed as domestic work, caregiving, nanny placement or hospitality abroad."@en .

:InPersonLureScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "In-person lure scheme"@en, "Esquema de citación presencial"@es ;
    rdfs:comment "The offer exists solely to bring the candidate to a physical location under the appearance of a hiring event or interview. The real purpose is kidnapping, assault, sexual violence or femicide. Characterised by plausible role, nameless company, multi-use building address, request to come alone and without identification. Documented archetypal case: Edith Guadalupe Valdez Saldívar, Benito Juárez CDMX, April 2026."@en .

:DebtBondageTraffickingScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Debt bondage trafficking scheme"@en, "Esquema de trata con deuda"@es ;
    rdfs:comment "The offer relocates the candidate to a destination where exploitation is performed, often across borders, and binds the victim through a manufactured debt: smuggling fees, transportation, housing, paperwork. Covers the Tapachula-to-United States labour-exploitation corridor, the Latin-America-to-Western-Europe sex-trafficking pattern (e.g. falsely advertised childcare jobs in Paris), and domestic-work trafficking with document retention."@en .

:DomesticWorkerLockInScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Domestic worker lock-in scheme"@en, "Esquema de encierro en trabajo doméstico"@es ;
    rdfs:comment "The candidate is hired as a live-in domestic worker, caregiver or nanny and then isolated inside the employer's household: documents withheld, phone confiscated or rationed, days-off refused, movement outside the home forbidden. Wages are withheld or paid to a family member. Common end-state of VisaFraudScheme placements abroad and of internal placements from rural to urban Mexico."@en .

:OnlineCryptoJobScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Crypto / forex job scheme"@en, "Esquema de empleo cripto / forex"@es ;
    rdfs:comment "Advertised as 'crypto trader', 'forex analyst', 'Web3 community manager' or 'blockchain assistant' with high salary, full remote and no experience required. Often used as cover for pay-to-work (candidate buys a 'training course' or deposits 'starting capital'), identity theft (KYC data collected for money-laundering accounts), or cross-border trafficking into Southeast Asian crypto-scam compounds."@en .

:ModelingAgencyScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Modelling agency scheme"@en, "Esquema de agencia de modelaje"@es ;
    rdfs:comment "A supposed modelling, acting, influencer or image agency recruits young women, occasionally men, with the promise of bookings abroad. The first 'casting' is used to produce compromising photographs and to extract personal data. Subsequent 'shoots' lead to sexual exploitation, pornographic production without consent or forced escort work. Documented end-state of recruitment on Facebook Marketplace and Instagram DMs in Mexico and Colombia."@en .

:CallCenterScamScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Call-centre scam employment scheme"@en, "Esquema de empleo en call center estafador"@es ;
    rdfs:comment "The candidate is hired as a legitimate customer-service, collections or sales agent in a call centre that is in fact a fraud operation (time-share extortion, fake investment, virtual kidnapping, romance scams). The worker realises they are defrauding clients and attempts to leave, at which point threats, wage withholding or confiscated documents prevent them from doing so. Documented in Mexico, Costa Rica and the Philippines."@en .

:FakeMaquilaScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Fake maquila scheme"@en, "Esquema de maquila fantasma"@es ;
    rdfs:comment "Offer of employment at an export-processing factory in the Mexican north border or in border free-trade zones. The maquila is either non-existent (workers arrive to find no facility), a cover for forced labour in a related industry (for example drug packaging, human-trafficking logistics), or a real facility operating under abusive conditions below the legal minimum. Candidates commonly relocate from southern Mexico and Central America."@en .

:MLMHealthBeautyScheme a owl:Class ;
    rdfs:subClassOf :PyramidScheme ;
    rdfs:label "Health / beauty MLM scheme"@en, "Esquema multinivel de salud y belleza"@es ;
    rdfs:comment "A multi-level marketing operation centred on nutritional supplements, cosmetics, slimming products or wellness programmes. Presented as an employment or business opportunity, in practice the participant earns only by recruiting further 'distributors' and by purchasing inventory that cannot be sold on the open market. Canonical examples in Latin America include product lines marketed through Facebook groups and WhatsApp chains."@en .

:GigEconomyFakeDriverScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Gig-economy fake driver scheme"@en, "Esquema de conductor gig fraudulento"@es ;
    rdfs:comment "The candidate is offered work as a ride-hailing or delivery driver for a platform (Uber, DiDi, Cabify, Beat, Rappi, DiDi Food). The recruiter provides a 'rented' vehicle on terms that include daily rent, insurance fees and maintenance charges. The arithmetic guarantees the driver ends each week in deficit, binding them through accumulating debt. The vehicle is often stolen or fraudulently registered and is used to extract labour under the threat of criminal complaint."@en .

:ForcedCriminalityScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Forced criminality scheme"@en, "Esquema de reclutamiento para criminalidad forzada"@es ;
    rdfs:comment "Offer advertised as 'private security', 'bodyguard', 'armed escort', 'watchman at a ranch' or 'warehouse security' with atypically high salary. The real purpose is enlistment into organised-crime armed structures, most notably as halcones, sicarios, or coca-processing labour. Archetypal Mexican case: the CJNG Rancho Izaguirre (Teuchitlán, Jalisco) recruiting scheme of 2024-2025."@en .

:OnlineInfluencerSalesScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Influencer sales scheme"@en, "Esquema de ventas como influencer"@es ;
    rdfs:comment "The candidate is offered a paid role as 'brand ambassador', 'community manager trainee' or 'social media sales associate'. The role requires the candidate to set up their own social accounts, purchase the product catalogue, and 'earn' from commission and from recruiting further ambassadors. In effect a pyramid or MLM structure presented as a creator-economy job. Commonly used by cosmetic, fashion and digital-education brands."@en .

:ForeignLanguageTeacherScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Foreign-language teacher scheme"@en, "Esquema de maestro de idiomas en el extranjero"@es ;
    rdfs:comment "The candidate is offered a teaching position abroad (typically Spanish in Asia or English in Latin America) with housing, visa and flight paid by the agency. On arrival the promised contract does not exist: the candidate is placed in a different role, forced to pay back 'travel expenses', has documents retained, or finds the school is a front for sex tourism or forced domestic work. Documented corridors include Mexico-China, Mexico-Korea, and Peru-Japan."@en .

#################################################################
#    FraudSchemes documented in official sources
#    Each scheme cites at least one official source
#    (UNODC, UNICEF, UN Women, ILO, FIFPro, REDIM, Palermo Protocol).
#################################################################

:ForcedChildMarriageScheme a owl:Class ;
    rdfs:subClassOf :DebtBondageTraffickingScheme ;
    rdfs:label "Forced child marriage scheme"@en, "Esquema de matrimonio infantil forzado"@es ;
    rdfs:comment "The offer frames a minor's placement as marriage or an 'informal union' under customary practice (usos y costumbres). The Secretaría de las Mujeres de Oaxaca recognises this explicitly as a form of human trafficking. According to ENADID 2014, 44.82% of women in Chiapas, 42.41% in Guerrero and 39.17% in Oaxaca reported child marriage or early union. Recognised by UNICEF as a harmful practice and by UN Women as a form of gender-based violence. Maps to :PurposeServitude in the Palermo Protocol."@en ;
    rdfs:seeAlso <https://www.oaxaca.gob.mx/sm/matrimonio-infantil-forzado-una-forma-de-trata-smo/> ,
                 <http://web.archive.org/web/20250224033853/https://www.oaxaca.gob.mx/sm/matrimonio-infantil-forzado-una-forma-de-trata-smo/> ,
                 <https://blog.derechosinfancia.org.mx/2022/01/28/matrimonio-y-union-temprana-en-ninas-y-mujeres-adolescentes-de-mexico/> ;
    skos:note "The oaxaca.gob.mx page is cited together with its Internet Archive snapshot of 24 February 2025."@en .

:OrganRemovalRecruitmentScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Organ removal recruitment scheme"@en, "Esquema de reclutamiento para extracción de órganos"@es ;
    rdfs:comment "The offer promises medical treatment, paid egg donation, or a health procedure. The real purpose is extraction of organs (most commonly kidneys) or tissue for sale on the black market. Traffickers promise US$500 to US$10,000 that the victim often never receives. Documented in detail by the UNODC Assessment Toolkit on Trafficking in Persons for the Purpose of Organ Removal (2015, 60+ pages). Explicitly named as a purpose of trafficking by Article 3(a) of the Palermo Protocol (2000). Recruitment uses social media, word of mouth in vulnerable communities, and classifieds."@en ;
    rdfs:seeAlso <https://www.unodc.org/documents/human-trafficking/2015/UNODC_Assessment_Toolkit_TIP_for_the_Purpose_of_Organ_Removal.pdf> .

:ChildRecruitmentCriminalScheme a owl:Class ;
    rdfs:subClassOf :ForcedCriminalityScheme ;
    rdfs:label "Child recruitment into criminal organisations"@en,
               "Esquema de reclutamiento infantil por grupos delictivos"@es ;
    rdfs:comment "Recruitment of minors by organised-crime organisations as halcones (lookouts), runners, enforcers, or in the production and logistics of drug trafficking. Extensively documented in Mexico by REDIM (Red por los Derechos de la Infancia en México) in their 2010-2024 series. Recognised by the CNDH and ongoing federal legislative debate. Entry points include offers disguised as 'security', 'warehouse work' or 'deliveries', plus in-school contact and social-media grooming. UNICEF treats recruitment of minors by armed groups as a grave violation."@en ;
    rdfs:seeAlso <https://blog.derechosinfancia.org.mx/2025/12/09/reclutamiento-y-utilizacion-de-ninas-ninos-y-adolescentes-por-agrupaciones-delictivas-en-mexico-2010-2024/> ,
                 <https://blog.derechosinfancia.org.mx/2025/12/10/reclutamiento-y-utilizacion-de-ninas-ninos-y-adolescentes-por-agrupaciones-delictivas-en-michoacan-2010-2024/> .

:CentralAmericanMigrantLabourScheme a owl:Class ;
    rdfs:subClassOf :DebtBondageTraffickingScheme ;
    rdfs:label "Central-American migrant labour exploitation scheme"@en,
               "Esquema de explotación laboral de migrantes centroamericanos"@es ;
    rdfs:comment "Offer of work in the United States or northern Mexico, targeted at Guatemalan, Honduran or Salvadoran candidates, that routes the victim via Tapachula and the Mexican migration corridor. On arrival, the victim is placed in construction, agriculture or hospitality under conditions of debt bondage: smuggling fees, document retention, threats of denunciation to immigration authorities. CTDC documents the GTM-USA corridor with 842 victims 2009-2023 and the HND and SLV citizenship clusters. Recognised by UNODC GLOTIP as a principal Latin-American corridor."@en ;
    rdfs:seeAlso <https://www.ctdatacollaborative.org/page/global-synthetic-dataset> ,
                 <https://www.unodc.org/unodc/data-and-analysis/glotip.html> .

:AgriculturalBondageScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Agricultural labour bondage scheme"@en,
               "Esquema de servidumbre en trabajo agrícola"@es ;
    rdfs:comment "Offer of seasonal agricultural work (jornalero, harvest, produce packing) that leads to wage theft, deductions for housing and food that exceed the wage, confiscation of identification documents, and restriction of movement through geographic isolation. Documented by ILO, UNODC and the Polaris Project in the US-Mexico corridor (fresh produce, coffee, tomato) and in internal Mexican migration from southern states to Sinaloa, Sonora and Baja California. The CTDC dataset registers agricultural labour as a distinct exploitation subtype."@en ;
    rdfs:seeAlso <https://www.unodc.org/documents/human-trafficking/2015/Recruitment_Fees_Report-Final-22_June_2015_AG_Final.pdf> ,
                 <https://polarisproject.org/> .

:FishingVesselLabourScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Fishing vessel labour scheme"@en,
               "Esquema de explotación laboral en pesca"@es ;
    rdfs:comment "Offer of work on deep-sea fishing vessels with promised wages and return dates. Victims are taken to international waters where they are held for months or years without pay, with document confiscation, physical abuse and no possibility of exit. Extensively documented by the International Labour Organization ('Caught at Sea', 2013) and by the Environmental Justice Foundation. Principal victim populations include Myanmar, Cambodia, Indonesia and the Philippines; vessels often registered in Thailand, Taiwan, Korea."@en ;
    rdfs:seeAlso <https://www.ilo.org/publications/caught-sea-forced-labour-and-trafficking-fisheries> .

:GangRecruitmentSchoolsScheme a owl:Class ;
    rdfs:subClassOf :ChildRecruitmentCriminalScheme ;
    rdfs:label "Gang recruitment at schools scheme"@en,
               "Esquema de reclutamiento de pandillas o cárteles en escuelas"@es ;
    rdfs:comment "Specific subtype of child recruitment where the entry point is the school ground or school exit. Recruiters are often students slightly older than the target or adults posing as relatives. Common in Central America (MS-13, Barrio 18) and in Mexican states with heavy cartel presence (Michoacán, Guerrero, Jalisco, Tamaulipas). The Gobierno de Zapopan published a public prevention programme in 2026. The Ramona press corpus holds 26 items from REDIM's data and advocacy blog (count recomputed 10 November 2026 from data/processed/press_summary.json)."@en ;
    rdfs:seeAlso <https://www.zapopan.gob.mx/v3/inclusion/noticias/policia-de-zapopan-refuerza-acciones-preventivas-contra-la-desaparicion-de-personas-y-el> ,
                 <http://web.archive.org/web/20260723014408/https://www.zapopan.gob.mx/v3/inclusion/noticias/policia-de-zapopan-refuerza-acciones-preventivas-contra-la-desaparicion-de-personas-y-el> ,
                 <https://blog.derechosinfancia.org.mx/> ;
    skos:note "The zapopan.gob.mx page is cited together with its Internet Archive snapshot of 23 July 2026."@en .

:BeggingRingScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Forced begging ring scheme"@en,
               "Esquema de mendicidad forzada"@es ;
    rdfs:comment "Offer of 'help' or 'a job in the city' that leads to forced begging under the control of a ring leader. Common victims are minors, persons with disabilities, and migrants with precarious status. The ring leader confiscates earnings and controls movement. Named explicitly in the UNODC Protocol against Trafficking in Persons glossary and discussed by UNICEF in urban contexts in Mexico, Honduras and Guatemala. Maps to :PurposeForcedLabour or :PurposeSlavery depending on the context."@en ;
    rdfs:seeAlso <https://www.unodc.org/unodc/en/human-trafficking/faqs.html> .

:ConstructionLabourBondageScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Construction labour bondage scheme"@en,
               "Esquema de servidumbre en construcción"@es ;
    rdfs:comment "Offer of construction work abroad or in another state with housing and 'flight to site' included. Upon arrival the worker finds pay deductions for housing, transport and tools that exceed the wage; documents are retained; movement off site is restricted. Documented by ILO in the Gulf States labour corridor (most notoriously Qatar World Cup preparation) and by HRW and Polaris in the US-Mexico corridor for Mexican and Central-American workers. Also attested internally in Mexico for workers displaced from southern states to the northern border."@en ;
    rdfs:seeAlso <https://www.unodc.org/documents/human-trafficking/2015/Recruitment_Fees_Report-Final-22_June_2015_AG_Final.pdf> ,
                 <https://www.hrw.org/news/2012/06/12/qatar-migrant-construction-workers-face-abuse> .

:SportsTalentScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Sports talent recruitment scheme"@en,
               "Esquema de reclutamiento deportivo fraudulento"@es ;
    rdfs:comment "Offer to join a 'football academy' in Europe, a 'baseball academy' in the US, or a 'boxing camp' abroad, with flight and training fees. Victim (usually an adolescent) is abandoned at destination when the agency disappears or is placed under exploitative training contracts with no professional outcome. Extensively documented by FIFPro (World Players Union) in its 2018 Africa report and by ILO in the Latin-America to Europe and Asia to Gulf corridors for youth football. Also attested in baseball recruiting in the Dominican Republic and Venezuela."@en ;
    rdfs:seeAlso <https://fifpro.org/en/supporting-players/safe-working-environments/human-trafficking/> .

# Candidate and victim link to Scheme (extended range)

:candidateDefraudedBy a owl:ObjectProperty ;
    rdfs:domain :Candidate ; rdfs:range :FraudScheme ;
    rdfs:label "candidate defrauded by scheme"@en, "candidato defraudado por el esquema"@es ;
    rdfs:comment "Relates a candidate to the fraud scheme they were defrauded by, as reconstructed from their report."@en .

#################################################################
#    Observatory measurement layer
#    Properties and subclasses that enable empirical statements on top
#    of the ontology (counts, frequency buckets, earliest year, etc.)
#################################################################

:ClassicRedFlagPattern a owl:Class ;
    rdfs:subClassOf :SurvivorTestimonyPattern ;
    rdfs:label "Classic red-flag pattern"@en, "Patrón de bandera roja clásica"@es ;
    rdfs:comment "A survivor-testimony pattern drawn from Ramona's 7-flag canonical taxonomy (high salary, flexible hours, no experience, upfront pay, urgent acceptance, distant interview, out-of-state job)."@en .

:CredibleLethalPattern a owl:Class ;
    rdfs:subClassOf :SurvivorTestimonyPattern ;
    rdfs:label "Credible-lethal pattern"@en, "Patrón creíble-letal"@es ;
    rdfs:comment "A survivor-testimony pattern where the offer itself looks plausible and the risk sits in the logistics of the first contact (nameless WhatsApp, multi-use building, 'come alone', 'no ID', Messenger-to-WhatsApp funnel, personal-data filter). Type B in Ramona's dual-track classification."@en .

:CommunicationPattern a owl:Class ;
    rdfs:subClassOf :SurvivorTestimonyPattern ;
    rdfs:label "Communication pattern"@en, "Patrón de comunicación"@es ;
    rdfs:comment "A pattern describing which communication tool was used for the first or dominant contact (WhatsApp, Messenger, Telegram, SMS, in-person, etc.)."@en .

:RecruitmentPattern a owl:Class ;
    rdfs:subClassOf :SurvivorTestimonyPattern ;
    rdfs:label "Recruitment pattern"@en, "Patrón de reclutamiento"@es ;
    rdfs:comment "A pattern describing how the recruiter established contact with the candidate (social media, family, friend, intimate partner, abduction, classifieds, street)."@en .

:ExploitationPattern a owl:Class ;
    rdfs:subClassOf :SurvivorTestimonyPattern ;
    rdfs:label "Exploitation pattern"@en, "Patrón de explotación"@es ;
    rdfs:comment "A pattern describing the final exploitation outcome attested or suggested in the evidence source (labour hospitality, sexual, forced criminality, organ removal)."@en .

:DominanceBucket a owl:Class ;
    rdfs:label "Dominance bucket"@en, "Rango de dominancia"@es ;
    rdfs:comment "A qualitative frequency band used to describe how often a pattern is observed in the observatory corpus: hot is at least 5 percent of cases, warm is 1 to 5 percent, cold is below 1 percent. The band is a class with one individual per value so that a query can group patterns by band; :dominanceBucketValue carries the same information as a literal for clients that do not traverse the object property."@en .

:hasDominanceBucket a owl:ObjectProperty ;
    rdfs:domain :SurvivorTestimonyPattern ; rdfs:range :DominanceBucket ;
    rdfs:label "has dominance bucket"@en, "tiene rango de dominancia"@es ;
    rdfs:comment "Relates a survivor-testimony pattern to the frequency band it falls in. Populated by the mapping from the dominance_bucket column of survivor_patterns."@en .

# Datatype properties for observatory measurement

:observedCount a owl:DatatypeProperty ;
    rdfs:domain :SurvivorTestimonyPattern ; rdfs:range xsd:integer ;
    rdfs:label "observed count"@en, "frecuencia observada"@es ;
    rdfs:comment "Number of case-relevant evidence sources in which the pattern was detected."@en .

:pctOfCases a owl:DatatypeProperty ;
    rdfs:domain :SurvivorTestimonyPattern ; rdfs:range xsd:decimal ;
    rdfs:label "percentage of cases"@en, "porcentaje de casos"@es ;
    rdfs:comment "Share of the cases in the source corpus in which the survivor-testimony pattern appears, as a decimal percentage. The value is only meaningful together with the source asserted by :derivedFrom, because corpora differ in what they count."@en .

:dominanceBucketValue a owl:DatatypeProperty ;
    rdfs:domain :SurvivorTestimonyPattern ; rdfs:range xsd:string ;
    rdfs:label "dominance bucket value"@en, "valor de rango de dominancia"@es ;
    rdfs:comment "The frequency band of the pattern as a literal, one of hot, warm or cold. It duplicates :hasDominanceBucket deliberately, so that a client can read the band without following an object property."@en .

:schemeCode a owl:DatatypeProperty ;
    rdfs:domain :FraudScheme ; rdfs:range xsd:string ;
    rdfs:label "scheme code"@en, "código del esquema"@es ;
    rdfs:comment "The local name of the :FraudScheme subclass an individual scheme occurrence belongs to, as a string (for example PayToWorkScheme). It lets a query group occurrences by scheme without querying the class hierarchy."@en .

:routeVictimCount a owl:DatatypeProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range xsd:integer ;
    rdfs:label "route victim count"@en, "número de víctimas en la ruta"@es ;
    rdfs:comment "Number of CTDC-registered victims attested on this (origin, destination) pair."@en .

:routeEarliestYear a owl:DatatypeProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:gYear. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:gYear literals."@en ;
    rdfs:label "route earliest year"@en, "año más temprano de la ruta"@es ;
    rdfs:comment "Earliest year for which the route is attested in the source dataset."@en .

:routeLatestYear a owl:DatatypeProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:gYear. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:gYear literals."@en ;
    rdfs:label "route latest year"@en, "año más reciente de la ruta"@es ;
    rdfs:comment "Most recent year for which the route is attested in the source dataset."@en .

:routeDominantExploitation a owl:ObjectProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range :TypeOfExploitation ;
    rdfs:label "route dominant exploitation"@en, "explotación dominante de la ruta"@es ;
    rdfs:comment "The single exploitation type attested for the majority of victims on this route."@en .

#################################################################
#    Palermo Protocol Article 3 alignment
#    Verbatim definitions from UN Protocol to Prevent, Suppress
#    and Punish Trafficking in Persons (2000), Article 3(a).
#################################################################

:TIPEvent a owl:Class ;
    rdfs:label "TIP event"@en, "Evento de trata de personas"@es ;
    rdfs:comment "A trafficking-in-persons event as defined by the International Classification Standard for Administrative Data on Trafficking in Persons (ICS-TIP, IOM and UNODC, 2023). The TIP event is the central unit of classification in ICS-TIP. In RATR-O a TIPEvent aggregates one victim with at least one Palermo Action, at least one Palermo Means, and at least one Palermo Purpose."@en ;
    rdfs:seeAlso <https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf> .

:PalermoAction a owl:Class ;
    rdfs:label "Palermo Action"@en, "Acción (Palermo)"@es ;
    rdfs:comment "The ACT element of the Palermo Protocol Article 3(a) definition of trafficking in persons: 'the recruitment, transportation, transfer, harbouring or receipt of persons'."@en ;
    rdfs:seeAlso <https://www.ohchr.org/en/instruments-mechanisms/instruments/protocol-prevent-suppress-and-punish-trafficking-persons> .

:Recruitment a owl:Class ;
    rdfs:subClassOf :PalermoAction ;
    rdfs:label "Recruitment (act)"@en, "Reclutamiento (acción)"@es ;
    rdfs:comment "The ACT of recruitment in the sense of Palermo Protocol Article 3(a). In RATR-O it is the act that a deceptive job offer realises, which is why recruitment-stage fraud is in scope of a trafficking ontology and not only of a consumer-fraud one."@en .
:Transportation a owl:Class ;
    rdfs:subClassOf :PalermoAction ;
    rdfs:label "Transportation (act)"@en, "Transporte (acción)"@es ;
    rdfs:comment "The ACT of transportation in the sense of Palermo Protocol Article 3(a): moving the person within or across borders after recruitment."@en .
:Transfer a owl:Class ;
    rdfs:subClassOf :PalermoAction ;
    rdfs:label "Transfer (act)"@en, "Traslado (acción)"@es ;
    rdfs:comment "The ACT of transfer in the sense of Palermo Protocol Article 3(a): handing control over the person from one party to another."@en .
:Harbouring a owl:Class ;
    rdfs:subClassOf :PalermoAction ;
    rdfs:label "Harbouring (act)"@en, "Acogida (acción)"@es ;
    rdfs:comment "The ACT of harbouring in the sense of Palermo Protocol Article 3(a): keeping the person in a place under the control of the perpetrator."@en .
:Receipt a owl:Class ;
    rdfs:subClassOf :PalermoAction ;
    rdfs:label "Receipt of persons (act)"@en, "Recepción de personas (acción)"@es ;
    rdfs:comment "The ACT of receipt of persons in the sense of Palermo Protocol Article 3(a): taking the person into one's control at the end of a transfer."@en .

:PalermoMeans a owl:Class ;
    rdfs:label "Palermo Means"@en, "Medio (Palermo)"@es ;
    rdfs:comment "The MEANS element of the Palermo Protocol Article 3(a) definition: 'the threat or use of force or other forms of coercion, of abduction, of fraud, of deception, of the abuse of power or of a position of vulnerability or of the giving or receiving of payments or benefits to achieve the consent of a person having control over another person'."@en .

:MeansThreatOfForce a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Threat or use of force"@en, "Amenaza o uso de la fuerza"@es ;
    rdfs:comment "The MEANS 'threat or use of force' in the sense of Palermo Protocol Article 3(a)."@en .
:MeansCoercion a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Coercion"@en, "Coacción"@es ;
    rdfs:comment "The MEANS 'other forms of coercion' in the sense of Palermo Protocol Article 3(a)."@en .
:MeansAbduction a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Abduction"@en, "Rapto"@es ;
    rdfs:comment "The MEANS 'abduction' in the sense of Palermo Protocol Article 3(a)."@en .
:MeansFraud a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Fraud"@en, "Fraude"@es ;
    rdfs:comment "The MEANS 'fraud' in the sense of Palermo Protocol Article 3(a). Together with :MeansDeception this is the means that a deceptive job offer typically realises."@en .
:MeansDeception a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Deception"@en, "Engaño"@es ;
    rdfs:comment "The MEANS 'deception' in the sense of Palermo Protocol Article 3(a). A job offer whose terms misrepresent the role, the pay, the employer or the place of work realises this means."@en .
:MeansAbuseOfPower a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Abuse of power"@en, "Abuso de poder"@es ;
    rdfs:comment "The MEANS 'abuse of power' in the sense of Palermo Protocol Article 3(a)."@en .
:MeansAbuseOfVulnerability a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Abuse of a position of vulnerability"@en, "Abuso de una posición de vulnerabilidad"@es ;
    rdfs:comment "The MEANS 'abuse of a position of vulnerability' in the sense of Palermo Protocol Article 3(a). In Ramona's corpus the vulnerability most often invoked is unemployment or urgent need of income, which is why :VulnerabilityFactor is modelled separately on the demographic profile."@en .
:MeansPaymentOrBenefit a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Giving or receiving of payments or benefits to obtain consent"@en,
               "Dar o recibir pagos o beneficios para obtener consentimiento"@es ;
    rdfs:comment "The MEANS 'giving or receiving of payments or benefits to achieve the consent of a person having control over another person' in the sense of Palermo Protocol Article 3(a)."@en .

:PalermoPurpose a owl:Class ;
    rdfs:label "Palermo Purpose"@en, "Finalidad (Palermo)"@es ;
    rdfs:comment "The PURPOSE element of the Palermo Protocol Article 3(a): 'for the purpose of exploitation', which the Protocol exemplifies as 'the exploitation of the prostitution of others or other forms of sexual exploitation, forced labour or services, slavery or practices similar to slavery, servitude or the removal of organs'."@en .

:PurposeSexualExploitation a owl:Class ;
    rdfs:subClassOf :PalermoPurpose ;
    rdfs:label "Sexual exploitation"@en, "Explotación sexual"@es ;
    rdfs:comment "The PURPOSE 'exploitation of the prostitution of others or other forms of sexual exploitation' in the sense of Palermo Protocol Article 3(a)."@en .
:PurposeForcedLabour a owl:Class ;
    rdfs:subClassOf :PalermoPurpose ;
    rdfs:label "Forced labour or services"@en, "Trabajo o servicios forzados"@es ;
    rdfs:comment "The PURPOSE 'forced labour or services' in the sense of Palermo Protocol Article 3(a)."@en .
:PurposeSlavery a owl:Class ;
    rdfs:subClassOf :PalermoPurpose ;
    rdfs:label "Slavery or practices similar to slavery"@en, "Esclavitud o prácticas análogas"@es ;
    rdfs:comment "The PURPOSE 'slavery or practices similar to slavery' in the sense of Palermo Protocol Article 3(a)."@en .
:PurposeServitude a owl:Class ;
    rdfs:subClassOf :PalermoPurpose ;
    rdfs:label "Servitude"@en, "Servidumbre"@es ;
    rdfs:comment "The PURPOSE 'servitude' in the sense of Palermo Protocol Article 3(a)."@en .
:PurposeOrganRemoval a owl:Class ;
    rdfs:subClassOf :PalermoPurpose ;
    rdfs:label "Removal of organs"@en, "Extracción de órganos"@es ;
    rdfs:comment "The PURPOSE 'removal of organs' in the sense of Palermo Protocol Article 3(a)."@en .

# Link RATR-O JobOffer / Victim / FraudScheme to the Palermo triad.

:exhibitsAction a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :PalermoAction ;
    rdfs:label "exhibits Palermo action"@en, "exhibe la acción de Palermo"@es ;
    rdfs:comment "Relates a job offer to the Palermo Action it realises. For a deceptive recruitment offer this is normally :Recruitment."@en .
:exhibitsMeans a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :PalermoMeans ;
    rdfs:label "exhibits Palermo means"@en, "exhibe el medio de Palermo"@es ;
    rdfs:comment "Relates a job offer to the Palermo Means it realises, normally :MeansDeception or :MeansFraud."@en .
:exhibitsPurpose a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :PalermoPurpose ;
    rdfs:label "exhibits Palermo purpose"@en, "exhibe el propósito de Palermo"@es ;
    rdfs:comment "Relates a job offer to the Palermo Purpose it is believed to serve. Assertion of a purpose is an interpretive step and in the demonstrator it is only made when an evidence source states the exploitation outcome."@en .

:tipEventInvolves a owl:ObjectProperty ;
    rdfs:domain :TIPEvent ; rdfs:range :Victim ;
    rdfs:label "TIP event involves victim"@en, "el evento de trata involucra a la víctima"@es ;
    rdfs:comment "Relates a trafficking-in-persons event to the victim it concerns, following the ICS-TIP rule that the TIP event is counted per victim."@en .
:tipEventHasAction a owl:ObjectProperty ;
    rdfs:domain :TIPEvent ; rdfs:range :PalermoAction ;
    rdfs:label "TIP event has action"@en, "el evento de trata tiene la acción"@es ;
    rdfs:comment "Relates a TIP event to one of its Palermo Actions. ICS-TIP requires at least one action per event."@en .
:tipEventHasMeans a owl:ObjectProperty ;
    rdfs:domain :TIPEvent ; rdfs:range :PalermoMeans ;
    rdfs:label "TIP event has means"@en, "el evento de trata tiene el medio"@es ;
    rdfs:comment "Relates a TIP event to one of its Palermo Means. ICS-TIP requires at least one means per adult-victim event."@en .
:tipEventHasPurpose a owl:ObjectProperty ;
    rdfs:domain :TIPEvent ; rdfs:range :PalermoPurpose ;
    rdfs:label "TIP event has purpose"@en, "el evento de trata tiene el propósito"@es ;
    rdfs:comment "Relates a TIP event to one of its Palermo Purposes. ICS-TIP requires at least one purpose per event."@en .

# Pointers to ICS-TIP (IOM and UNODC, 2023), where the corresponding variables are defined.

:RecruitmentMethod rdfs:seeAlso <https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf> .
:TypeOfExploitation rdfs:seeAlso <https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf> .
:VulnerabilityFactor rdfs:seeAlso <https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf> .
:TraffickingRoute rdfs:seeAlso <https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf> .

# UNODC Global Report on Trafficking in Persons (GLOTIP), as a persistent reference.

:Victim rdfs:seeAlso <https://www.unodc.org/unodc/data-and-analysis/glotip.html> .

#################################################################
#    Official statistics
#    Figures that an official source publishes per country and year,
#    such as those Member States report to UNODC for GLOTIP.
#################################################################

:OfficialStatistic a owl:Class ;
    rdfs:label "Official statistic"@en, "Estadística oficial"@es ;
    rdfs:comment "A figure published by an official statistical source for one country and one year, such as the number of detected trafficking victims a Member State reports to UNODC for the Global Report on Trafficking in Persons. It is an aggregate and describes no individual person. The source is given by :hasEvidenceSource."@en ;
    rdfs:seeAlso <https://www.unodc.org/unodc/data-and-analysis/glotip.html> .

:statisticForCountry a owl:ObjectProperty ;
    rdfs:domain :OfficialStatistic ; rdfs:range :Country ;
    rdfs:label "statistic for country"@en, "estadística del país"@es ;
    rdfs:comment "Relates an official statistic to the country that reported it."@en .

:statisticIndicator a owl:DatatypeProperty ;
    rdfs:domain :OfficialStatistic ; rdfs:range xsd:string ;
    rdfs:label "statistic indicator"@en, "indicador de la estadística"@es ;
    rdfs:comment "What the figure counts, as the source names it, for example 'Detected trafficking victims' or 'Persons convicted'."@en .

:statisticDimension a owl:DatatypeProperty ;
    rdfs:domain :OfficialStatistic ; rdfs:range xsd:string ;
    rdfs:label "statistic dimension"@en, "dimensión de la estadística"@es ;
    rdfs:comment "The breakdown the figure belongs to, as the source names it, for example 'by form of exploitation' or 'by citizenship'; 'Total' when the figure is not broken down."@en .

:statisticCategory a owl:DatatypeProperty ;
    rdfs:domain :OfficialStatistic ; rdfs:range xsd:string ;
    rdfs:label "statistic category"@en, "categoría de la estadística"@es ;
    rdfs:comment "The value of the dimension the figure refers to, as the source names it, for example 'Forced labour' under the dimension 'by form of exploitation'."@en .

:statisticSex a owl:DatatypeProperty ;
    rdfs:domain :OfficialStatistic ; rdfs:range xsd:string ;
    rdfs:label "statistic sex"@en, "sexo de la estadística"@es ;
    rdfs:comment "The sex of the persons counted, as the source names it; 'Total' when the figure covers all."@en .

:statisticAge a owl:DatatypeProperty ;
    rdfs:domain :OfficialStatistic ; rdfs:range xsd:string ;
    rdfs:label "statistic age"@en, "edad de la estadística"@es ;
    rdfs:comment "The age band of the persons counted, as the source names it; 'Total' when the figure covers all."@en .

:statisticYear a owl:DatatypeProperty ;
    rdfs:domain :OfficialStatistic ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:gYear. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:gYear literals."@en ;
    rdfs:label "statistic year"@en, "año de la estadística"@es ;
    rdfs:comment "The year the figure refers to."@en .

:statisticValue a owl:DatatypeProperty ;
    rdfs:domain :OfficialStatistic ; rdfs:range xsd:integer ;
    rdfs:label "statistic value"@en, "valor de la estadística"@es ;
    rdfs:comment "The figure as a number. Absent when the source publishes a suppressed value, such as '<5'."@en .

:statisticValueAsPublished a owl:DatatypeProperty ;
    rdfs:domain :OfficialStatistic ; rdfs:range xsd:string ;
    rdfs:label "statistic value as published"@en, "valor de la estadística como se publicó"@es ;
    rdfs:comment "The figure exactly as the source publishes it, including suppressed values such as '<5'."@en .

#################################################################
#    Further object and datatype properties
#################################################################

# Inverse relations
:offers a owl:ObjectProperty ;
    rdfs:domain :Agent ; rdfs:range :JobOffer ;
    owl:inverseOf :offeredBy ;
    rdfs:label "offers"@en, "ofrece"@es ;
    rdfs:comment "Relates an agent to a job offer it makes. Inverse of :offeredBy."@en .

:hostsOffer a owl:ObjectProperty ;
    rdfs:domain :Platform ; rdfs:range :JobOffer ;
    owl:inverseOf :postedVia ;
    rdfs:label "hosts offer"@en, "aloja la oferta"@es ;
    rdfs:comment "Relates a platform to a job offer published on it. Inverse of :postedVia."@en .

:containsRedFlag a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :RedFlag ;
    rdfs:label "contains red flag"@en, "contiene la señal de alerta"@es ;
    rdfs:comment "Relates a job offer to a red flag detected in its text. Kept alongside :hasRedFlag because the mapping layer populates them from different sources: :containsRedFlag from text classification, :hasRedFlag from the reviewed classification record."@en .

:recruitsFor a owl:ObjectProperty ;
    rdfs:domain :Recruiter ; rdfs:range :FraudScheme ;
    rdfs:label "recruits for scheme"@en, "recluta para el esquema"@es ;
    rdfs:comment "Relates a recruiter to the fraud scheme they recruit for."@en .

:operatesIn a owl:ObjectProperty ;
    rdfs:domain :FraudScheme ; rdfs:range :Country ;
    rdfs:label "scheme operates in country"@en, "el esquema opera en el país"@es ;
    rdfs:comment "Relates a fraud scheme to a country where it has been documented."@en .

:schemePreferredTool a owl:ObjectProperty ;
    rdfs:domain :FraudScheme ; rdfs:range :CommunicationTool ;
    rdfs:label "preferred communication tool for scheme"@en, "herramienta de comunicación preferida del esquema"@es ;
    rdfs:comment "Relates a fraud scheme to the communication tool most often used to run it, as documented in the sources cited on the scheme."@en .

:schemeTargetsAgeGroup a owl:ObjectProperty ;
    rdfs:domain :FraudScheme ; rdfs:range :AgeGroup ;
    rdfs:label "scheme targets age group"@en, "el esquema apunta al grupo etario"@es ;
    rdfs:comment "Relates a fraud scheme to the age group it preferentially targets."@en .

:schemeTargetsGender a owl:ObjectProperty ;
    rdfs:domain :FraudScheme ; rdfs:range :Gender ;
    rdfs:label "scheme targets gender"@en, "el esquema apunta al género"@es ;
    rdfs:comment "Relates a fraud scheme to the gender it preferentially targets."@en .

:schemeTypicalRoute a owl:ObjectProperty ;
    rdfs:domain :FraudScheme ; rdfs:range :TraffickingRoute ;
    rdfs:label "typical trafficking route for scheme"@en, "ruta de trata típica del esquema"@es ;
    rdfs:comment "Relates a fraud scheme to a trafficking route along which its victims are typically moved."@en .

:schemeExploitationType a owl:ObjectProperty ;
    rdfs:domain :FraudScheme ; rdfs:range :TypeOfExploitation ;
    rdfs:label "scheme leads to exploitation type"@en, "el esquema conduce al tipo de explotación"@es ;
    rdfs:comment "Relates a fraud scheme to the type of exploitation it leads to."@en .

:evidencedByPressArticle a owl:ObjectProperty ;
    rdfs:domain :FraudScheme ; rdfs:range :PressArticle ;
    rdfs:label "evidenced by press article"@en, "sustentada en el artículo de prensa"@es ;
    rdfs:comment "Relates a fraud scheme to a press article that documents it. Every named scheme in RATR-O carries at least one such link or an rdfs:seeAlso to an institutional source."@en .

:observedInCountry a owl:ObjectProperty ;
    rdfs:domain :SurvivorTestimonyPattern ; rdfs:range :Country ;
    rdfs:label "pattern observed in country"@en, "patrón observado en el país"@es ;
    rdfs:comment "Relates a survivor-testimony pattern to a country where the pattern has been observed."@en .

:patternHasKind a owl:DatatypeProperty ;
    rdfs:domain :SurvivorTestimonyPattern ; rdfs:range xsd:string ;
    rdfs:label "pattern kind"@en, "tipo de patrón"@es ;
    rdfs:comment "The family a survivor-testimony pattern belongs to, as a literal. The values in use are classic_a (a canonical red flag), credible_b (a credible-lethal logistic signal), communication, recruitment, exploitation and deep_textual (extracted by deep-textual regex over press)."@en .

# Additional datatype properties
:offerIsActive a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:boolean. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:boolean literals."@en ;
    rdfs:label "offer is active"@en, "la oferta está activa"@es ;
    rdfs:comment "Whether the offer was still reachable at the time of the last check."@en .

:offerLanguage a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string ;
    rdfs:label "offer language ISO code"@en, "código ISO del idioma de la oferta"@es ;
    rdfs:comment "ISO 639-1 code of the language the offer is written in."@en .

:offerScreenshotUrl a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:anyURI ;
    rdfs:label "offer screenshot URL"@en, "URL de la captura de pantalla de la oferta"@es ;
    rdfs:comment "URL of the stored screenshot of the offer. Screenshots are kept because deceptive offers are typically deleted by the recruiter within days."@en .

:offerFirstContactAt a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:dateTime ;
    rdfs:label "offer first contact timestamp"@en, "fecha y hora del primer contacto de la oferta"@es ;
    rdfs:comment "Timestamp of the first contact between the recruiter and the candidate, as reported by the candidate."@en .

:offerClassifierConfidence a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:decimal ;
    rdfs:label "offer classifier confidence"@en, "confianza del clasificador sobre la oferta"@es ;
    rdfs:comment "Confidence reported by the classifier that produced the offer's risk assessment, on a zero-to-one scale."@en .

:victimCaseOpenedAt a owl:DatatypeProperty ;
    rdfs:domain :Victim ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:date. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:date literals."@en ;
    rdfs:label "victim case opened at"@en, "fecha de apertura del caso de la víctima"@es ;
    rdfs:comment "Date on which the case concerning the victim was opened by the registering institution."@en .

:victimCaseClosedAt a owl:DatatypeProperty ;
    rdfs:domain :Victim ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:date. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:date literals."@en ;
    rdfs:label "victim case closed at"@en, "fecha de cierre del caso de la víctima"@es ;
    rdfs:comment "Date on which the case concerning the victim was closed by the registering institution."@en .

:victimHasChildrenCount a owl:DatatypeProperty ;
    rdfs:domain :Victim ; rdfs:range xsd:integer ;
    rdfs:label "number of children"@en, "número de hijas e hijos"@es ;
    rdfs:comment "ICS-TIP additional disaggregating variable."@en .

:victimEducationLevel a owl:DatatypeProperty ;
    rdfs:domain :Victim ; rdfs:range xsd:string ;
    rdfs:label "education level"@en, "nivel educativo"@es ;
    rdfs:comment "ICS-TIP additional disaggregating variable. Controlled vocab: none, primary, secondary, tertiary, postgraduate, unknown."@en .

:victimMaritalStatus a owl:DatatypeProperty ;
    rdfs:domain :Victim ; rdfs:range xsd:string ;
    rdfs:label "marital status"@en, "estado civil"@es ;
    rdfs:comment "ICS-TIP additional disaggregating variable. Controlled vocab: single, married, cohabiting, separated, divorced, widowed, unknown."@en .

:victimPriorEmployment a owl:DatatypeProperty ;
    rdfs:domain :Victim ; rdfs:range xsd:string ;
    rdfs:label "prior employment status"@en, "situación laboral previa"@es ;
    rdfs:comment "Employment situation of the victim before recruitment, as recorded by the source dataset."@en .
:hasMeansOfControl a owl:DatatypeProperty ;
    rdfs:domain :Victim ; rdfs:range xsd:string ;
    rdfs:label "means of control over victim"@en, "medio de control sobre la víctima"@es ;
    rdfs:comment "Means of control exercised over the victim, as a code from the control-means list of the source dataset. Distinct from :PalermoMeans, which covers the means used to obtain the person; this property covers the means used to keep them."@en .

:victimReferralSource a owl:DatatypeProperty ;
    rdfs:domain :Victim ; rdfs:range xsd:string ;
    rdfs:label "victim referral source"@en, "fuente de derivación de la víctima"@es ;
    rdfs:comment "How the victim was identified: self-report, NGO, law enforcement, embassy, hotline."@en .

:routeIsTransnational a owl:DatatypeProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:boolean. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:boolean literals."@en ;
    rdfs:label "route is transnational"@en, "la ruta es transnacional"@es ;
    rdfs:comment "Whether the route crosses an international border. Internal routes matter in Mexico, where most documented recruitment-to-exploitation movement is domestic."@en .

:routeStopoverCountries a owl:DatatypeProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range xsd:string ;
    rdfs:label "route stopover countries (ISO3 list)"@en, "países de tránsito de la ruta (lista ISO3)"@es ;
    rdfs:comment "Stopover countries of the route, as a list of ISO 3166-1 alpha-3 codes."@en .

:routeUpdatedAt a owl:DatatypeProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range xsd:dateTime ;
    rdfs:label "route record last updated at"@en, "última actualización del registro de la ruta"@es ;
    rdfs:comment "Timestamp at which the route record was last updated from its source dataset."@en .

:schemeNamedAfterCase a owl:DatatypeProperty ;
    rdfs:domain :FraudScheme ; rdfs:range xsd:string ;
    rdfs:label "scheme archetypal case name"@en, "caso arquetípico que da nombre al esquema"@es ;
    rdfs:comment "Name of the archetypal public case the scheme is named after. Used only for cases already public in the press."@en .

:schemeFirstAttestedYear a owl:DatatypeProperty ;
    rdfs:domain :FraudScheme ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:gYear. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:gYear literals."@en ;
    rdfs:label "scheme first attested year"@en, "año en que se documentó el esquema por primera vez"@es ;
    rdfs:comment "Earliest year in which the scheme is attested by one of the sources cited on it."@en .

:schemeJurisdictionScope a owl:DatatypeProperty ;
    rdfs:domain :FraudScheme ; rdfs:range xsd:string ;
    rdfs:label "scheme jurisdiction scope"@en, "ámbito jurisdiccional del esquema"@es ;
    rdfs:comment "local, national, regional, continental, global."@en .

:evidenceStrength a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range xsd:string ;
    rdfs:label "evidence strength"@en, "fuerza de la evidencia"@es ;
    rdfs:comment "primary / secondary / tertiary. Primary = direct survivor testimony, official statistics, court record; secondary = investigative journalism; tertiary = summary or editorial article."@en .

:sourceLanguage a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range xsd:string ;
    rdfs:label "source language ISO code"@en, "código ISO del idioma de la fuente"@es ;
    rdfs:comment "ISO 639-1 code of the language the evidence source is written in."@en .

:sourceAccessedAt a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range xsd:dateTime ;
    rdfs:label "source accessed timestamp"@en, "fecha y hora de consulta de la fuente"@es ;
    rdfs:comment "Timestamp at which the evidence source was accessed. Recorded for every source, because a share of the press and institutional URLs in the corpus stop resolving."@en .

# Additional structural object properties
:tipEventHappenedIn a owl:ObjectProperty ;
    rdfs:domain :TIPEvent ; rdfs:range :Country ;
    rdfs:label "TIP event happened in country"@en, "el evento de trata ocurrió en el país"@es ;
    rdfs:comment "Relates a TIP event to the country where it took place."@en .
:tipEventRegisteredBy a owl:ObjectProperty ;
    rdfs:domain :TIPEvent ; rdfs:range :Agent ;
    rdfs:label "TIP event registered by"@en, "evento de trata registrado por"@es ;
    rdfs:comment "Relates a TIP event to the agent that registered it, typically an institution rather than a natural person."@en .
:schemePalermoAction a owl:ObjectProperty ;
    rdfs:domain :FraudScheme ; rdfs:range :PalermoAction ;
    rdfs:label "scheme Palermo action"@en, "acción de Palermo del esquema"@es ;
    rdfs:comment "Relates a fraud scheme to the Palermo Action that characterises it."@en .
:schemePalermoMeans a owl:ObjectProperty ;
    rdfs:domain :FraudScheme ; rdfs:range :PalermoMeans ;
    rdfs:label "scheme Palermo means"@en, "medio de Palermo del esquema"@es ;
    rdfs:comment "Relates a fraud scheme to the Palermo Means that characterises it."@en .
:schemePalermoPurpose a owl:ObjectProperty ;
    rdfs:domain :FraudScheme ; rdfs:range :PalermoPurpose ;
    rdfs:label "scheme Palermo purpose"@en, "propósito de Palermo del esquema"@es ;
    rdfs:comment "Relates a fraud scheme to the Palermo Purpose that characterises it."@en .
:platformModeratedBy a owl:ObjectProperty ;
    rdfs:domain :Platform ; rdfs:range :Agent ;
    rdfs:label "platform moderated by"@en, "plataforma moderada por"@es ;
    rdfs:comment "Relates a platform to the agent responsible for its moderation, used to record to whom a reported offer can be escalated."@en .

# Fine-grained datatype properties
:flagKeywordPattern a owl:DatatypeProperty ;
    rdfs:domain :RedFlag ; rdfs:range xsd:string ;
    rdfs:label "flag keyword pattern"@en, "patrón de palabras clave de la señal"@es ;
    rdfs:comment "Regex used by the rule-based classifier."@en .
:patternRegex a owl:DatatypeProperty ;
    rdfs:domain :SurvivorTestimonyPattern ; rdfs:range xsd:string ;
    rdfs:label "pattern regex"@en, "expresión regular del patrón"@es ;
    rdfs:comment "Regular expression used to detect the pattern in offer text. Published together with the pattern so that any reported count can be reproduced and contested."@en .
:riskExplanationEn a owl:DatatypeProperty ;
    rdfs:domain :RiskClassification ; rdfs:range xsd:string ;
    rdfs:label "risk explanation in English"@en, "explicación del riesgo en inglés"@es ;
    rdfs:comment "Explanation of the risk classification in English, as shown to the person who reported the offer."@en .
:riskExplanationEs a owl:DatatypeProperty ;
    rdfs:domain :RiskClassification ; rdfs:range xsd:string ;
    rdfs:label "risk explanation in Spanish"@en, "explicación del riesgo en español"@es ;
    rdfs:comment "Explanation of the risk classification in Spanish, as shown to the person who reported the offer."@en .
:evidenceAccessedOnline a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:boolean. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:boolean literals."@en ;
    rdfs:label "evidence accessed online"@en, "evidencia consultada en línea"@es ;
    rdfs:comment "Whether the evidence source was consulted online rather than on paper."@en .
:evidenceArchivedUrl a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range xsd:anyURI ;
    rdfs:label "evidence archived URL (e.g. archive.today)"@en, "URL archivada de la evidencia (por ejemplo archive.today)"@es ;
    rdfs:comment "URL of an archived copy of the evidence source, used when the original stops resolving."@en .


# Link properties: an offer or a victim can exhibit one or more FraudSchemes.

:exhibitsFraudScheme a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :FraudScheme ;
    rdfs:label "exhibits fraud scheme"@en, "presenta esquema de fraude"@es ;
    rdfs:comment "Relates a job offer to the named fraud scheme it instantiates."@en .

:victimOfFraudScheme a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :FraudScheme ;
    rdfs:label "victim of fraud scheme"@en, "víctima de esquema de fraude"@es ;
    rdfs:comment "Relates a victim to the named fraud scheme they were subjected to."@en .


:SurvivorTestimonyPattern a owl:Class ;
    rdfs:label "Survivor testimony pattern"@en, "Patrón de testimonio de sobreviviente"@es ;
    rdfs:comment "A recurring linguistic or logistical pattern extracted from survivor interviews or documented cases."@en .

#################################################################
#    Classes aligned to HUTRO (generalisable fragment)
#################################################################
#
# HUTRO (BioPortal acronym HUTRO, submission 1, 22 April 2025) is a SKOS vocabulary of 36 top
# concepts and 90 individuals about the trafficking of Eritrean refugees in Ethiopia. Its
# submission metadata declares the placeholder namespace http://www.example.com, but BioPortal
# reports and resolves each concept under https://bioportal.bioontology.org/ontologies/HUTRO with
# the local name appended directly, with no separating slash or hash. That concatenated form is
# the identifier HUTRO is served under, and it is the form the hutro: prefix of this file expands
# to. All eight IRIs below were checked one by one in the BioPortal concept browser on
# 10 November 2026 and each resolved to the expected preferred label.
#

:RecruitmentMethod a owl:Class ;
    rdfs:label "Recruitment method"@en, "Método de reclutamiento"@es ;
    rdfs:comment "The mechanism by which a potential victim is initially approached and enlisted into a trafficking or fraudulent-employment scheme."@en ;
    rdfs:seeAlso <https://bioportal.bioontology.org/ontologies/HUTRO> ;
    skos:closeMatch hutro:recuritment_method ;
    skos:note "Close match to the HUTRO concept 'recruitment method' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Recruitment Method'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile. The local name reproduces the spelling HUTRO uses, recuritment_method."@en .

:TypeOfExploitation a owl:Class ;
    rdfs:label "Type of exploitation"@en, "Tipo de explotación"@es ;
    rdfs:comment "The exploitation outcome associated with a trafficking case. Controlled vocabulary covers labour, sexual, forced criminality, forced marriage, organ removal, mixed."@en ;
    rdfs:seeAlso <https://bioportal.bioontology.org/ontologies/HUTRO> ;
    skos:closeMatch hutro:type_of_exploitation ;
    skos:note "Close match to the HUTRO concept 'type of exploitation' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Type of exploitation'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile."@en .

:VulnerabilityFactor a owl:Class ;
    rdfs:label "Vulnerability factor"@en, "Factor de vulnerabilidad"@es ;
    rdfs:comment "A socioeconomic, demographic or situational factor that increases the probability of a candidate accepting a high-risk offer."@en ;
    rdfs:seeAlso <https://bioportal.bioontology.org/ontologies/HUTRO> ;
    skos:closeMatch hutro:vulnerability_factor ;
    skos:note "Close match to the HUTRO concept 'vulnerability factor' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Vulnerability Factor'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile."@en .

:TransportationMeans a owl:Class ;
    rdfs:label "Transportation means"@en, "Medio de transporte"@es ;
    rdfs:comment "The means of transport used at a stage of the trafficking route."@en ;
    rdfs:seeAlso <https://bioportal.bioontology.org/ontologies/HUTRO> ;
    skos:closeMatch hutro:transportation_means ;
    skos:note "Close match to the HUTRO concept 'transportation means' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Transportation Means'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile."@en .

:CommunicationTool a owl:Class ;
    rdfs:label "Communication tool"@en, "Herramienta de comunicación"@es ;
    rdfs:comment "A tool used for communication between recruiters, smugglers, traffickers or victims. Distinct from Platform because it describes the tool itself, not the platform it runs on."@en ;
    rdfs:seeAlso <https://bioportal.bioontology.org/ontologies/HUTRO> ;
    skos:closeMatch hutro:smuggler_trafficker_communication_tools ;
    skos:note "Close match to the HUTRO concept 'smuggler and trafficker communication tools' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Smuggler and Trafficker Communication Tools'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile. HUTRO writes the local name without the conjunction: smuggler_trafficker_communication_tools."@en .

:DocumentationType a owl:Class ;
    rdfs:label "Documentation type"@en, "Tipo de documentación"@es ;
    rdfs:comment "An identity or travel document demanded or withheld during recruitment. Includes the case of falsified documents."@en ;
    rdfs:seeAlso <https://bioportal.bioontology.org/ontologies/HUTRO> ;
    skos:closeMatch hutro:documentation_type ;
    skos:note "Close match to the HUTRO concept 'documentation type' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Documentation Type'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile."@en .

:FalseDocumentation a owl:Class ;
    rdfs:subClassOf :DocumentationType ;
    rdfs:label "False documentation"@en, "Documentación falsa"@es ;
    rdfs:seeAlso <https://bioportal.bioontology.org/ontologies/HUTRO> ;
    skos:closeMatch hutro:false_documentation ;
    skos:note "Close match to the HUTRO concept 'false documentation' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'False Documentation'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile."@en ;
    rdfs:comment "Documentation carried by a victim that was forged, altered or issued in another person's name. One of the values of :DocumentationType."@en .

#################################################################
#    Victim and demographic classes
#################################################################

:Victim a owl:Class ;
    rdfs:label "Victim"@en, "Víctima"@es ;
    rdfs:comment "A person documented as having been exploited or attempted-to-be-exploited in a trafficking or fraudulent-employment scheme. Sourced from anonymised CTDC records and publicly reported press cases."@en .

:DemographicProfile a owl:Class ;
    rdfs:label "Demographic profile"@en, "Perfil demográfico"@es ;
    rdfs:comment "An anonymised demographic description of a victim or candidate, covering age group, gender, nationality and education."@en .

:AgeGroup a owl:Class ;
    rdfs:label "Age group"@en, "Grupo etario"@es ;
    rdfs:comment "A coarse age bucket aligned to CTDC: 0-8, 9-17, 18-20, 21-23, 24-26, 27-29, 30-38, 39-47, 48+."@en .

:Gender a owl:Class ;
    rdfs:label "Gender"@en, "Género"@es ;
    rdfs:comment "The gender recorded for a demographic profile or targeted by a fraud scheme. Modelled as a class of individuals rather than a literal so that the value set stays open and can be aligned to the categories of external datasets without changing the TBox."@en .

#################################################################
#    Routes, countries, sources
#################################################################

:TraffickingRoute a owl:Class ;
    rdfs:label "Trafficking route"@en, "Ruta de trata"@es ;
    rdfs:seeAlso <https://bioportal.bioontology.org/ontologies/HUTRO> ;
    skos:closeMatch hutro:trafficking_transit_places ;
    skos:note "Close match to the HUTRO concept 'trafficking transit places' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Trafficking Transit Places'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile."@en ;
    rdfs:comment "An origin-to-destination pair, optionally with stopover countries, along which victims are moved. Routes in the demonstrator are derived from aggregated citizenship and country-of-exploitation pairs in the CTDC global synthetic dataset, never from individual case records."@en .

:Country a owl:Class ;
    rdfs:label "Country"@en, "País"@es ;
    rdfs:comment "A country or territory used as the origin, destination, stopover or jurisdiction of an offer, a route, a platform, a recruiter or a TIP event. Identified by its ISO 3166-1 code through :countryISOCode."@en .

:Language a owl:Class ;
    rdfs:label "Language"@en, "Idioma"@es ;
    rdfs:comment "A natural language in which an offer, a social-media item or an evidence source is written. Identified by its ISO 639-1 code through :languageISOCode."@en .

:EvidenceSource a owl:Class ;
    rdfs:label "Evidence source"@en, "Fuente de evidencia"@es ;
    rdfs:comment "A public document or case file from which a pattern, route, offer or victim record was derived (e.g. press article, CTDC record, NGO report)."@en .

:PressArticle a owl:Class ;
    rdfs:subClassOf :EvidenceSource ;
    rdfs:label "Press article"@en, "Artículo de prensa"@es ;
    rdfs:comment "An item of journalism used as the evidence anchor for a documented case. A subclass of :EvidenceSource. Press records in RATR-O are aggregated at the article level, with outlet, title, URL and classification only, and carry no personal data about the people the article names."@en .

:OpenDatasetRecord a owl:Class ;
    rdfs:subClassOf :EvidenceSource ;
    rdfs:label "Open dataset record"@en, "Registro de dataset abierto"@es ;
    rdfs:comment "A single anonymised case record drawn from an open anti-trafficking dataset such as CTDC or UNODC."@en .

#################################################################
#    Object properties — Offer-centric
#################################################################

:offeredBy a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :Agent ;
    rdfs:label "offered by"@en, "ofrecida por"@es ;
    rdfs:comment "Relates a job offer to the agent that made it. Specialised by :offeredByRecruiter and :offeredByEmployer."@en .

:offeredByRecruiter a owl:ObjectProperty ;
    rdfs:subPropertyOf :offeredBy ;
    rdfs:domain :JobOffer ; rdfs:range :Recruiter ;
    rdfs:label "offered by recruiter"@en, "ofrecida por el reclutador"@es ;
    rdfs:comment "Relates a job offer to the recruiter that made it. A subproperty of :offeredBy."@en .

:offeredByEmployer a owl:ObjectProperty ;
    rdfs:subPropertyOf :offeredBy ;
    rdfs:domain :JobOffer ; rdfs:range :Employer ;
    rdfs:label "offered by employer"@en, "ofrecida por el empleador"@es ;
    rdfs:comment "Relates a job offer to the employer that made it. A subproperty of :offeredBy."@en .

:postedVia a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :Platform ;
    rdfs:label "posted via"@en, "publicada a través de"@es ;
    rdfs:comment "Relates a job offer to the platform on which it was published or through which first contact happened."@en .

:hasRedFlag a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :RedFlag ;
    rdfs:label "has red flag"@en, "tiene señal de alerta"@es ;
    rdfs:comment "Relates a job offer to a red flag recorded in its reviewed classification."@en .

:matchesPattern a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :SurvivorTestimonyPattern ;
    rdfs:label "matches pattern"@en, "coincide con el patrón"@es ;
    rdfs:comment "Relates a job offer to a survivor-testimony pattern whose detection rule it matches."@en .

:hasRiskClassification a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :RiskClassification ;
    rdfs:label "has risk classification"@en, "tiene clasificación de riesgo"@es ;
    rdfs:comment "Relates a job offer to a risk classification produced for it. A single offer may carry several classifications, one per classifier version, which is why the classification is reified rather than stored as a literal on the offer."@en .

:inCountry a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :Country ;
    rdfs:label "in country"@en, "en el país"@es ;
    rdfs:comment "Relates a job offer to the country in which it was published or in which the work was offered. Its domain is :JobOffer, so it is not used for victims: the country in which a victim was exploited is stated with :exploitedInCountry."@en .

:exploitedInCountry a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :Country ;
    rdfs:label "exploited in country"@en, "explotada en el país"@es ;
    rdfs:comment "Relates a victim record to the country in which the exploitation took place (CountryOfExploitation in CTDC)."@en .

:inLanguage a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :Language ;
    rdfs:label "in language"@en, "en el idioma"@es ;
    rdfs:comment "Relates a job offer to the language it is written in."@en .

:associatedWithRoute a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :TraffickingRoute ;
    rdfs:label "associated with route"@en, "asociada con la ruta"@es ;
    rdfs:comment "Relates a job offer to a trafficking route it is associated with, normally through the origin and destination it names."@en .

:hasRecruitmentMethod a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :RecruitmentMethod ;
    rdfs:label "has recruitment method"@en, "tiene método de reclutamiento"@es ;
    rdfs:comment "Relates a job offer to the recruitment method it uses, in the sense of the ICS-TIP recruitment-method variable."@en .

:leadsToExploitation a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :TypeOfExploitation ;
    rdfs:label "leads to exploitation"@en, "conduce a explotación"@es ;
    rdfs:comment "Only asserted when the offer has been confirmed to have produced an exploitation outcome (from press case or dataset confirmation)."@en .

#################################################################
#    Object properties — Victim-centric
#################################################################

:victimOfOffer a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :JobOffer ;
    rdfs:label "victim of offer"@en, "víctima de la oferta"@es ;
    rdfs:comment "Relates a victim to the job offer through which they were recruited."@en .

:victimOfExploitation a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :TypeOfExploitation ;
    rdfs:label "victim of exploitation type"@en, "víctima del tipo de explotación"@es ;
    rdfs:comment "Relates a victim to a type of exploitation they were subjected to."@en .

:hasDemographicProfile a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :DemographicProfile ;
    rdfs:label "has demographic profile"@en, "tiene perfil demográfico"@es ;
    rdfs:comment "Relates a victim to their demographic profile. The profile is reified so that age group, gender, nationality and vulnerability factors can be recorded without ever attaching identifying attributes to the victim individual."@en .

:hasAgeGroup a owl:ObjectProperty ;
    rdfs:domain :DemographicProfile ; rdfs:range :AgeGroup ;
    rdfs:label "has age group"@en, "tiene grupo etario"@es ;
    rdfs:comment "Relates a demographic profile to an age group. RATR-O records age only in bands, never as a date of birth or an exact age."@en .

:hasGender a owl:ObjectProperty ;
    rdfs:domain :DemographicProfile ; rdfs:range :Gender ;
    rdfs:label "has gender"@en, "tiene género"@es ;
    rdfs:comment "Relates a demographic profile to a gender."@en .

:hasNationality a owl:ObjectProperty ;
    rdfs:domain :DemographicProfile ; rdfs:range :Country ;
    rdfs:label "has nationality"@en, "tiene nacionalidad"@es ;
    rdfs:comment "Relates a demographic profile to a country of nationality."@en .

:hasVulnerabilityFactor a owl:ObjectProperty ;
    rdfs:domain :DemographicProfile ; rdfs:range :VulnerabilityFactor ;
    rdfs:label "has vulnerability factor"@en, "tiene factor de vulnerabilidad"@es ;
    rdfs:comment "Relates a demographic profile to a vulnerability factor, in the sense of the ICS-TIP vulnerability variable."@en .

:recruitedVia a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :RecruitmentMethod ;
    rdfs:label "recruited via"@en, "reclutada a través de"@es ;
    rdfs:comment "Relates a victim to the recruitment method used on them."@en .

:contactedThrough a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :CommunicationTool ;
    rdfs:label "contacted through"@en, "contactada a través de"@es ;
    rdfs:comment "Relates a victim to the communication tool through which the recruiter contacted them."@en .

:transportedBy a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :TransportationMeans ;
    rdfs:label "transported by"@en, "transportada por"@es ;
    rdfs:comment "Relates a victim to the means of transportation used to move them."@en .

:travelledWith a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :DocumentationType ;
    rdfs:label "travelled with documentation"@en, "viajó con la documentación"@es ;
    rdfs:comment "Relates a victim to the type of documentation they travelled with."@en .

#################################################################
#    Object properties — Route and agents
#################################################################

:originCountry a owl:ObjectProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range :Country ;
    rdfs:label "origin country"@en, "país de origen"@es ;
    rdfs:comment "Relates a trafficking route to its country of origin."@en .

:destinationCountry a owl:ObjectProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range :Country ;
    rdfs:label "destination country"@en, "país de destino"@es ;
    rdfs:comment "Relates a trafficking route to its country of destination."@en .

:platformCountry a owl:ObjectProperty ;
    rdfs:domain :Platform ; rdfs:range :Country ;
    rdfs:label "platform country"@en, "país de la plataforma"@es ;
    rdfs:comment "Relates a platform to the country of its operator, used to establish which jurisdiction a takedown request falls under."@en .

:recruiterCountry a owl:ObjectProperty ;
    rdfs:domain :Recruiter ; rdfs:range :Country ;
    rdfs:label "recruiter country"@en, "país del reclutador"@es ;
    rdfs:comment "Relates a recruiter to the country they operate from, as far as it can be established from the report."@en .

:submittedBy a owl:ObjectProperty ;
    rdfs:domain :Submission ; rdfs:range :Candidate ;
    rdfs:label "submitted by"@en, "enviada por"@es ;
    rdfs:comment "Relates a submission to the candidate that sent it."@en .

:submittedOffer a owl:ObjectProperty ;
    rdfs:domain :Submission ; rdfs:range :JobOffer ;
    rdfs:label "submitted offer"@en, "oferta enviada"@es ;
    rdfs:comment "Relates a submission to the job offer it is about. Submissions are reified so that the same offer reported by several candidates is one offer with several submissions."@en .

:evidenceFor a owl:ObjectProperty ;
    rdfs:domain :EvidenceSource ;
    rdfs:range :SurvivorTestimonyPattern ;
    rdfs:label "evidence for"@en, "evidencia de"@es ;
    rdfs:comment "Links an evidence source to the pattern, route, offer or victim it documents."@en .

:hasEvidenceSource a owl:ObjectProperty ;
    rdfs:range :EvidenceSource ;
    rdfs:label "has evidence source"@en, "tiene fuente de evidencia"@es ;
    rdfs:comment "Provenance, stated without restricting the kind of thing being traced. Routes, victim records, patterns and offers all carry at least one evidence source, so this property has a range but no domain, and the kind-specific properties :derivedFrom (patterns) and :offerDocumentedIn (offers) are subproperties of it. A query that asks what any fact rests on uses this property; a query about one kind of fact uses the subproperty."@en .

:derivedFrom a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasEvidenceSource ;
    rdfs:domain :SurvivorTestimonyPattern ;
    rdfs:range :EvidenceSource ;
    rdfs:label "derived from"@en, "derivado de"@es ;
    rdfs:comment "Relates a survivor-testimony pattern to the evidence source it was derived from. Every pattern in RATR-O carries at least one such link, so that no detection rule is asserted without a traceable origin."@en .

#################################################################
#    Datatype properties — JobOffer
#################################################################

:hasTitle a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string ;
    rdfs:label "offer title"@en, "título de la oferta"@es ;
    rdfs:comment "Title or headline of the job offer as published."@en .

:hasRawText a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string ;
    rdfs:label "offer raw text"@en, "texto crudo de la oferta"@es ;
    rdfs:comment "Verbatim text of the offer as published or as forwarded by the candidate. The raw text is kept because the wording is the object of study, and it is stored with contact details removed."@en .

:postedOn a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:date. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:date literals."@en ;
    rdfs:label "posted on"@en, "publicado el"@es ;
    rdfs:comment "Date on which the offer was published."@en .

:offeredSalaryMXN a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:decimal ;
    rdfs:comment "Weekly salary in MXN as advertised in the offer."@en ;
    rdfs:label "offered salary in MXN"@en, "salario ofrecido en MXN"@es .

:offeredRole a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string ;
    rdfs:label "offered role"@en, "rol ofrecido"@es ;
    rdfs:comment "Job title or role as named in the offer, in the words of the offer."@en .

:offeredLocation a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string ;
    rdfs:label "offered location"@en, "ubicación ofrecida"@es ;
    rdfs:comment "Place of work as named in the offer, in the words of the offer."@en .

:riskScore a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:decimal ;
    rdfs:label "risk score"@en, "puntuación de riesgo"@es ;
    rdfs:comment "Aggregate risk score computed for the offer by the classifier version recorded on the classification."@en .

#################################################################
#    Datatype properties — Platform, Agent, flag, classification
#################################################################

:platformName a owl:DatatypeProperty ;
    rdfs:domain :Platform ; rdfs:range xsd:string ;
    rdfs:label "platform name"@en, "nombre de la plataforma"@es ;
    rdfs:comment "Name of the platform."@en .

:platformType a owl:DatatypeProperty ;
    rdfs:domain :Platform ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: whatsapp, telegram, messenger, sms, facebook, tiktok, marketplace, classifieds, tiktok, other."@en ;
    rdfs:label "platform type"@en, "tipo de plataforma"@es .

:agentName a owl:DatatypeProperty ;
    rdfs:domain :Agent ; rdfs:range xsd:string ;
    rdfs:label "agent name"@en, "nombre del agente"@es ;
    rdfs:comment "Name of the agent as it appears in the offer or the report. For recruiters this is the name they gave, which is frequently false, and never a verified identity."@en .

:contactHash a owl:DatatypeProperty ;
    rdfs:domain :Recruiter ; rdfs:range xsd:string ;
    rdfs:label "contact hash"@en, "hash de contacto"@es ;
    rdfs:comment "SHA-256 digest of the recruiter's contact identifier. The digest lets the same contact be recognised across reports without storing the phone number or the account name."@en .

:historicalOfferCount a owl:DatatypeProperty ;
    rdfs:domain :Agent ; rdfs:range xsd:integer ;
    rdfs:label "historical offer count"@en, "ofertas históricas"@es ;
    rdfs:comment "Number of offers previously recorded for this agent in Ramona's own data."@en .

:historicalFlagCount a owl:DatatypeProperty ;
    rdfs:domain :Agent ; rdfs:range xsd:integer ;
    rdfs:label "historical flag count"@en, "banderas históricas"@es ;
    rdfs:comment "Number of red flags previously recorded across this agent's offers in Ramona's own data."@en .

:hasVerifiedIdentity a owl:DatatypeProperty ;
    rdfs:domain :Employer ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:boolean. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:boolean literals."@en ;
    rdfs:label "has verified identity"@en, "tiene identidad verificada"@es ;
    rdfs:comment "Whether the employer's legal identity was verified against a public register."@en .

:flagType a owl:DatatypeProperty ;
    rdfs:domain :RedFlag ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary of 7 red flags defined by Ramona AI: sueldo_alto, horarios_flexibles, sin_experiencia, pago_adelantado, aceptacion_urgente, entrevista_lejana_traslado, empleo_fuera_estado."@en ;
    rdfs:label "flag type"@en, "tipo de bandera"@es .

:flagConfidence a owl:DatatypeProperty ;
    rdfs:domain :RedFlag ; rdfs:range xsd:decimal ;
    rdfs:label "flag confidence"@en, "confianza de la bandera"@es ;
    rdfs:comment "Confidence of the red-flag detection, on a zero-to-one scale."@en .

:detectedBy a owl:DatatypeProperty ;
    rdfs:domain :RedFlag ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: rule, nlp, human."@en ;
    rdfs:label "detected by"@en, "detectado por"@es .

:riskLevel a owl:DatatypeProperty ;
    rdfs:domain :RiskClassification ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: safe, suspicious, high-risk, fraudulent."@en ;
    rdfs:label "risk level"@en, "nivel de riesgo"@es .

:explanationText a owl:DatatypeProperty ;
    rdfs:domain :RiskClassification ; rdfs:range xsd:string ;
    rdfs:label "explanation text"@en, "texto explicativo"@es ;
    rdfs:comment "Explanation of the risk classification in the language of the report."@en .

:classifiedOn a owl:DatatypeProperty ;
    rdfs:domain :RiskClassification ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:date. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:date literals."@en ;
    rdfs:label "classified on"@en, "clasificado el"@es ;
    rdfs:comment "Date on which the classification was produced."@en .

:classifierVersion a owl:DatatypeProperty ;
    rdfs:domain :RiskClassification ; rdfs:range xsd:string ;
    rdfs:label "classifier version"@en, "versión del clasificador"@es ;
    rdfs:comment "Identifier of the classifier version that produced the classification. Required, so that counts can be recomputed after a classifier is corrected."@en .

:patternName a owl:DatatypeProperty ;
    rdfs:domain :SurvivorTestimonyPattern ; rdfs:range xsd:string ;
    rdfs:label "pattern name"@en, "nombre del patrón"@es ;
    rdfs:comment "Short name of the survivor-testimony pattern."@en .

:patternDescription a owl:DatatypeProperty ;
    rdfs:domain :SurvivorTestimonyPattern ; rdfs:range xsd:string ;
    rdfs:label "pattern description"@en, "descripción del patrón"@es ;
    rdfs:comment "Description of the survivor-testimony pattern in prose."@en .

#################################################################
#    Datatype properties — Route, country, language
#################################################################

:routeName a owl:DatatypeProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range xsd:string ;
    rdfs:label "route name"@en, "nombre de la ruta"@es ;
    rdfs:comment "Human-readable name of the route."@en .

:knownSince a owl:DatatypeProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:date. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:date literals."@en ;
    rdfs:label "known since"@en, "conocida desde"@es ;
    rdfs:comment "Date from which the route is known to Ramona."@en .

:countryName a owl:DatatypeProperty ;
    rdfs:domain :Country ; rdfs:range xsd:string ;
    rdfs:label "country name"@en, "nombre del país"@es ;
    rdfs:comment "Name of the country in English."@en .

:countryISOCode a owl:DatatypeProperty ;
    rdfs:domain :Country ; rdfs:range xsd:string ;
    rdfs:label "country ISO code"@en, "código ISO del país"@es ;
    rdfs:comment "ISO 3166-1 code of the country."@en .

:languageName a owl:DatatypeProperty ;
    rdfs:domain :Language ; rdfs:range xsd:string ;
    rdfs:label "language name"@en, "nombre del idioma"@es ;
    rdfs:comment "Name of the language in English."@en .

:languageISOCode a owl:DatatypeProperty ;
    rdfs:domain :Language ; rdfs:range xsd:string ;
    rdfs:label "language ISO code"@en, "código ISO del idioma"@es ;
    rdfs:comment "ISO 639-1 code of the language."@en .

#################################################################
#    Datatype properties — HUTRO-aligned concepts
#################################################################

:recruitmentMethodName a owl:DatatypeProperty ;
    rdfs:domain :RecruitmentMethod ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: personal_network, false_job_offer, social_media_contact, abduction, sale_by_family, debt_bondage, other."@en ;
    rdfs:label "recruitment method name"@en, "nombre del método de reclutamiento"@es .

:exploitationType a owl:DatatypeProperty ;
    rdfs:domain :TypeOfExploitation ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: labour, sexual, forced_criminality, forced_marriage, organ_removal, mixed, unknown."@en ;
    rdfs:label "exploitation type name"@en, "nombre del tipo de explotación"@es .

:vulnerabilityFactorName a owl:DatatypeProperty ;
    rdfs:domain :VulnerabilityFactor ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: economic, migrant_status, minor, prior_abuse, low_education, single_parent, displaced, indigenous, other."@en ;
    rdfs:label "vulnerability factor name"@en, "nombre del factor de vulnerabilidad"@es .

:transportationMeansName a owl:DatatypeProperty ;
    rdfs:domain :TransportationMeans ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: bus, car, foot, boat, air, train, truck, mixed, unknown."@en ;
    rdfs:label "transportation means name"@en, "nombre del medio de transporte"@es .

:communicationToolName a owl:DatatypeProperty ;
    rdfs:domain :CommunicationTool ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: whatsapp, messenger, telegram, sms, voice_call, in_person, email, other."@en ;
    rdfs:label "communication tool name"@en, "nombre de la herramienta de comunicación"@es .

:documentationTypeName a owl:DatatypeProperty ;
    rdfs:domain :DocumentationType ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: national_id, passport, visa, work_permit, none, confiscated, false."@en ;
    rdfs:label "documentation type name"@en, "nombre del tipo de documentación"@es .

#################################################################
#    Datatype properties — Victim and demographics
#################################################################

:victimId a owl:DatatypeProperty ;
    rdfs:domain :Victim ; rdfs:range xsd:string ;
    rdfs:comment "Anonymised case identifier. For CTDC records, the CTDC victim id. For press cases, an outlet-specific hash."@en ;
    rdfs:label "victim id"@en, "identificador de víctima"@es .

:yearOfRegistration a owl:DatatypeProperty ;
    rdfs:domain :Victim ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:gYear. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:gYear literals."@en ;
    rdfs:label "year of registration"@en, "año de registro"@es ;
    rdfs:comment "Year in which the victim's case was registered by the source dataset. The year is the finest time granularity RATR-O records about a victim."@en .

:ageGroupName a owl:DatatypeProperty ;
    rdfs:domain :AgeGroup ; rdfs:range xsd:string ;
    rdfs:label "age group name"@en, "nombre del grupo etario"@es ;
    rdfs:comment "Name of the age band, for example '18-20' or '21-23'."@en .

:genderName a owl:DatatypeProperty ;
    rdfs:domain :Gender ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: female, male, non_binary, unknown."@en ;
    rdfs:label "gender name"@en, "nombre del género"@es .

#################################################################
#    Datatype properties — Evidence sources
#################################################################

:sourceTitle a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range xsd:string ;
    rdfs:label "source title"@en, "título de la fuente"@es ;
    rdfs:comment "Title of the evidence source."@en .

:sourceOutlet a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range xsd:string ;
    rdfs:label "source outlet"@en, "medio de la fuente"@es ;
    rdfs:comment "Outlet, publisher or institution that issued the evidence source."@en .

:sourceUrl a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range xsd:anyURI ;
    rdfs:label "source URL"@en, "URL de la fuente"@es ;
    rdfs:comment "URL of the evidence source."@en .

:sourceDate a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:date. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:date literals."@en ;
    rdfs:label "source date"@en, "fecha de la fuente"@es ;
    rdfs:comment "Publication date of the evidence source."@en .

:sourceAuthor a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range xsd:string ;
    rdfs:label "source author"@en, "autor de la fuente"@es ;
    rdfs:comment "Author of the evidence source, where the source names one."@en .

:sourceKind a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range xsd:string ;
    rdfs:label "source kind"@en, "tipo de fuente"@es ;
    rdfs:comment "The kind of evidence source as recorded at ingestion: press_article or press, ctdc, unodc, rnpdno, organisation_material, statistics_report."@en .

:datasetName a owl:DatatypeProperty ;
    rdfs:domain :OpenDatasetRecord ; rdfs:range xsd:string ;
    rdfs:comment "Name of the open dataset (e.g. CTDC, UNODC-GLOTIP, RNPDNO)."@en ;
    rdfs:label "dataset name"@en, "nombre del dataset"@es .

:datasetRecordId a owl:DatatypeProperty ;
    rdfs:domain :OpenDatasetRecord ; rdfs:range xsd:string ;
    rdfs:label "dataset record id"@en, "identificador de registro del dataset"@es ;
    rdfs:comment "Identifier of the record in the open dataset it came from, so that any figure can be traced back to the published dataset."@en .

#################################################################
#    Cross-references to the sources of the main concepts
#################################################################

:FraudScheme rdfs:seeAlso <https://ramonaaliadalaboral.com/> ,
                 <https://www.unodc.org/unodc/en/human-trafficking/faqs.html> ,
                 <https://www.ilo.org/publications/caught-sea-forced-labour-and-trafficking-fisheries> ,
                 <https://fifpro.org/en/supporting-players/safe-working-environments/human-trafficking/> .

:Victim rdfs:seeAlso <https://www.ctdatacollaborative.org/page/global-synthetic-dataset> .

:RedFlag rdfs:seeAlso <https://ramonaaliadalaboral.com/> .

:SurvivorTestimonyPattern skos:note "Five kinds of pattern have a subclass here (classic, credible, communication, recruitment, exploitation). The kind of any other pattern is read off :patternHasKind."@en .

:PalermoAction skos:note "Five canonical sub-concepts from Article 3(a) of the Palermo Protocol."@en ;
    rdfs:seeAlso <https://www.ohchr.org/en/instruments-mechanisms/instruments/protocol-prevent-suppress-and-punish-trafficking-persons> .
:PalermoMeans skos:note "Eight canonical sub-concepts from Article 3(a)."@en ;
    rdfs:seeAlso <https://www.ohchr.org/en/instruments-mechanisms/instruments/protocol-prevent-suppress-and-punish-trafficking-persons> .
:PalermoPurpose skos:note "Five canonical sub-concepts from Article 3(a)."@en ;
    rdfs:seeAlso <https://www.ohchr.org/en/instruments-mechanisms/instruments/protocol-prevent-suppress-and-punish-trafficking-persons> .

:TIPEvent skos:note "Central unit of classification in ICS-TIP (IOM+UNODC 2023). Aggregates one Victim, at least one PalermoAction, one PalermoMeans and one PalermoPurpose."@en ;
    rdfs:seeAlso <https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf> .




# Disjointness (OWL 2 QL permits super-class disjointness declarations)
:Employer owl:disjointWith :Recruiter .


#################################################################
#    Social-media criminal-recruitment module
#
#    Source: Arias Vasquez, A. (coord.), Pena Gonzalez, R. (dir.) and
#    Aguayo Quezada, S. (coord. gral.) (2025). "Del scroll al 'jale':
#    como se recluta en TikTok". Seminario sobre Violencia y Paz,
#    El Colegio de Mexico. Corpus: 100 TikTok videos collected
#    15 March to 31 August 2025, analysed with crisp-set QCA.
#
#    Modelling decision (OWL 2 QL boundary). The report defines three
#    recruitment stories as CONJUNCTIONS of four conditions, e.g.
#    EnrolInCrime = NR AND ECC. OWL 2 QL forbids conjunctions on the
#    left-hand side of a subclass axiom, so only the necessary direction
#    (story => each condition) is axiomatised here. The sufficient
#    direction (NR AND ECC => story) is computed in the mapping layer
#    (SQL WHERE clause in mappings/ramona.obda). See
#    docs/MODULE_SOCIAL_RECRUITMENT.md.
#################################################################

:ColmexScrollAlJale2025 a owl:NamedIndividual , :ResearchReport ;
    rdfs:label "Del scroll al 'jale': como se recluta en TikTok (El Colegio de Mexico, 2025)"@es ;
    :sourceTitle "Del scroll al 'jale': como se recluta en TikTok" ;
    :sourceOutlet "Seminario sobre Violencia y Paz, El Colegio de Mexico" ;
    :sourceAuthor "Arias Vasquez, A. (coord.); Pena Gonzalez, R. (dir.); Aguayo Quezada, S. (coord. gral.)" .

:ResearchReport a owl:Class ;
    rdfs:subClassOf :EvidenceSource ;
    rdfs:label "Research report"@en, "Informe de investigacion"@es ;
    rdfs:comment "A published academic or civil-society research report used as evidence for patterns, lexicon terms or schemes."@en .

# --- Items ----------------------------------------------------------

:SocialMediaItem a owl:Class ;
    rdfs:label "Social-media item"@en, "Contenido en red social"@es ;
    rdfs:comment "A unit of content observed on a social-media platform: a post (video, image, caption) or a comment under a post."@en .

:SocialMediaPost a owl:Class ;
    rdfs:subClassOf :SocialMediaItem ;
    rdfs:label "Social-media post"@en, "Publicación en red social"@es ;
    rdfs:comment "A video or image post with its overlay text, caption, hashtags and audio. Unit of analysis of the Colmex 2025 corpus."@en .

:SocialMediaComment a owl:Class ;
    rdfs:subClassOf :SocialMediaItem ;
    rdfs:label "Social-media comment"@en, "Comentario en red social"@es ;
    rdfs:comment "A comment published under a post. Colmex 2025 documents that recruitment interaction frequently happens in comments rather than in the post itself."@en .

:SocialMediaPost owl:disjointWith :SocialMediaComment .

:SelfApplicationComment a owl:Class ;
    rdfs:subClassOf :SocialMediaComment ;
    rdfs:label "Self-application comment"@en, "Comentario de autopostulacion"@es ;
    rdfs:comment "A comment in which a user asks to join or offers themself to a criminal group (e.g. 'busco jale', 'que se ocupa para entrar', 'puedo entrar con 16'). Colmex 2025, images 2, 4, 13-15, 20 and 22."@en .

:RecruiterReplyComment a owl:Class ;
    rdfs:subClassOf :SocialMediaComment ;
    rdfs:label "Recruiter reply comment"@en, "Respuesta del reclutador"@es ;
    rdfs:comment "A short reply by the post author or an associated account redirecting to a private channel or welcoming the applicant (e.g. 'manda mensaje', 'DM', 'bienvenido cuando quieras'). Colmex 2025, images 4, 13-14 and 18."@en .

# --- Colmex QCA conditions as classes of posts ------------------------

:DirectRecruitmentPost a owl:Class ;
    rdfs:subClassOf :SocialMediaPost , :JobOffer ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :exhibitsFraudScheme ; owl:someValuesFrom :ForcedCriminalityScheme ] ;
    rdfs:label "Direct recruitment post (NR)"@en, "Publicación con narrativa de reclutamiento directo (NR)"@es ;
    rdfs:comment "Condition NR of Colmex 2025: the post explicitly invites the audience to join a criminal group (e.g. 'Quieres jale? Todavia hay plazas', 'seguimos con el reclutamiento activo'). Such a post is a job offer, and every such offer exhibits some forced-criminality scheme (existential axiom, allowed on the right-hand side in OWL 2 QL)."@en .

:CriminalCultureExaltationPost a owl:Class ;
    rdfs:subClassOf :SocialMediaPost ;
    rdfs:label "Criminal-culture exaltation post (ECC)"@en, "Publicación con exaltación de la cultura criminal (ECC)"@es ;
    rdfs:comment "Condition ECC of Colmex 2025: the post uses at least one iconographic symbol of criminal identity (weapons, armoured 'monstruas', tactical vests, convoys, group emblems)."@en .

:CriminalLifeAspirationPost a owl:Class ;
    rdfs:subClassOf :SocialMediaPost ;
    rdfs:label "Criminal-life aspiration post (AVC)"@en, "Publicación con aspiración a la vida criminal (AVC)"@es ;
    rdfs:comment "Condition AVC of Colmex 2025: the post expresses the desire to join criminal life as a life project (e.g. 'Al unico circulo social que me interesa pertenecer (en proceso)', 'Disfruto mi vida quizas manana ya no este')."@en .

:AcousticFramingPost a owl:Class ;
    rdfs:subClassOf :SocialMediaPost ;
    rdfs:label "Acoustic framing post (A)"@en, "Publicación con acústica (A)"@es ;
    rdfs:comment "Condition A of Colmex 2025: background music or sound (corridos belicos, gunfire, radio chatter) that gives an emotional frame to criminal activity."@en .

# --- The three recruitment stories (necessary direction only) --------

:EnrolInCrimeStoryPost a owl:Class ;
    rdfs:subClassOf :DirectRecruitmentPost , :CriminalCultureExaltationPost ;
    rdfs:label "Story: enrol in crime (NR*ECC)"@en, "Relato: enrolarse en lo criminal (NR*ECC)"@es ;
    rdfs:comment "First recruitment story of Colmex 2025 (pp. 41-43). Sufficient condition NR AND ECC is not expressible in OWL 2 QL and is computed in the mapping."@en .

:EmotionalConnectionStoryPost a owl:Class ;
    rdfs:subClassOf :DirectRecruitmentPost , :AcousticFramingPost ;
    rdfs:label "Story: emotional connection (NR*A)"@en, "Relato: conexion emocional (NR*A)"@es ;
    rdfs:comment "Second recruitment story of Colmex 2025 (pp. 43-47). Sufficient condition NR AND A is computed in the mapping."@en .

:BelicoStoryPost a owl:Class ;
    rdfs:subClassOf :CriminalCultureExaltationPost , :AcousticFramingPost , :CriminalLifeAspirationPost ;
    rdfs:label "Story: belicos (ECC*A*AVC)"@en, "Relato: belicos (ECC*A*AVC)"@es ;
    rdfs:comment "Third recruitment story of Colmex 2025 (pp. 47-50). Persuades without an explicit offer (no NR). Sufficient condition ECC AND A AND AVC is computed in the mapping."@en .

# --- Signals ----------------------------------------------------------

:SocialMediaRecruitmentSignal a owl:Class ;
    rdfs:subClassOf :RedFlag ;
    rdfs:label "Social-media recruitment signal"@en, "Señal de reclutamiento en redes"@es ;
    rdfs:comment "A textual or symbolic cue in a social-media item associated with criminal recruitment. Derived from the lexicon in data/lexicon/tiktok_reclutamiento_lexicon.csv (Colmex 2025)."@en .

:GroupCodeSignal a owl:Class ; rdfs:subClassOf :SocialMediaRecruitmentSignal ;
    rdfs:label "Group code"@en, "Codigo de grupo"@es ;
    rdfs:comment "Coded reference to a criminal group ('4L', 'las 4 letras', NG emoji, 'la maña', 'la mz'). Colmex 2025, images 3, 4, 19, 22."@en .
:GroupEmojiSignal a owl:Class ; rdfs:subClassOf :SocialMediaRecruitmentSignal ;
    rdfs:label "Group emoji"@en, "Emoji de grupo"@es ;
    rdfs:comment "Emojis used as identity markers (devil, ninja, skull, salute, rooster). Colmex 2025, images 10, 17, 18, 19, 22."@en .
:PrivateChannelCallSignal a owl:Class ; rdfs:subClassOf :SocialMediaRecruitmentSignal ;
    rdfs:label "Call to private channel"@en, "Llamado al privado"@es ;
    rdfs:comment "Redirects the audience to a private message ('escribe al privado', 'manda DM'). Colmex 2025, images 10, 13, 14, 19, 21."@en .
:HighWeeklyPaySignal a owl:Class ; rdfs:subClassOf :SocialMediaRecruitmentSignal ;
    rdfs:label "High weekly pay"@en, "Pago semanal alto"@es ;
    rdfs:comment "Weekly pay promise far above the local labour market ('pagamos 10mil a 15mil pesos semanales'). Colmex 2025, image 3."@en .
:FamilyAppealSignal a owl:Class ; rdfs:subClassOf :SocialMediaRecruitmentSignal ;
    rdfs:label "Family appeal"@en, "Apela a la familia"@es ;
    rdfs:comment "Frames joining as sacrifice for the family ('que harias por tu mama', 'sacar a mi jefita adelante'). Colmex 2025, pp. 23 and 51."@en .
:MinorAgeMentionSignal a owl:Class ; rdfs:subClassOf :SocialMediaRecruitmentSignal ;
    rdfs:label "Minor age mention"@en, "Menciona edad de menor"@es ;
    rdfs:comment "The item mentions an age under 18 ('puedo entrar con 16'). Colmex 2025, image 22. Links the item to child recruitment."@en .
:WomenInvitationSignal a owl:Class ; rdfs:subClassOf :SocialMediaRecruitmentSignal ;
    rdfs:label "Invites women"@en, "Invita a mujeres"@es ;
    rdfs:comment "Explicitly invites or accepts women ('trabajo para hombres y mujeres', 'mujeres tambien entran'). Colmex 2025, images 4 and 19."@en .
:NationalReachSignal a owl:Class ; rdfs:subClassOf :SocialMediaRecruitmentSignal ;
    rdfs:label "National reach"@en, "Alcance nacional"@es ;
    rdfs:comment "Recruits from anywhere in the country ('todo Mexico'). Colmex 2025, image 10."@en .
:RecruitmentHashtagSignal a owl:Class ; rdfs:subClassOf :SocialMediaRecruitmentSignal ;
    rdfs:label "Recruitment hashtag"@en, "Hashtag de reclutamiento"@es ;
    rdfs:comment "Hashtag #reclutamiento, used by Colmex 2025 as an entry point to the corpus (p. 27)."@en .
:FatalismSignal a owl:Class ; rdfs:subClassOf :SocialMediaRecruitmentSignal ;
    rdfs:label "Fatalism"@en, "Fatalismo"@es ;
    rdfs:comment "Normalises early death or no exit ('quizas manana ya no este', 'de aqui ya no sales'). Colmex 2025, images 16 and 18."@en .

# --- Lexicon ----------------------------------------------------------

:LexiconTerm a owl:Class ;
    rdfs:label "Lexicon term"@en, "Término del léxico"@es ;
    rdfs:comment "A word, phrase, emoji or hashtag used in recruitment content, with a detection pattern and provenance. Instances are loaded from data/lexicon/tiktok_reclutamiento_lexicon.csv."@en .

# --- Object properties --------------------------------------------------

:itemPostedOn a owl:ObjectProperty ;
    rdfs:domain :SocialMediaItem ; rdfs:range :Platform ;
    rdfs:label "item posted on"@en, "publicado en"@es ;
    rdfs:comment "Relates a social-media item to the platform it was posted on."@en .

:commentsOn a owl:ObjectProperty ;
    rdfs:domain :SocialMediaComment ; rdfs:range :SocialMediaPost ;
    rdfs:label "comments on"@en, "comenta en"@es ;
    rdfs:comment "Relates a social-media comment to the post it replies to. Recruiter replies in comment threads are modelled because in the Colmex corpus the recruitment contact is frequently made there rather than in the post itself."@en .

:itemHasSignal a owl:ObjectProperty ;
    rdfs:domain :SocialMediaItem ; rdfs:range :SocialMediaRecruitmentSignal ;
    rdfs:label "item has signal"@en, "tiene señal"@es ;
    rdfs:comment "Relates a social-media item to a recruitment signal detected in it."@en .

:itemMatchesTerm a owl:ObjectProperty ;
    rdfs:domain :SocialMediaItem ; rdfs:range :LexiconTerm ;
    rdfs:label "item matches lexicon term"@en, "coincide con término"@es ;
    rdfs:comment "Relates a social-media item to a lexicon term it matches."@en .

:termDocumentedIn a owl:ObjectProperty ;
    rdfs:domain :LexiconTerm ; rdfs:range :EvidenceSource ;
    rdfs:label "term documented in"@en, "documentado en"@es ;
    rdfs:comment "Relates a lexicon term to the evidence source that documents it. Every term in the TikTok recruitment lexicon carries this link to the research report and page it was taken from."@en .

# --- Datatype properties ------------------------------------------------

:itemText a owl:DatatypeProperty ;
    rdfs:domain :SocialMediaItem ; rdfs:range xsd:string ;
    rdfs:label "item text"@en, "texto del contenido"@es ;
    rdfs:comment "Text of the social-media item, that is the caption of a post or the body of a comment."@en .
:itemPostedAt a owl:DatatypeProperty ;
    rdfs:domain :SocialMediaItem ; rdfs:range xsd:dateTime ;
    rdfs:label "item posted at"@en, "fecha de publicación"@es ;
    rdfs:comment "Timestamp at which the social-media item was posted."@en .
:itemIsSynthetic a owl:DatatypeProperty ;
    rdfs:domain :SocialMediaItem ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:boolean. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:boolean literals."@en ;
    rdfs:label "item is synthetic"@en, "es sintético"@es ;
    rdfs:comment "Whether the item is synthetic. Every synthetic item in the demonstrator carries this property set to true, so that no figure can be computed over real and generated items without distinguishing them."@en .
:itemHashtags a owl:DatatypeProperty ;
    rdfs:domain :SocialMediaItem ; rdfs:range xsd:string ;
    rdfs:label "item hashtags"@en, "hashtags"@es ;
    rdfs:comment "Hashtags carried by the item, as a space-separated list."@en .
:audioDescription a owl:DatatypeProperty ;
    rdfs:domain :SocialMediaPost ; rdfs:range xsd:string ;
    rdfs:label "audio description"@en, "descripción del audio"@es ;
    rdfs:comment "Description of the audio track of the post, including the song used. The audio is recorded because in the Colmex corpus the belico soundtrack is part of what makes the post legible as a recruitment post."@en .
:visualDescription a owl:DatatypeProperty ;
    rdfs:domain :SocialMediaPost ; rdfs:range xsd:string ;
    rdfs:label "visual description"@en, "descripción visual"@es ;
    rdfs:comment "Description of what the post shows."@en .
:promisedWeeklyPayMXN a owl:DatatypeProperty ;
    rdfs:domain :SocialMediaPost ; rdfs:range xsd:decimal ;
    rdfs:label "promised weekly pay (MXN)"@en, "pago semanal prometido (MXN)"@es ;
    rdfs:comment "Weekly pay promised in the post, in Mexican pesos."@en .
:lexiconTermText a owl:DatatypeProperty ;
    rdfs:domain :LexiconTerm ; rdfs:range xsd:string ;
    rdfs:label "term text"@en, "texto del término"@es ;
    rdfs:comment "The lexicon term as written in the source."@en .
:lexiconPattern a owl:DatatypeProperty ;
    rdfs:domain :LexiconTerm ; rdfs:range xsd:string ;
    rdfs:label "detection pattern (regex)"@en, "patrón de detección (regex)"@es ;
    rdfs:comment "Regular expression used to detect the lexicon term in item text."@en .
:lexiconCategory a owl:DatatypeProperty ;
    rdfs:domain :LexiconTerm ; rdfs:range xsd:string ;
    rdfs:label "lexicon category"@en, "categoría del léxico"@es ;
    rdfs:comment "Category the lexicon term belongs to, for example the role offered, the pay or the weapon."@en .
:lexiconIsVerbatim a owl:DatatypeProperty ;
    rdfs:domain :LexiconTerm ; rdfs:range rdfs:Literal ;
    skos:note "Intended datatype xsd:boolean. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:boolean literals."@en ;
    rdfs:label "verbatim from source"@en, "textual de la fuente"@es ;
    rdfs:comment "true if the term appears literally in the source report; false if it is a project variant (spelling, generic hashtag)."@en .
:lexiconSourceLocation a owl:DatatypeProperty ;
    rdfs:domain :LexiconTerm ; rdfs:range xsd:string ;
    rdfs:label "location in source"@en, "ubicación en la fuente"@es ;
    rdfs:comment "Page and image number in the source report."@en .


#################################################################
#    Offers documented in the press: Type A / Type B flags, criminal
#    recruitment offers, provenance of each offer
#################################################################

:ClassicRedFlag a owl:Class ;
    rdfs:subClassOf :RedFlag ;
    rdfs:label "Classic red flag (Type A)"@en, "Bandera roja clasica (Tipo A)"@es ;
    rdfs:comment "One of the classic warning signs of Ramona's public infographic: high salary, no experience needed, urgent hiring, advance payment, paid travel, flexible hours, job in another state. The value is in :flagType."@en .

:CredibleLethalRedFlag a owl:Class ;
    rdfs:subClassOf :RedFlag ;
    rdfs:label "Credible-lethal red flag (Type B)"@en, "Bandera roja creible-letal (Tipo B)"@es ;
    rdfs:comment "A logistic signal inside an otherwise plausible offer: nameless company, WhatsApp without logo, meeting in a multi-use building, asked to come alone or without ID, Messenger-to-WhatsApp funnel, atypical hours, personal-data harvesting, plausible bait role, last-minute relocation. The value is in :flagType."@en .

:ClassicRedFlag owl:disjointWith :CredibleLethalRedFlag .

:CriminalRecruitmentOffer a owl:Class ;
    rdfs:subClassOf :JobOffer ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :exhibitsFraudScheme ; owl:someValuesFrom :ForcedCriminalityScheme ] ;
    rdfs:label "Criminal recruitment offer"@en, "Oferta de reclutamiento criminal"@es ;
    rdfs:comment "A job offer whose purpose is to recruit into organised-crime activity (lookout, hitman, armed 'security', drug logistics), whatever the channel."@en .

:DirectRecruitmentPost rdfs:subClassOf :CriminalRecruitmentOffer .

:offerDocumentedIn a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasEvidenceSource ;
    rdfs:domain :JobOffer ; rdfs:range :EvidenceSource ;
    rdfs:label "offer documented in"@en, "oferta documentada en"@es ;
    rdfs:comment "Provenance: the evidence source (press article, report) that describes this offer."@en .

:offerSummary a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string ;
    rdfs:label "offer summary"@en, "resumen de la oferta"@es ;
    rdfs:comment "One-sentence Spanish paraphrase of the offer as described by the source."@en .
:offerVerbatimQuote a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string ;
    rdfs:label "verbatim quote of the offer"@en, "cita textual de la oferta"@es ;
    rdfs:comment "Exact text of the advertisement or recruiter message as quoted by the source, verified as a literal substring."@en .
:offerTargetProfile a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string ;
    rdfs:label "target profile"@en, "perfil buscado"@es ;
    rdfs:comment "Profile the offer asks for, in the words of the offer, for example that the candidate come alone or be a young woman."@en .
:offerOutcome a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string ;
    rdfs:label "reported outcome"@en, "desenlace reportado"@es ;
    rdfs:comment "Controlled vocabulary: rescate, desaparicion, explotacion_sexual, explotacion_laboral, fraude_economico, homicidio, detencion_reclutador, other."@en .
:offerPayAmount a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:decimal ;
    rdfs:label "offered pay amount"@en, "monto ofrecido"@es ;
    rdfs:comment "Pay amount stated in the offer."@en .
:offerPayCurrency a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string ;
    rdfs:label "offered pay currency"@en, "moneda ofrecida"@es ;
    rdfs:comment "ISO 4217 code of the currency the pay is stated in."@en .
:offerPayPeriod a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string ;
    rdfs:label "offered pay period"@en, "periodo de pago"@es ;
    rdfs:comment "Period the stated pay refers to, for example weekly, fortnightly or monthly."@en .
:extractionConfidence a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string ;
    rdfs:label "extraction confidence"@en, "confianza de extracción"@es ;
    rdfs:comment "high, medium or low: how clearly the source describes this specific offer."@en .
