@prefix :      <https://ramona.ai/ont#> .
@prefix ont:   <https://ramona.ai/ont#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dc:    <http://purl.org/dc/elements/1.1/> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix hutro: <https://bioportal.bioontology.org/ontologies/HUTRO> .

#################################################################
#    Ontology metadata
#################################################################

<https://ramona.ai/ont> a owl:Ontology ;
    dc:title "Ramona Anti-Trafficking and Recruitment-fraud Ontology (RATR-O)"@en ;
    dc:title "Ontología Ramona contra el Reclutamiento Fraudulento y la Trata (RATR-O)"@es ;
    dc:creator "Daniela Camberos, Ramona AI" ;
    dct:contributor "Magdalena Ortiz, TU Wien (proposed co-author, v1.0 onward)" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "1.4" ;
    dct:issued "2026-04-21"^^xsd:date ;
    rdfs:comment "A domain ontology in OWL 2 QL (DL-Lite) for the detection of fraudulent job offers, labour-recruitment fraud, and human-trafficking recruitment patterns in Latin America. RATR-O models the full continuum of recruitment-based harm: from offers that defraud candidates (identity theft, financial scams, unpaid work) through offers that lead to labour exploitation, through to offers whose purpose is trafficking into forced labour, sexual exploitation, or forced criminality. A single JobOffer can exhibit indicators of any combination of these three outcomes, and RATR-O expresses them as distinct but compatible risk axes. The ontology is designed to operate as the conceptual layer of a Virtual Knowledge Graph over Ramona AI operational data and over open anti-trafficking datasets (CTDC, UNODC), following Xiao, Ding, Cogrel and Calvanese (2019). v1.0 aligns the generalisable fragment of HUTRO (Human Trafficking Ontology, BioPortal, 2025) with Ramona's domain-specific taxonomy of online recruitment fraud in Mexico and Latin America."@en ;
    rdfs:seeAlso <https://bioportal.bioontology.org/ontologies/HUTRO> .

#################################################################
#    Core Classes — Agents, offers, submissions
#################################################################

:Agent a owl:Class ;
    rdfs:label "Agent"@en, "Agente"@es ;
    rdfs:comment "An actor who can post or be associated with a job offer."@en .

:Recruiter a owl:Class ;
    rdfs:subClassOf :Agent ;
    rdfs:label "Recruiter"@en, "Reclutador"@es .

:Employer a owl:Class ;
    rdfs:subClassOf :Agent ;
    rdfs:label "Employer"@en, "Empleador"@es .

:JobOffer a owl:Class ;
    rdfs:label "Job offer"@en, "Oferta laboral"@es ;
    rdfs:comment "A posting advertising employment, submitted to Ramona or harvested from public channels."@en .

:Platform a owl:Class ;
    rdfs:label "Platform"@en, "Plataforma"@es .

:OnlineRecruitmentChannel a owl:Class ;
    rdfs:subClassOf :Platform ;
    rdfs:label "Online recruitment channel"@en, "Canal de reclutamiento en línea"@es ;
    rdfs:comment "A digital communication channel used by recruiters to contact candidates. Controlled vocabulary covers Messenger, WhatsApp, Telegram, Marketplace, TikTok, SMS, classifieds and other."@en .

:Candidate a owl:Class ;
    rdfs:label "Candidate"@en, "Candidato"@es ;
    rdfs:comment "User who submitted an offer to Ramona for verification."@en .

:Submission a owl:Class ;
    rdfs:label "Submission"@en, "Solicitud"@es ;
    rdfs:comment "An act by a Candidate of submitting an offer for Ramona verification."@en .

#################################################################
#    Risk and detection classes
#################################################################

:RedFlag a owl:Class ;
    rdfs:label "Red flag"@en, "Bandera roja"@es ;
    rdfs:comment "A detected indicator of potential fraud or trafficking recruitment risk. Seven canonical flags are defined by Ramona AI."@en .

:RiskClassification a owl:Class ;
    rdfs:label "Risk classification"@en, "Clasificación de riesgo"@es ;
    rdfs:comment "An assessment of an offer along Ramona's risk axes. See :fraudAxis, :exploitationAxis and :traffickingAxis for the three independent dimensions covered."@en .

:FraudRisk a owl:Class ;
    rdfs:subClassOf :RiskClassification ;
    rdfs:label "Labour fraud risk"@en, "Riesgo de fraude laboral"@es ;
    rdfs:comment "Risk that the offer is a fraud designed to extract money, data or unpaid work from the candidate, without necessarily leading to trafficking or exploitation."@en .

:ExploitationRisk a owl:Class ;
    rdfs:subClassOf :RiskClassification ;
    rdfs:label "Labour exploitation risk"@en, "Riesgo de explotación laboral"@es ;
    rdfs:comment "Risk that the offer leads to substandard working conditions, wage theft, excessive hours or other exploitation that does not rise to the legal definition of trafficking."@en .

:TraffickingRisk a owl:Class ;
    rdfs:subClassOf :RiskClassification ;
    rdfs:label "Trafficking recruitment risk"@en, "Riesgo de reclutamiento para trata"@es ;
    rdfs:comment "Risk that the offer is recruitment for trafficking in persons in the sense of the Palermo Protocol: for forced labour, sexual exploitation, forced criminality, forced marriage or organ removal."@en .

#################################################################
#    FraudScheme taxonomy (v1.1)
#    Named schemes documented from Ramona AI field work and survivor testimony
#    in Mexico and Latin America. Each scheme is a specific way a fraudulent
#    job offer is operationalised against candidates in the region.
#################################################################

:FraudScheme a owl:Class ;
    rdfs:label "Fraud scheme"@en, "Esquema de fraude"@es ;
    rdfs:comment "A named operational pattern by which a fraudulent job offer harms the candidate. Independent of the RiskClassification axes: a single offer can exhibit one or more named schemes."@en .

:IdentityTheftScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Identity theft scheme"@en, "Esquema de robo de identidad"@es ;
    rdfs:comment "The offer's purpose is to harvest the candidate's personal data (CURP, INE, bank details) to commit downstream fraud against the candidate or third parties. Hiring is never actually intended."@en .

:PyramidScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Pyramid / MLM scheme"@en, "Esquema piramidal / multinivel"@es ;
    rdfs:comment "The candidate's actual income depends on recruiting further candidates, not on the advertised job. Covers classic pyramid schemes and multi-level-marketing operations disguised as employment."@en .

:PayToWorkScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Pay-to-work scheme"@en, "Esquema de pago por trabajar"@es ;
    rdfs:comment "The candidate is asked to pay the recruiter or a third party before being hired, under the guise of onboarding fees, training, interview fees, uniform costs, administrative processing, background check, or starter kit. Often the candidate is never contacted again."@en .

:VisaFraudScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Migration / visa fraud scheme"@en, "Esquema de fraude migratorio"@es ;
    rdfs:comment "The offer promises employment in a foreign country (commonly Canada, the United States or Western Europe for Latin American victims) and demands payment for visa, gestor or recruiter services. The intermediary disappears after collecting payment. Commonly marketed as domestic work, caregiving, nanny placement or hospitality abroad."@en .

:InPersonLureScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "In-person lure scheme"@en, "Esquema de citación presencial"@es ;
    rdfs:comment "The offer exists solely to bring the candidate to a physical location under the appearance of a hiring event or interview. The real purpose is kidnapping, assault, sexual violence or femicide. Characterised by plausible role, nameless company, multi-use building address, request to come alone and without identification. Documented archetypal case: Edith Guadalupe Valdez Saldívar, Benito Juárez CDMX, April 2026."@en .

:DebtBondageTraffickingScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Debt bondage trafficking scheme"@en, "Esquema de trata con deuda"@es ;
    rdfs:comment "The offer relocates the candidate to a destination where exploitation is performed, often across borders, and binds the victim through a manufactured debt: smuggling fees, transportation, housing, paperwork. Covers the Tapachula-to-United States labour-exploitation corridor, the Latin-America-to-Western-Europe sex-trafficking pattern (e.g. falsely advertised childcare jobs in Paris), and domestic-work trafficking with document retention."@en .

:DomesticWorkerLockInScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Domestic worker lock-in scheme"@en, "Esquema de encierro en trabajo doméstico"@es ;
    rdfs:comment "The candidate is hired as a live-in domestic worker, caregiver or nanny and then isolated inside the employer's household: documents withheld, phone confiscated or rationed, days-off refused, movement outside the home forbidden. Wages are withheld or paid to a family member. Common end-state of VisaFraudScheme placements abroad and of internal placements from rural to urban Mexico."@en .

:OnlineCryptoJobScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Crypto / forex job scheme"@en, "Esquema de empleo cripto / forex"@es ;
    rdfs:comment "Advertised as 'crypto trader', 'forex analyst', 'Web3 community manager' or 'blockchain assistant' with high salary, full remote and no experience required. Often used as cover for pay-to-work (candidate buys a 'training course' or deposits 'starting capital'), identity theft (KYC data collected for money-laundering accounts), or cross-border trafficking into Southeast Asian crypto-scam compounds."@en .

:ModelingAgencyScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Modelling agency scheme"@en, "Esquema de agencia de modelaje"@es ;
    rdfs:comment "A supposed modelling, acting, influencer or image agency recruits young women, occasionally men, with the promise of bookings abroad. The first 'casting' is used to produce compromising photographs and to extract personal data. Subsequent 'shoots' lead to sexual exploitation, pornographic production without consent or forced escort work. Documented end-state of recruitment on Facebook Marketplace and Instagram DMs in Mexico and Colombia."@en .

:CallCenterScamScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Call-centre scam employment scheme"@en, "Esquema de empleo en call center estafador"@es ;
    rdfs:comment "The candidate is hired as a legitimate customer-service, collections or sales agent in a call centre that is in fact a fraud operation (time-share extortion, fake investment, virtual kidnapping, romance scams). The worker realises they are defrauding clients and attempts to leave, at which point threats, wage withholding or confiscated documents prevent them from doing so. Documented in Mexico, Costa Rica and the Philippines."@en .

:FakeMaquilaScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Fake maquila scheme"@en, "Esquema de maquila fantasma"@es ;
    rdfs:comment "Offer of employment at an export-processing factory in the Mexican north border or in border free-trade zones. The maquila is either non-existent (workers arrive to find no facility), a cover for forced labour in a related industry (for example drug packaging, human-trafficking logistics), or a real facility operating under abusive conditions below the legal minimum. Candidates commonly relocate from southern Mexico and Central America."@en .

:MLMHealthBeautyScheme a owl:Class ;
    rdfs:subClassOf :PyramidScheme ;
    rdfs:label "Health / beauty MLM scheme"@en, "Esquema multinivel de salud y belleza"@es ;
    rdfs:comment "A multi-level marketing operation centred on nutritional supplements, cosmetics, slimming products or wellness programmes. Presented as an employment or business opportunity, in practice the participant earns only by recruiting further 'distributors' and by purchasing inventory that cannot be sold on the open market. Canonical examples in Latin America include product lines marketed through Facebook groups and WhatsApp chains."@en .

:GigEconomyFakeDriverScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Gig-economy fake driver scheme"@en, "Esquema de conductor gig fraudulento"@es ;
    rdfs:comment "The candidate is offered work as a ride-hailing or delivery driver for a platform (Uber, DiDi, Cabify, Beat, Rappi, DiDi Food). The recruiter provides a 'rented' vehicle on terms that include daily rent, insurance fees and maintenance charges. The arithmetic guarantees the driver ends each week in deficit, binding them through accumulating debt. The vehicle is often stolen or fraudulently registered and is used to extract labour under the threat of criminal complaint."@en .

:ForcedCriminalityScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Forced criminality scheme"@en, "Esquema de reclutamiento para criminalidad forzada"@es ;
    rdfs:comment "Offer advertised as 'private security', 'bodyguard', 'armed escort', 'watchman at a ranch' or 'warehouse security' with atypically high salary. The real purpose is enlistment into organised-crime armed structures, most notably as halcones, sicarios, or coca-processing labour. Archetypal Mexican case: the CJNG Rancho Izaguirre (Teuchitlán, Jalisco) recruiting scheme of 2024-2025."@en .

:OnlineInfluencerSalesScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Influencer sales scheme"@en, "Esquema de ventas como influencer"@es ;
    rdfs:comment "The candidate is offered a paid role as 'brand ambassador', 'community manager trainee' or 'social media sales associate'. The role requires the candidate to set up their own social accounts, purchase the product catalogue, and 'earn' from commission and from recruiting further ambassadors. In effect a pyramid or MLM structure presented as a creator-economy job. Commonly used by cosmetic, fashion and digital-education brands."@en .

:ForeignLanguageTeacherScheme a owl:Class ;
    rdfs:subClassOf :FraudScheme ;
    rdfs:label "Foreign-language teacher scheme"@en, "Esquema de maestro de idiomas en el extranjero"@es ;
    rdfs:comment "The candidate is offered a teaching position abroad (typically Spanish in Asia or English in Latin America) with housing, visa and flight paid by the agency. On arrival the promised contract does not exist: the candidate is placed in a different role, forced to pay back 'travel expenses', has documents retained, or finds the school is a front for sex tourism or forced domestic work. Documented corridors include Mexico-China, Mexico-Korea, and Peru-Japan."@en .

# Candidate and victim link to Scheme (extended range)

:candidateDefraudedBy a owl:ObjectProperty ;
    rdfs:domain :Candidate ; rdfs:range :FraudScheme ;
    rdfs:label "candidate defrauded by scheme"@en .

#################################################################
#    v1.3 — Observatory measurement layer
#    Properties and subclasses that enable empirical statements on top
#    of the ontology (counts, frequency buckets, earliest year, etc.)
#################################################################

:ClassicRedFlagPattern a owl:Class ;
    rdfs:subClassOf :SurvivorTestimonyPattern ;
    rdfs:label "Classic red-flag pattern"@en, "Patrón de bandera roja clásica"@es ;
    rdfs:comment "A survivor-testimony pattern drawn from Ramona's 7-flag canonical taxonomy (high salary, flexible hours, no experience, upfront pay, urgent acceptance, distant interview, out-of-state job)."@en .

:CredibleLethalPattern a owl:Class ;
    rdfs:subClassOf :SurvivorTestimonyPattern ;
    rdfs:label "Credible-lethal pattern"@en, "Patrón creíble-letal"@es ;
    rdfs:comment "A survivor-testimony pattern where the offer itself looks plausible and the risk sits in the logistics of the first contact (nameless WhatsApp, multi-use building, 'come alone', 'no ID', Messenger-to-WhatsApp funnel, personal-data filter). Type B in Ramona's dual-track classification."@en .

:CommunicationPattern a owl:Class ;
    rdfs:subClassOf :SurvivorTestimonyPattern ;
    rdfs:label "Communication pattern"@en, "Patrón de comunicación"@es ;
    rdfs:comment "A pattern describing which communication tool was used for the first or dominant contact (WhatsApp, Messenger, Telegram, SMS, in-person, etc.)."@en .

:RecruitmentPattern a owl:Class ;
    rdfs:subClassOf :SurvivorTestimonyPattern ;
    rdfs:label "Recruitment pattern"@en, "Patrón de reclutamiento"@es ;
    rdfs:comment "A pattern describing how the recruiter established contact with the candidate (social media, family, friend, intimate partner, abduction, classifieds, street)."@en .

:ExploitationPattern a owl:Class ;
    rdfs:subClassOf :SurvivorTestimonyPattern ;
    rdfs:label "Exploitation pattern"@en, "Patrón de explotación"@es ;
    rdfs:comment "A pattern describing the final exploitation outcome attested or suggested in the evidence source (labour hospitality, sexual, forced criminality, organ removal)."@en .

:DominanceBucket a owl:Class ;
    rdfs:label "Dominance bucket"@en, "Rango de dominancia"@es ;
    rdfs:comment "A qualitative frequency bucket used to describe how often a pattern is observed in the observatory corpus. Values: hot (>= 5 percent of cases), warm (1 to 5 percent), cold (< 1 percent)."@en .

# Datatype properties for observatory measurement

:observedCount a owl:DatatypeProperty ;
    rdfs:domain :SurvivorTestimonyPattern ; rdfs:range xsd:integer ;
    rdfs:label "observed count"@en, "frecuencia observada"@es ;
    rdfs:comment "Number of case-relevant evidence sources in which the pattern was detected."@en .

:pctOfCases a owl:DatatypeProperty ;
    rdfs:domain :SurvivorTestimonyPattern ; rdfs:range xsd:decimal ;
    rdfs:label "percentage of cases"@en, "porcentaje de casos"@es .

:dominanceBucketValue a owl:DatatypeProperty ;
    rdfs:domain :SurvivorTestimonyPattern ; rdfs:range xsd:string ;
    rdfs:label "dominance bucket value"@en, "valor de rango de dominancia"@es ;
    rdfs:comment "hot, warm, or cold."@en .

:routeVictimCount a owl:DatatypeProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range xsd:integer ;
    rdfs:label "route victim count"@en, "número de víctimas en la ruta"@es ;
    rdfs:comment "Number of CTDC-registered victims attested on this (origin, destination) pair."@en .

:routeEarliestYear a owl:DatatypeProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range xsd:gYear ;
    rdfs:label "route earliest year"@en, "año más temprano de la ruta"@es .

:routeLatestYear a owl:DatatypeProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range xsd:gYear ;
    rdfs:label "route latest year"@en, "año más reciente de la ruta"@es .

:routeDominantExploitation a owl:ObjectProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range :TypeOfExploitation ;
    rdfs:label "route dominant exploitation"@en, "explotación dominante de la ruta"@es ;
    rdfs:comment "The single exploitation type attested for the majority of victims on this route."@en .

#################################################################
#    v1.4 — Palermo Protocol Article 3 alignment
#    Verbatim definitions from UN Protocol to Prevent, Suppress
#    and Punish Trafficking in Persons (2000), Article 3(a).
#################################################################

:TIPEvent a owl:Class ;
    rdfs:label "TIP event"@en, "Evento de trata de personas"@es ;
    rdfs:comment "A trafficking-in-persons event as defined by the International Classification Standard for Administrative Data on Trafficking in Persons (ICS-TIP, IOM and UNODC, 2023). The TIP event is the central unit of classification in ICS-TIP. In RATR-O a TIPEvent aggregates one victim with at least one Palermo Action, at least one Palermo Means, and at least one Palermo Purpose."@en ;
    rdfs:seeAlso <https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf> .

:PalermoAction a owl:Class ;
    rdfs:label "Palermo Action"@en, "Acción (Palermo)"@es ;
    rdfs:comment "The ACT element of the Palermo Protocol Article 3(a) definition of trafficking in persons: 'the recruitment, transportation, transfer, harbouring or receipt of persons'."@en ;
    rdfs:seeAlso <https://www.ohchr.org/en/instruments-mechanisms/instruments/protocol-prevent-suppress-and-punish-trafficking-persons> .

:Recruitment a owl:Class ;
    rdfs:subClassOf :PalermoAction ;
    rdfs:label "Recruitment (act)"@en, "Reclutamiento (acción)"@es .
:Transportation a owl:Class ;
    rdfs:subClassOf :PalermoAction ;
    rdfs:label "Transportation (act)"@en, "Transporte (acción)"@es .
:Transfer a owl:Class ;
    rdfs:subClassOf :PalermoAction ;
    rdfs:label "Transfer (act)"@en, "Traslado (acción)"@es .
:Harbouring a owl:Class ;
    rdfs:subClassOf :PalermoAction ;
    rdfs:label "Harbouring (act)"@en, "Acogida (acción)"@es .
:Receipt a owl:Class ;
    rdfs:subClassOf :PalermoAction ;
    rdfs:label "Receipt of persons (act)"@en, "Recepción de personas (acción)"@es .

:PalermoMeans a owl:Class ;
    rdfs:label "Palermo Means"@en, "Medio (Palermo)"@es ;
    rdfs:comment "The MEANS element of the Palermo Protocol Article 3(a) definition: 'the threat or use of force or other forms of coercion, of abduction, of fraud, of deception, of the abuse of power or of a position of vulnerability or of the giving or receiving of payments or benefits to achieve the consent of a person having control over another person'."@en .

:MeansThreatOfForce a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Threat or use of force"@en, "Amenaza o uso de la fuerza"@es .
:MeansCoercion a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Coercion"@en, "Coacción"@es .
:MeansAbduction a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Abduction"@en, "Rapto"@es .
:MeansFraud a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Fraud"@en, "Fraude"@es .
:MeansDeception a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Deception"@en, "Engaño"@es .
:MeansAbuseOfPower a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Abuse of power"@en, "Abuso de poder"@es .
:MeansAbuseOfVulnerability a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Abuse of a position of vulnerability"@en, "Abuso de una posición de vulnerabilidad"@es .
:MeansPaymentOrBenefit a owl:Class ;
    rdfs:subClassOf :PalermoMeans ;
    rdfs:label "Giving or receiving of payments or benefits to obtain consent"@en,
               "Dar o recibir pagos o beneficios para obtener consentimiento"@es .

:PalermoPurpose a owl:Class ;
    rdfs:label "Palermo Purpose"@en, "Finalidad (Palermo)"@es ;
    rdfs:comment "The PURPOSE element of the Palermo Protocol Article 3(a): 'for the purpose of exploitation', which the Protocol exemplifies as 'the exploitation of the prostitution of others or other forms of sexual exploitation, forced labour or services, slavery or practices similar to slavery, servitude or the removal of organs'."@en .

:PurposeSexualExploitation a owl:Class ;
    rdfs:subClassOf :PalermoPurpose ;
    rdfs:label "Sexual exploitation"@en, "Explotación sexual"@es .
:PurposeForcedLabour a owl:Class ;
    rdfs:subClassOf :PalermoPurpose ;
    rdfs:label "Forced labour or services"@en, "Trabajo o servicios forzados"@es .
:PurposeSlavery a owl:Class ;
    rdfs:subClassOf :PalermoPurpose ;
    rdfs:label "Slavery or practices similar to slavery"@en, "Esclavitud o prácticas análogas"@es .
:PurposeServitude a owl:Class ;
    rdfs:subClassOf :PalermoPurpose ;
    rdfs:label "Servitude"@en, "Servidumbre"@es .
:PurposeOrganRemoval a owl:Class ;
    rdfs:subClassOf :PalermoPurpose ;
    rdfs:label "Removal of organs"@en, "Extracción de órganos"@es .

# Link RATR-O JobOffer / Victim / FraudScheme to the Palermo triad.

:exhibitsAction a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :PalermoAction ;
    rdfs:label "exhibits Palermo action"@en .
:exhibitsMeans a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :PalermoMeans ;
    rdfs:label "exhibits Palermo means"@en .
:exhibitsPurpose a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :PalermoPurpose ;
    rdfs:label "exhibits Palermo purpose"@en .

:tipEventInvolves a owl:ObjectProperty ;
    rdfs:domain :TIPEvent ; rdfs:range :Victim ;
    rdfs:label "TIP event involves victim"@en .
:tipEventHasAction a owl:ObjectProperty ;
    rdfs:domain :TIPEvent ; rdfs:range :PalermoAction ;
    rdfs:label "TIP event has action"@en .
:tipEventHasMeans a owl:ObjectProperty ;
    rdfs:domain :TIPEvent ; rdfs:range :PalermoMeans ;
    rdfs:label "TIP event has means"@en .
:tipEventHasPurpose a owl:ObjectProperty ;
    rdfs:domain :TIPEvent ; rdfs:range :PalermoPurpose ;
    rdfs:label "TIP event has purpose"@en .

# Close-match alignment to ICS-TIP variables (provisional; verbatim list
# pending the ICS-TIP v4 PDF cross-check).

:RecruitmentMethod rdfs:seeAlso <https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf> .
:TypeOfExploitation rdfs:seeAlso <https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf> .
:VulnerabilityFactor rdfs:seeAlso <https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf> .
:TraffickingRoute rdfs:seeAlso <https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf> .

# UNODC Global Report on Trafficking in Persons (GLOTIP) alignment as
# persistent reference (the report's country-year tables are ingested as
# OpenDatasetRecord instances via the ingest pipeline when available).

:Victim rdfs:seeAlso <https://www.unodc.org/unodc/data-and-analysis/glotip.html> .


# Link properties: an offer or a victim can exhibit one or more FraudSchemes.

:exhibitsFraudScheme a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :FraudScheme ;
    rdfs:label "exhibits fraud scheme"@en, "presenta esquema de fraude"@es .

:victimOfFraudScheme a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :FraudScheme ;
    rdfs:label "victim of fraud scheme"@en, "víctima de esquema de fraude"@es .


:SurvivorTestimonyPattern a owl:Class ;
    rdfs:label "Survivor testimony pattern"@en, "Patrón de testimonio de sobreviviente"@es ;
    rdfs:comment "A recurring linguistic or logistical pattern extracted from survivor interviews or documented cases."@en .

#################################################################
#    Classes aligned to HUTRO (generalisable fragment)
#################################################################

:RecruitmentMethod a owl:Class ;
    rdfs:label "Recruitment method"@en, "Método de reclutamiento"@es ;
    rdfs:comment "The mechanism by which a potential victim is initially approached and enlisted into a trafficking or fraudulent-employment scheme."@en ;
    skos:closeMatch <https://bioportal.bioontology.org/ontologies/HUTROrecruitment_method> .

:TypeOfExploitation a owl:Class ;
    rdfs:label "Type of exploitation"@en, "Tipo de explotación"@es ;
    rdfs:comment "The exploitation outcome associated with a trafficking case. Controlled vocabulary covers labour, sexual, forced criminality, forced marriage, organ removal, mixed."@en ;
    skos:closeMatch <https://bioportal.bioontology.org/ontologies/HUTROtype_of_exploitation> .

:VulnerabilityFactor a owl:Class ;
    rdfs:label "Vulnerability factor"@en, "Factor de vulnerabilidad"@es ;
    rdfs:comment "A socioeconomic, demographic or situational factor that increases the probability of a candidate accepting a high-risk offer."@en ;
    skos:closeMatch <https://bioportal.bioontology.org/ontologies/HUTROvulnerability_factor> .

:TransportationMeans a owl:Class ;
    rdfs:label "Transportation means"@en, "Medio de transporte"@es ;
    rdfs:comment "The means of transport used at a stage of the trafficking route."@en ;
    skos:closeMatch <https://bioportal.bioontology.org/ontologies/HUTROtransportation_means> .

:CommunicationTool a owl:Class ;
    rdfs:label "Communication tool"@en, "Herramienta de comunicación"@es ;
    rdfs:comment "A tool used for communication between recruiters, smugglers, traffickers or victims. Distinct from Platform because it describes the tool itself, not the platform it runs on."@en ;
    skos:closeMatch <https://bioportal.bioontology.org/ontologies/HUTROsmuggler_and_trafficker_communication_tools> .

:DocumentationType a owl:Class ;
    rdfs:label "Documentation type"@en, "Tipo de documentación"@es ;
    rdfs:comment "An identity or travel document demanded or withheld during recruitment. Includes the case of falsified documents."@en ;
    skos:closeMatch <https://bioportal.bioontology.org/ontologies/HUTROdocumentation_type> .

:FalseDocumentation a owl:Class ;
    rdfs:subClassOf :DocumentationType ;
    rdfs:label "False documentation"@en, "Documentación falsa"@es ;
    skos:closeMatch <https://bioportal.bioontology.org/ontologies/HUTROfalse_documentation> .

#################################################################
#    Victim and demographic classes (new in v1.0)
#################################################################

:Victim a owl:Class ;
    rdfs:label "Victim"@en, "Víctima"@es ;
    rdfs:comment "A person documented as having been exploited or attempted-to-be-exploited in a trafficking or fraudulent-employment scheme. Sourced from anonymised CTDC records and publicly reported press cases."@en .

:DemographicProfile a owl:Class ;
    rdfs:label "Demographic profile"@en, "Perfil demográfico"@es ;
    rdfs:comment "An anonymised demographic description of a victim or candidate, covering age group, gender, nationality and education."@en .

:AgeGroup a owl:Class ;
    rdfs:label "Age group"@en, "Grupo etario"@es ;
    rdfs:comment "A coarse age bucket aligned to CTDC: 0-8, 9-17, 18-20, 21-23, 24-26, 27-29, 30-38, 39-47, 48+."@en .

:Gender a owl:Class ;
    rdfs:label "Gender"@en, "Género"@es .

#################################################################
#    Routes, countries, sources
#################################################################

:TraffickingRoute a owl:Class ;
    rdfs:label "Trafficking route"@en, "Ruta de trata"@es ;
    skos:closeMatch <https://bioportal.bioontology.org/ontologies/HUTROtrafficking_transit_places> .

:Country a owl:Class ;
    rdfs:label "Country"@en, "País"@es .

:Language a owl:Class ;
    rdfs:label "Language"@en, "Idioma"@es .

:EvidenceSource a owl:Class ;
    rdfs:label "Evidence source"@en, "Fuente de evidencia"@es ;
    rdfs:comment "A public document or case file from which a pattern, route, offer or victim record was derived (e.g. press article, CTDC record, NGO report)."@en .

:PressArticle a owl:Class ;
    rdfs:subClassOf :EvidenceSource ;
    rdfs:label "Press article"@en, "Artículo de prensa"@es .

:OpenDatasetRecord a owl:Class ;
    rdfs:subClassOf :EvidenceSource ;
    rdfs:label "Open dataset record"@en, "Registro de dataset abierto"@es ;
    rdfs:comment "A single anonymised case record drawn from an open anti-trafficking dataset such as CTDC or UNODC."@en .

#################################################################
#    Object properties — Offer-centric
#################################################################

:offeredBy a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :Agent ;
    rdfs:label "offered by"@en .

:offeredByRecruiter a owl:ObjectProperty ;
    rdfs:subPropertyOf :offeredBy ;
    rdfs:domain :JobOffer ; rdfs:range :Recruiter ;
    rdfs:label "offered by recruiter"@en .

:offeredByEmployer a owl:ObjectProperty ;
    rdfs:subPropertyOf :offeredBy ;
    rdfs:domain :JobOffer ; rdfs:range :Employer ;
    rdfs:label "offered by employer"@en .

:postedVia a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :Platform ;
    rdfs:label "posted via"@en .

:hasRedFlag a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :RedFlag ;
    rdfs:label "has red flag"@en .

:matchesPattern a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :SurvivorTestimonyPattern ;
    rdfs:label "matches pattern"@en .

:hasRiskClassification a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :RiskClassification ;
    rdfs:label "has risk classification"@en .

:inCountry a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :Country ;
    rdfs:label "in country"@en .

:inLanguage a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :Language ;
    rdfs:label "in language"@en .

:associatedWithRoute a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :TraffickingRoute ;
    rdfs:label "associated with route"@en .

:hasRecruitmentMethod a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :RecruitmentMethod ;
    rdfs:label "has recruitment method"@en .

:leadsToExploitation a owl:ObjectProperty ;
    rdfs:domain :JobOffer ; rdfs:range :TypeOfExploitation ;
    rdfs:label "leads to exploitation"@en ;
    rdfs:comment "Only asserted when the offer has been confirmed to have produced an exploitation outcome (from press case or dataset confirmation)."@en .

#################################################################
#    Object properties — Victim-centric (new in v1.0)
#################################################################

:victimOfOffer a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :JobOffer ;
    rdfs:label "victim of offer"@en .

:victimOfExploitation a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :TypeOfExploitation ;
    rdfs:label "victim of exploitation type"@en .

:hasDemographicProfile a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :DemographicProfile ;
    rdfs:label "has demographic profile"@en .

:hasAgeGroup a owl:ObjectProperty ;
    rdfs:domain :DemographicProfile ; rdfs:range :AgeGroup ;
    rdfs:label "has age group"@en .

:hasGender a owl:ObjectProperty ;
    rdfs:domain :DemographicProfile ; rdfs:range :Gender ;
    rdfs:label "has gender"@en .

:hasNationality a owl:ObjectProperty ;
    rdfs:domain :DemographicProfile ; rdfs:range :Country ;
    rdfs:label "has nationality"@en .

:hasVulnerabilityFactor a owl:ObjectProperty ;
    rdfs:domain :DemographicProfile ; rdfs:range :VulnerabilityFactor ;
    rdfs:label "has vulnerability factor"@en .

:recruitedVia a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :RecruitmentMethod ;
    rdfs:label "recruited via"@en .

:contactedThrough a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :CommunicationTool ;
    rdfs:label "contacted through"@en .

:transportedBy a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :TransportationMeans ;
    rdfs:label "transported by"@en .

:travelledWith a owl:ObjectProperty ;
    rdfs:domain :Victim ; rdfs:range :DocumentationType ;
    rdfs:label "travelled with documentation"@en .

#################################################################
#    Object properties — Route and agents
#################################################################

:originCountry a owl:ObjectProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range :Country ;
    rdfs:label "origin country"@en .

:destinationCountry a owl:ObjectProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range :Country ;
    rdfs:label "destination country"@en .

:platformCountry a owl:ObjectProperty ;
    rdfs:domain :Platform ; rdfs:range :Country ;
    rdfs:label "platform country"@en .

:recruiterCountry a owl:ObjectProperty ;
    rdfs:domain :Recruiter ; rdfs:range :Country ;
    rdfs:label "recruiter country"@en .

:submittedBy a owl:ObjectProperty ;
    rdfs:domain :Submission ; rdfs:range :Candidate ;
    rdfs:label "submitted by"@en .

:submittedOffer a owl:ObjectProperty ;
    rdfs:domain :Submission ; rdfs:range :JobOffer ;
    rdfs:label "submitted offer"@en .

:evidenceFor a owl:ObjectProperty ;
    rdfs:domain :EvidenceSource ;
    rdfs:label "evidence for"@en ;
    rdfs:comment "Links an evidence source to the pattern, route, offer or victim it documents."@en .

:derivedFrom a owl:ObjectProperty ;
    rdfs:range :EvidenceSource ;
    rdfs:label "derived from"@en .

#################################################################
#    Datatype properties — JobOffer
#################################################################

:hasTitle a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string .

:hasRawText a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string .

:postedOn a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:date .

:offeredSalaryMXN a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:decimal ;
    rdfs:comment "Weekly salary in MXN as advertised in the offer."@en .

:offeredRole a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string .

:offeredLocation a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:string .

:riskScore a owl:DatatypeProperty ;
    rdfs:domain :JobOffer ; rdfs:range xsd:decimal .

#################################################################
#    Datatype properties — Platform, Agent, flag, classification
#################################################################

:platformName a owl:DatatypeProperty ;
    rdfs:domain :Platform ; rdfs:range xsd:string .

:platformType a owl:DatatypeProperty ;
    rdfs:domain :Platform ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: whatsapp, telegram, messenger, sms, facebook, tiktok, marketplace, classifieds, tiktok, other."@en .

:agentName a owl:DatatypeProperty ;
    rdfs:domain :Agent ; rdfs:range xsd:string .

:contactHash a owl:DatatypeProperty ;
    rdfs:domain :Recruiter ; rdfs:range xsd:string .

:historicalOfferCount a owl:DatatypeProperty ;
    rdfs:domain :Agent ; rdfs:range xsd:integer .

:historicalFlagCount a owl:DatatypeProperty ;
    rdfs:domain :Agent ; rdfs:range xsd:integer .

:hasVerifiedIdentity a owl:DatatypeProperty ;
    rdfs:domain :Employer ; rdfs:range xsd:boolean .

:flagType a owl:DatatypeProperty ;
    rdfs:domain :RedFlag ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary of 7 red flags defined by Ramona AI: sueldo_alto, horarios_flexibles, sin_experiencia, pago_adelantado, aceptacion_urgente, entrevista_lejana_traslado, empleo_fuera_estado."@en .

:flagConfidence a owl:DatatypeProperty ;
    rdfs:domain :RedFlag ; rdfs:range xsd:decimal .

:detectedBy a owl:DatatypeProperty ;
    rdfs:domain :RedFlag ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: rule, nlp, human."@en .

:riskLevel a owl:DatatypeProperty ;
    rdfs:domain :RiskClassification ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: safe, suspicious, high-risk, fraudulent."@en .

:explanationText a owl:DatatypeProperty ;
    rdfs:domain :RiskClassification ; rdfs:range xsd:string .

:classifiedOn a owl:DatatypeProperty ;
    rdfs:domain :RiskClassification ; rdfs:range xsd:date .

:classifierVersion a owl:DatatypeProperty ;
    rdfs:domain :RiskClassification ; rdfs:range xsd:string .

:patternName a owl:DatatypeProperty ;
    rdfs:domain :SurvivorTestimonyPattern ; rdfs:range xsd:string .

:patternDescription a owl:DatatypeProperty ;
    rdfs:domain :SurvivorTestimonyPattern ; rdfs:range xsd:string .

#################################################################
#    Datatype properties — Route, country, language
#################################################################

:routeName a owl:DatatypeProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range xsd:string .

:knownSince a owl:DatatypeProperty ;
    rdfs:domain :TraffickingRoute ; rdfs:range xsd:date .

:countryName a owl:DatatypeProperty ;
    rdfs:domain :Country ; rdfs:range xsd:string .

:countryISOCode a owl:DatatypeProperty ;
    rdfs:domain :Country ; rdfs:range xsd:string .

:languageName a owl:DatatypeProperty ;
    rdfs:domain :Language ; rdfs:range xsd:string .

:languageISOCode a owl:DatatypeProperty ;
    rdfs:domain :Language ; rdfs:range xsd:string .

#################################################################
#    Datatype properties — HUTRO-aligned concepts
#################################################################

:recruitmentMethodName a owl:DatatypeProperty ;
    rdfs:domain :RecruitmentMethod ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: personal_network, false_job_offer, social_media_contact, abduction, sale_by_family, debt_bondage, other."@en .

:exploitationType a owl:DatatypeProperty ;
    rdfs:domain :TypeOfExploitation ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: labour, sexual, forced_criminality, forced_marriage, organ_removal, mixed, unknown."@en .

:vulnerabilityFactorName a owl:DatatypeProperty ;
    rdfs:domain :VulnerabilityFactor ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: economic, migrant_status, minor, prior_abuse, low_education, single_parent, displaced, indigenous, other."@en .

:transportationMeansName a owl:DatatypeProperty ;
    rdfs:domain :TransportationMeans ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: bus, car, foot, boat, air, train, truck, mixed, unknown."@en .

:communicationToolName a owl:DatatypeProperty ;
    rdfs:domain :CommunicationTool ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: whatsapp, messenger, telegram, sms, voice_call, in_person, email, other."@en .

:documentationTypeName a owl:DatatypeProperty ;
    rdfs:domain :DocumentationType ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: national_id, passport, visa, work_permit, none, confiscated, false."@en .

#################################################################
#    Datatype properties — Victim and demographics
#################################################################

:victimId a owl:DatatypeProperty ;
    rdfs:domain :Victim ; rdfs:range xsd:string ;
    rdfs:comment "Anonymised case identifier. For CTDC records, the CTDC victim id. For press cases, an outlet-specific hash."@en .

:yearOfRegistration a owl:DatatypeProperty ;
    rdfs:domain :Victim ; rdfs:range xsd:gYear .

:ageGroupName a owl:DatatypeProperty ;
    rdfs:domain :AgeGroup ; rdfs:range xsd:string .

:genderName a owl:DatatypeProperty ;
    rdfs:domain :Gender ; rdfs:range xsd:string ;
    rdfs:comment "Controlled vocabulary: female, male, non_binary, unknown."@en .

#################################################################
#    Datatype properties — Evidence sources
#################################################################

:sourceTitle a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range xsd:string .

:sourceOutlet a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range xsd:string .

:sourceUrl a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range xsd:anyURI .

:sourceDate a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range xsd:date .

:sourceAuthor a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSource ; rdfs:range xsd:string .

:datasetName a owl:DatatypeProperty ;
    rdfs:domain :OpenDatasetRecord ; rdfs:range xsd:string ;
    rdfs:comment "Name of the open dataset (e.g. CTDC, UNODC-GLOTIP, RNPDNO)."@en .

:datasetRecordId a owl:DatatypeProperty ;
    rdfs:domain :OpenDatasetRecord ; rdfs:range xsd:string .
