<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:vann="http://purl.org/vocab/vann/"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:dct="http://purl.org/dc/terms/"
  xmlns:ont="https://w3id.org/ratr-o#"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <owl:Class rdf:about="https://w3id.org/ratr-o#OnlineRecruitmentChannel">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#Platform"/>
    <rdfs:label xml:lang="en">Online recruitment channel</rdfs:label>
    <rdfs:label xml:lang="es">Canal de reclutamiento en línea</rdfs:label>
    <rdfs:comment xml:lang="en">A digital communication channel used by recruiters to contact candidates. Controlled vocabulary covers Messenger, WhatsApp, Telegram, Marketplace, TikTok, SMS, classifieds and other.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#WomenInvitationSignal">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaRecruitmentSignal"/>
    <rdfs:label xml:lang="en">Invites women</rdfs:label>
    <rdfs:label xml:lang="es">Invita a mujeres</rdfs:label>
    <rdfs:comment xml:lang="en">Explicitly invites or accepts women ('trabajo para hombres y mujeres', 'mujeres tambien entran'). Colmex 2025, images 4 and 19.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#exhibitsMeans">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#PalermoMeans"/>
    <rdfs:label xml:lang="en">exhibits Palermo means</rdfs:label>
    <rdfs:label xml:lang="es">exhibe el medio de Palermo</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a job offer to the Palermo Means it realises, normally :MeansDeception or :MeansFraud.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#promisedWeeklyPayMXN">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SocialMediaPost"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">promised weekly pay (MXN)</rdfs:label>
    <rdfs:label xml:lang="es">pago semanal prometido (MXN)</rdfs:label>
    <rdfs:comment xml:lang="en">Weekly pay promised in the post, in Mexican pesos.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#transportationMeansName">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TransportationMeans"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary: bus, car, foot, boat, air, train, truck, mixed, unknown.</rdfs:comment>
    <rdfs:label xml:lang="en">transportation means name</rdfs:label>
    <rdfs:label xml:lang="es">nombre del medio de transporte</rdfs:label>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#platformModeratedBy">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Platform"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Agent"/>
    <rdfs:label xml:lang="en">platform moderated by</rdfs:label>
    <rdfs:label xml:lang="es">plataforma moderada por</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a platform to the agent responsible for its moderation, used to record to whom a reported offer can be escalated.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#offerIsActive">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:boolean. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:boolean literals.</skos:note>
    <rdfs:label xml:lang="en">offer is active</rdfs:label>
    <rdfs:label xml:lang="es">la oferta está activa</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the offer was still reachable at the time of the last check.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#schemeCode">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">scheme code</rdfs:label>
    <rdfs:label xml:lang="es">código del esquema</rdfs:label>
    <rdfs:comment xml:lang="en">The local name of the :FraudScheme subclass an individual scheme occurrence belongs to, as a string (for example PayToWorkScheme). It lets a query group occurrences by scheme without querying the class hierarchy. Introduced in v1.10.5: the reference queries derived this code from the fragment of the occurrence IRI, which has none.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#victimPriorEmployment">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">prior employment status</rdfs:label>
    <rdfs:label xml:lang="es">situación laboral previa</rdfs:label>
    <rdfs:comment xml:lang="en">Employment situation of the victim before recruitment, as recorded by the source dataset.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#routeEarliestYear">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TraffickingRoute"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:gYear. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:gYear literals.</skos:note>
    <rdfs:label xml:lang="en">route earliest year</rdfs:label>
    <rdfs:label xml:lang="es">año más temprano de la ruta</rdfs:label>
    <rdfs:comment xml:lang="en">Earliest year for which the route is attested in the source dataset.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#sourceAccessedAt">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">source accessed timestamp</rdfs:label>
    <rdfs:label xml:lang="es">fecha y hora de consulta de la fuente</rdfs:label>
    <rdfs:comment xml:lang="en">Timestamp at which the evidence source was accessed. Recorded for every source, because a share of the press and institutional URLs in the corpus stop resolving.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#destinationCountry">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TraffickingRoute"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Country"/>
    <rdfs:label xml:lang="en">destination country</rdfs:label>
    <rdfs:label xml:lang="es">país de destino</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a trafficking route to its country of destination.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#vulnerabilityFactorName">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#VulnerabilityFactor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary: economic, migrant_status, minor, prior_abuse, low_education, single_parent, displaced, indigenous, other.</rdfs:comment>
    <rdfs:label xml:lang="en">vulnerability factor name</rdfs:label>
    <rdfs:label xml:lang="es">nombre del factor de vulnerabilidad</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#knownSince">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TraffickingRoute"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:date. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:date literals.</skos:note>
    <rdfs:label xml:lang="en">known since</rdfs:label>
    <rdfs:label xml:lang="es">conocida desde</rdfs:label>
    <rdfs:comment xml:lang="en">Date from which the route is known to Ramona.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#platformType">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Platform"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary: whatsapp, telegram, messenger, sms, facebook, tiktok, marketplace, classifieds, tiktok, other.</rdfs:comment>
    <rdfs:label xml:lang="en">platform type</rdfs:label>
    <rdfs:label xml:lang="es">tipo de plataforma</rdfs:label>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#SportsTalentScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Sports talent recruitment scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de reclutamiento deportivo fraudulento</rdfs:label>
    <rdfs:comment xml:lang="en">Offer to join a 'football academy' in Europe, a 'baseball academy' in the US, or a 'boxing camp' abroad, with flight and training fees. Victim (usually an adolescent) is abandoned at destination when the agency disappears or is placed under exploitative training contracts with no professional outcome. Extensively documented by FIFPro (World Players Union) in its 2018 Africa report and by ILO in the Latin-America to Europe and Asia to Gulf corridors for youth football. Also attested in baseball recruiting in the Dominican Republic and Venezuela.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://fifpro.org/en/supporting-players/safe-working-environments/human-trafficking/"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#observedCount">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">observed count</rdfs:label>
    <rdfs:label xml:lang="es">frecuencia observada</rdfs:label>
    <rdfs:comment xml:lang="en">Number of case-relevant evidence sources in which the pattern was detected.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#victimReferralSource">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">victim referral source</rdfs:label>
    <rdfs:label xml:lang="es">fuente de derivación de la víctima</rdfs:label>
    <rdfs:comment xml:lang="en">How the victim was identified: self-report, NGO, law enforcement, embassy, hotline.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#termDocumentedIn">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#LexiconTerm"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:label xml:lang="en">term documented in</rdfs:label>
    <rdfs:label xml:lang="es">documentado en</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a lexicon term to the evidence source that documents it. Every term in the TikTok recruitment lexicon carries this link to the research report and page it was taken from.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#PurposeOrganRemoval">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoPurpose"/>
    <rdfs:label xml:lang="en">Removal of organs</rdfs:label>
    <rdfs:label xml:lang="es">Extracción de órganos</rdfs:label>
    <rdfs:comment xml:lang="en">The PURPOSE 'removal of organs' in the sense of Palermo Protocol Article 3(a).</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#schemeJurisdictionScope">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">scheme jurisdiction scope</rdfs:label>
    <rdfs:label xml:lang="es">ámbito jurisdiccional del esquema</rdfs:label>
    <rdfs:comment xml:lang="en">local, national, regional, continental, global.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#recruiterCountry">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Recruiter"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Country"/>
    <rdfs:label xml:lang="en">recruiter country</rdfs:label>
    <rdfs:label xml:lang="es">país del reclutador</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a recruiter to the country they operate from, as far as it can be established from the report.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#routeName">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TraffickingRoute"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">route name</rdfs:label>
    <rdfs:label xml:lang="es">nombre de la ruta</rdfs:label>
    <rdfs:comment xml:lang="en">Human-readable name of the route.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#MeansCoercion">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoMeans"/>
    <rdfs:label xml:lang="en">Coercion</rdfs:label>
    <rdfs:label xml:lang="es">Coacción</rdfs:label>
    <rdfs:comment xml:lang="en">The MEANS 'other forms of coercion' in the sense of Palermo Protocol Article 3(a).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#FamilyAppealSignal">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaRecruitmentSignal"/>
    <rdfs:label xml:lang="en">Family appeal</rdfs:label>
    <rdfs:label xml:lang="es">Apela a la familia</rdfs:label>
    <rdfs:comment xml:lang="en">Frames joining as sacrifice for the family ('que harias por tu mama', 'sacar a mi jefita adelante'). Colmex 2025, pp. 23 and 51.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#OnlineInfluencerSalesScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Influencer sales scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de ventas como influencer</rdfs:label>
    <rdfs:comment xml:lang="en">The candidate is offered a paid role as 'brand ambassador', 'community manager trainee' or 'social media sales associate'. The role requires the candidate to set up their own social accounts, purchase the product catalogue, and 'earn' from commission and from recruiting further ambassadors. In effect a pyramid or MLM structure presented as a creator-economy job. Commonly used by cosmetic, fashion and digital-education brands.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#submittedBy">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Submission"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Candidate"/>
    <rdfs:label xml:lang="en">submitted by</rdfs:label>
    <rdfs:label xml:lang="es">enviada por</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a submission to the candidate that sent it.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#DomesticWorkerLockInScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Domestic worker lock-in scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de encierro en trabajo doméstico</rdfs:label>
    <rdfs:comment xml:lang="en">The candidate is hired as a live-in domestic worker, caregiver or nanny and then isolated inside the employer's household: documents withheld, phone confiscated or rationed, days-off refused, movement outside the home forbidden. Wages are withheld or paid to a family member. Common end-state of VisaFraudScheme placements abroad and of internal placements from rural to urban Mexico.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#MeansAbuseOfPower">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoMeans"/>
    <rdfs:label xml:lang="en">Abuse of power</rdfs:label>
    <rdfs:label xml:lang="es">Abuso de poder</rdfs:label>
    <rdfs:comment xml:lang="en">The MEANS 'abuse of power' in the sense of Palermo Protocol Article 3(a).</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#offerDocumentedIn">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#hasEvidenceSource">
        <rdfs:range rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
        <rdfs:label xml:lang="en">has evidence source</rdfs:label>
        <rdfs:label xml:lang="es">tiene fuente de evidencia</rdfs:label>
        <rdfs:comment xml:lang="en">Provenance, stated without restricting the kind of thing being traced. Routes, victim records, patterns and offers all carry at least one evidence source, so this property has a range but no domain, and the kind-specific properties :derivedFrom (patterns) and :offerDocumentedIn (offers) are subproperties of it. A query that asks what any fact rests on uses this property; a query about one kind of fact uses the subproperty.</rdfs:comment>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:label xml:lang="en">offer documented in</rdfs:label>
    <rdfs:label xml:lang="es">oferta documentada en</rdfs:label>
    <rdfs:comment xml:lang="en">Provenance: the evidence source (press article, report) that describes this offer.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#offeredByRecruiter">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#offeredBy">
        <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
        <rdfs:range rdf:resource="https://w3id.org/ratr-o#Agent"/>
        <rdfs:label xml:lang="en">offered by</rdfs:label>
        <rdfs:label xml:lang="es">ofrecida por</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a job offer to the agent that made it. Specialised by :offeredByRecruiter and :offeredByEmployer.</rdfs:comment>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Recruiter"/>
    <rdfs:label xml:lang="en">offered by recruiter</rdfs:label>
    <rdfs:label xml:lang="es">ofrecida por el reclutador</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a job offer to the recruiter that made it. A subproperty of :offeredBy.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#victimOfOffer">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:label xml:lang="en">victim of offer</rdfs:label>
    <rdfs:label xml:lang="es">víctima de la oferta</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a victim to the job offer through which they were recruited.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#victimId">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Anonymised case identifier. For CTDC records, the CTDC victim id. For press cases, an outlet-specific hash.</rdfs:comment>
    <rdfs:label xml:lang="en">victim id</rdfs:label>
    <rdfs:label xml:lang="es">identificador de víctima</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#offerPayPeriod">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">offered pay period</rdfs:label>
    <rdfs:label xml:lang="es">periodo de pago</rdfs:label>
    <rdfs:comment xml:lang="en">Period the stated pay refers to, for example weekly, fortnightly or monthly.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#exploitedInCountry">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Country"/>
    <rdfs:label xml:lang="en">exploited in country</rdfs:label>
    <rdfs:label xml:lang="es">explotada en el país</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a victim record to the country in which the exploitation took place (CountryOfExploitation in CTDC). Introduced in v1.10.5: until then the mappings stated it with :inCountry, whose domain is :JobOffer, so the TBox entailed that every victim with a country of exploitation was a job offer.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#offerFirstContactAt">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">offer first contact timestamp</rdfs:label>
    <rdfs:label xml:lang="es">fecha y hora del primer contacto de la oferta</rdfs:label>
    <rdfs:comment xml:lang="en">Timestamp of the first contact between the recruiter and the candidate, as reported by the candidate.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#lexiconCategory">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#LexiconTerm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">lexicon category</rdfs:label>
    <rdfs:label xml:lang="es">categoría del léxico</rdfs:label>
    <rdfs:comment xml:lang="en">Category the lexicon term belongs to, for example the role offered, the pay or the weapon.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#ExploitationPattern">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:label xml:lang="en">Exploitation pattern</rdfs:label>
    <rdfs:label xml:lang="es">Patrón de explotación</rdfs:label>
    <rdfs:comment xml:lang="en">A pattern describing the final exploitation outcome attested or suggested in the evidence source (labour hospitality, sexual, forced criminality, organ removal).</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#hasRawText">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">offer raw text</rdfs:label>
    <rdfs:label xml:lang="es">texto crudo de la oferta</rdfs:label>
    <rdfs:comment xml:lang="en">Verbatim text of the offer as published or as forwarded by the candidate. The raw text is kept because the wording is the object of study, and it is stored with contact details removed.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#PurposeSexualExploitation">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoPurpose"/>
    <rdfs:label xml:lang="en">Sexual exploitation</rdfs:label>
    <rdfs:label xml:lang="es">Explotación sexual</rdfs:label>
    <rdfs:comment xml:lang="en">The PURPOSE 'exploitation of the prostitution of others or other forms of sexual exploitation' in the sense of Palermo Protocol Article 3(a).</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#dominanceBucketValue">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">dominance bucket value</rdfs:label>
    <rdfs:label xml:lang="es">valor de rango de dominancia</rdfs:label>
    <rdfs:comment xml:lang="en">The frequency band of the pattern as a literal, one of hot, warm or cold. It duplicates :hasDominanceBucket deliberately, so that a client can read the band without following an object property.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#hasDominanceBucket">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#DominanceBucket"/>
    <rdfs:label xml:lang="en">has dominance bucket</rdfs:label>
    <rdfs:label xml:lang="es">tiene rango de dominancia</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a survivor-testimony pattern to the frequency band it falls in. Populated by the mapping from the dominance_bucket column of survivor_patterns.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#Transportation">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoAction"/>
    <rdfs:label xml:lang="en">Transportation (act)</rdfs:label>
    <rdfs:label xml:lang="es">Transporte (acción)</rdfs:label>
    <rdfs:comment xml:lang="en">The ACT of transportation in the sense of Palermo Protocol Article 3(a): moving the person within or across borders after recruitment.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#FakeMaquilaScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Fake maquila scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de maquila fantasma</rdfs:label>
    <rdfs:comment xml:lang="en">Offer of employment at an export-processing factory in the Mexican north border or in border free-trade zones. The maquila is either non-existent (workers arrive to find no facility), a cover for forced labour in a related industry (for example drug packaging, human-trafficking logistics), or a real facility operating under abusive conditions below the legal minimum. Candidates commonly relocate from southern Mexico and Central America.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#visualDescription">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SocialMediaPost"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">visual description</rdfs:label>
    <rdfs:label xml:lang="es">descripción visual</rdfs:label>
    <rdfs:comment xml:lang="en">Description of what the post shows.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#extractionConfidence">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">extraction confidence</rdfs:label>
    <rdfs:label xml:lang="es">confianza de extracción</rdfs:label>
    <rdfs:comment xml:lang="en">high, medium or low: how clearly the source describes this specific offer.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#patternRegex">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">pattern regex</rdfs:label>
    <rdfs:label xml:lang="es">expresión regular del patrón</rdfs:label>
    <rdfs:comment xml:lang="en">Regular expression used to detect the pattern in offer text. Published together with the pattern so that any reported count can be reproduced and contested.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#languageName">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Language"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">language name</rdfs:label>
    <rdfs:label xml:lang="es">nombre del idioma</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the language in English.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#exploitationType">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TypeOfExploitation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary: labour, sexual, forced_criminality, forced_marriage, organ_removal, mixed, unknown.</rdfs:comment>
    <rdfs:label xml:lang="en">exploitation type name</rdfs:label>
    <rdfs:label xml:lang="es">nombre del tipo de explotación</rdfs:label>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#BeggingRingScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Forced begging ring scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de mendicidad forzada</rdfs:label>
    <rdfs:comment xml:lang="en">Offer of 'help' or 'a job in the city' that leads to forced begging under the control of a ring leader. Common victims are minors, persons with disabilities, and migrants with precarious status. The ring leader confiscates earnings and controls movement. Named explicitly in the UNODC Protocol against Trafficking in Persons glossary and discussed by UNICEF in urban contexts in Mexico, Honduras and Guatemala. Maps to :PurposeForcedLabour or :PurposeSlavery depending on the context.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://www.unodc.org/unodc/en/human-trafficking/faqs.html"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#yearOfRegistration">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:gYear. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:gYear literals.</skos:note>
    <rdfs:label xml:lang="en">year of registration</rdfs:label>
    <rdfs:label xml:lang="es">año de registro</rdfs:label>
    <rdfs:comment xml:lang="en">Year in which the victim's case was registered by the source dataset. The year is the finest time granularity RATR-O records about a victim.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#schemeTypicalRoute">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#TraffickingRoute"/>
    <rdfs:label xml:lang="en">typical trafficking route for scheme</rdfs:label>
    <rdfs:label xml:lang="es">ruta de trata típica del esquema</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a fraud scheme to a trafficking route along which its victims are typically moved.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#historicalFlagCount">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Agent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">historical flag count</rdfs:label>
    <rdfs:label xml:lang="es">banderas históricas</rdfs:label>
    <rdfs:comment xml:lang="en">Number of red flags previously recorded across this agent's offers in Ramona's own data.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#itemPostedAt">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SocialMediaItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">item posted at</rdfs:label>
    <rdfs:label xml:lang="es">fecha de publicación</rdfs:label>
    <rdfs:comment xml:lang="en">Timestamp at which the social-media item was posted.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#lexiconTermText">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#LexiconTerm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">term text</rdfs:label>
    <rdfs:label xml:lang="es">texto del término</rdfs:label>
    <rdfs:comment xml:lang="en">The lexicon term as written in the source.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#schemeExploitationType">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#TypeOfExploitation"/>
    <rdfs:label xml:lang="en">scheme leads to exploitation type</rdfs:label>
    <rdfs:label xml:lang="es">el esquema conduce al tipo de explotación</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a fraud scheme to the type of exploitation it leads to.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#HighWeeklyPaySignal">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaRecruitmentSignal"/>
    <rdfs:label xml:lang="en">High weekly pay</rdfs:label>
    <rdfs:label xml:lang="es">Pago semanal alto</rdfs:label>
    <rdfs:comment xml:lang="en">Weekly pay promise far above the local labour market ('pagamos 10mil a 15mil pesos semanales'). Colmex 2025, image 3.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#exhibitsPurpose">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#PalermoPurpose"/>
    <rdfs:label xml:lang="en">exhibits Palermo purpose</rdfs:label>
    <rdfs:label xml:lang="es">exhibe el propósito de Palermo</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a job offer to the Palermo Purpose it is believed to serve. Assertion of a purpose is an interpretive step and in the demonstrator it is only made when an evidence source states the exploitation outcome.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#containsRedFlag">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#RedFlag"/>
    <rdfs:label xml:lang="en">contains red flag</rdfs:label>
    <rdfs:label xml:lang="es">contiene la señal de alerta</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a job offer to a red flag detected in its text. Kept alongside :hasRedFlag because the mapping layer populates them from different sources: :containsRedFlag from text classification, :hasRedFlag from the reviewed classification record.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#countryName">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Country"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">country name</rdfs:label>
    <rdfs:label xml:lang="es">nombre del país</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the country in English.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#routeStopoverCountries">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TraffickingRoute"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">route stopover countries (ISO3 list)</rdfs:label>
    <rdfs:label xml:lang="es">países de tránsito de la ruta (lista ISO3)</rdfs:label>
    <rdfs:comment xml:lang="en">Stopover countries of the route, as a list of ISO 3166-1 alpha-3 codes.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#itemIsSynthetic">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SocialMediaItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:boolean. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:boolean literals.</skos:note>
    <rdfs:label xml:lang="en">item is synthetic</rdfs:label>
    <rdfs:label xml:lang="es">es sintético</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the item is synthetic. Every synthetic item in the demonstrator carries this property set to true, so that no figure can be computed over real and generated items without distinguishing them.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#offerSummary">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">offer summary</rdfs:label>
    <rdfs:label xml:lang="es">resumen de la oferta</rdfs:label>
    <rdfs:comment xml:lang="en">One-sentence Spanish paraphrase of the offer as described by the source.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#offeredSalaryMXN">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="en">Weekly salary in MXN as advertised in the offer.</rdfs:comment>
    <rdfs:label xml:lang="en">offered salary in MXN</rdfs:label>
    <rdfs:label xml:lang="es">salario ofrecido en MXN</rdfs:label>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#PurposeSlavery">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoPurpose"/>
    <rdfs:label xml:lang="en">Slavery or practices similar to slavery</rdfs:label>
    <rdfs:label xml:lang="es">Esclavitud o prácticas análogas</rdfs:label>
    <rdfs:comment xml:lang="en">The PURPOSE 'slavery or practices similar to slavery' in the sense of Palermo Protocol Article 3(a).</rdfs:comment>
  </owl:Class>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#originCountry">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TraffickingRoute"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Country"/>
    <rdfs:label xml:lang="en">origin country</rdfs:label>
    <rdfs:label xml:lang="es">país de origen</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a trafficking route to its country of origin.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#evidencedByPressArticle">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#PressArticle"/>
    <rdfs:label xml:lang="en">evidenced by press article</rdfs:label>
    <rdfs:label xml:lang="es">sustentada en el artículo de prensa</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a fraud scheme to a press article that documents it. Every named scheme in RATR-O carries at least one such link or an rdfs:seeAlso to an institutional source.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#ModelingAgencyScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Modelling agency scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de agencia de modelaje</rdfs:label>
    <rdfs:comment xml:lang="en">A supposed modelling, acting, influencer or image agency recruits young women, occasionally men, with the promise of bookings abroad. The first 'casting' is used to produce compromising photographs and to extract personal data. Subsequent 'shoots' lead to sexual exploitation, pornographic production without consent or forced escort work. Documented end-state of recruitment on Facebook Marketplace and Instagram DMs in Mexico and Colombia.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#victimOfFraudScheme">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">victim of fraud scheme</rdfs:label>
    <rdfs:label xml:lang="es">víctima de esquema de fraude</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a victim to the named fraud scheme they were subjected to.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#derivedFrom">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/ratr-o#hasEvidenceSource"/>
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:label xml:lang="en">derived from</rdfs:label>
    <rdfs:label xml:lang="es">derivado de</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a survivor-testimony pattern to the evidence source it was derived from. Every pattern in RATR-O carries at least one such link, so that no detection rule is asserted without a traceable origin.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#tipEventHasAction">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TIPEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#PalermoAction"/>
    <rdfs:label xml:lang="en">TIP event has action</rdfs:label>
    <rdfs:label xml:lang="es">el evento de trata tiene la acción</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a TIP event to one of its Palermo Actions. ICS-TIP requires at least one action per event.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#inCountry">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Country"/>
    <rdfs:label xml:lang="en">in country</rdfs:label>
    <rdfs:label xml:lang="es">en el país</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a job offer to the country in which it was published or in which the work was offered. Its domain is :JobOffer, so it is not used for victims: the country in which a victim was exploited is stated with :exploitedInCountry.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#flagConfidence">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#RedFlag"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">flag confidence</rdfs:label>
    <rdfs:label xml:lang="es">confianza de la bandera</rdfs:label>
    <rdfs:comment xml:lang="en">Confidence of the red-flag detection, on a zero-to-one scale.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#evidenceStrength">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">evidence strength</rdfs:label>
    <rdfs:label xml:lang="es">fuerza de la evidencia</rdfs:label>
    <rdfs:comment xml:lang="en">primary / secondary / tertiary. Primary = direct survivor testimony, official statistics, court record; secondary = investigative journalism; tertiary = summary or editorial article.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#CallCenterScamScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Call-centre scam employment scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de empleo en call center estafador</rdfs:label>
    <rdfs:comment xml:lang="en">The candidate is hired as a legitimate customer-service, collections or sales agent in a call centre that is in fact a fraud operation (time-share extortion, fake investment, virtual kidnapping, romance scams). The worker realises they are defrauding clients and attempts to leave, at which point threats, wage withholding or confiscated documents prevent them from doing so. Documented in Mexico, Costa Rica and the Philippines.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#PrivateChannelCallSignal">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaRecruitmentSignal"/>
    <rdfs:label xml:lang="en">Call to private channel</rdfs:label>
    <rdfs:label xml:lang="es">Llamado al privado</rdfs:label>
    <rdfs:comment xml:lang="en">Redirects the audience to a private message ('escribe al privado', 'manda DM'). Colmex 2025, images 10, 13, 14, 19, 21.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#hostsOffer">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Platform"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#postedVia">
        <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
        <rdfs:range rdf:resource="https://w3id.org/ratr-o#Platform"/>
        <rdfs:label xml:lang="en">posted via</rdfs:label>
        <rdfs:label xml:lang="es">publicada a través de</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a job offer to the platform on which it was published or through which first contact happened.</rdfs:comment>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:label xml:lang="en">hosts offer</rdfs:label>
    <rdfs:label xml:lang="es">aloja la oferta</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a platform to a job offer published on it. Inverse of :postedVia.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#classifiedOn">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#RiskClassification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:date. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:date literals.</skos:note>
    <rdfs:label xml:lang="en">classified on</rdfs:label>
    <rdfs:label xml:lang="es">clasificado el</rdfs:label>
    <rdfs:comment xml:lang="en">Date on which the classification was produced.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#MeansAbuseOfVulnerability">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoMeans"/>
    <rdfs:label xml:lang="en">Abuse of a position of vulnerability</rdfs:label>
    <rdfs:label xml:lang="es">Abuso de una posición de vulnerabilidad</rdfs:label>
    <rdfs:comment xml:lang="en">The MEANS 'abuse of a position of vulnerability' in the sense of Palermo Protocol Article 3(a). In Ramona's corpus the vulnerability most often invoked is unemployment or urgent need of income, which is why :VulnerabilityFactor is modelled separately on the demographic profile.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#CentralAmericanMigrantLabourScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#DebtBondageTraffickingScheme"/>
    <rdfs:label xml:lang="en">Central-American migrant labour exploitation scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de explotación laboral de migrantes centroamericanos</rdfs:label>
    <rdfs:comment xml:lang="en">Offer of work in the United States or northern Mexico, targeted at Guatemalan, Honduran or Salvadoran candidates, that routes the victim via Tapachula and the Mexican migration corridor. On arrival, the victim is placed in construction, agriculture or hospitality under conditions of debt bondage: smuggling fees, document retention, threats of denunciation to immigration authorities. CTDC documents the GTM-USA corridor with 842 victims 2009-2023 and the HND and SLV citizenship clusters. Recognised by UNODC GLOTIP as a principal Latin-American corridor.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://www.ctdatacollaborative.org/page/global-synthetic-dataset"/>
    <rdfs:seeAlso rdf:resource="https://www.unodc.org/unodc/data-and-analysis/glotip.html"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#victimCaseOpenedAt">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:date. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:date literals.</skos:note>
    <rdfs:label xml:lang="en">victim case opened at</rdfs:label>
    <rdfs:label xml:lang="es">fecha de apertura del caso de la víctima</rdfs:label>
    <rdfs:comment xml:lang="en">Date on which the case concerning the victim was opened by the registering institution.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#classifierVersion">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#RiskClassification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">classifier version</rdfs:label>
    <rdfs:label xml:lang="es">versión del clasificador</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the classifier version that produced the classification. Required, so that counts can be recomputed after a classifier is corrected.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#OrganRemovalRecruitmentScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Organ removal recruitment scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de reclutamiento para extracción de órganos</rdfs:label>
    <rdfs:comment xml:lang="en">The offer promises medical treatment, paid egg donation, or a health procedure. The real purpose is extraction of organs (most commonly kidneys) or tissue for sale on the black market. Traffickers promise US$500 to US$10,000 that the victim often never receives. Documented in detail by the UNODC Assessment Toolkit on Trafficking in Persons for the Purpose of Organ Removal (2015, 60+ pages). Explicitly named as a purpose of trafficking by Article 3(a) of the Palermo Protocol (2000). Recruitment uses social media, word of mouth in vulnerable communities, and classifieds.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://www.unodc.org/documents/human-trafficking/2015/UNODC_Assessment_Toolkit_TIP_for_the_Purpose_of_Organ_Removal.pdf"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#hasGender">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#DemographicProfile"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Gender"/>
    <rdfs:label xml:lang="en">has gender</rdfs:label>
    <rdfs:label xml:lang="es">tiene género</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a demographic profile to a gender.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#FishingVesselLabourScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Fishing vessel labour scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de explotación laboral en pesca</rdfs:label>
    <rdfs:comment xml:lang="en">Offer of work on deep-sea fishing vessels with promised wages and return dates. Victims are taken to international waters where they are held for months or years without pay, with document confiscation, physical abuse and no possibility of exit. Extensively documented by the International Labour Organization ('Caught at Sea', 2013) and by the Environmental Justice Foundation. Principal victim populations include Myanmar, Cambodia, Indonesia and the Philippines; vessels often registered in Thailand, Taiwan, Korea.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://www.ilo.org/publications/caught-sea-forced-labour-and-trafficking-fisheries"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#victimEducationLevel">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">education level</rdfs:label>
    <rdfs:label xml:lang="es">nivel educativo</rdfs:label>
    <rdfs:comment xml:lang="en">ICS-TIP additional disaggregating variable. Controlled vocab: none, primary, secondary, tertiary, postgraduate, unknown.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#sourceTitle">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">source title</rdfs:label>
    <rdfs:label xml:lang="es">título de la fuente</rdfs:label>
    <rdfs:comment xml:lang="en">Title of the evidence source.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#itemMatchesTerm">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SocialMediaItem"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#LexiconTerm"/>
    <rdfs:label xml:lang="en">item matches lexicon term</rdfs:label>
    <rdfs:label xml:lang="es">coincide con término</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a social-media item to a lexicon term it matches.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#evidenceAccessedOnline">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:boolean. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:boolean literals.</skos:note>
    <rdfs:label xml:lang="en">evidence accessed online</rdfs:label>
    <rdfs:label xml:lang="es">evidencia consultada en línea</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the evidence source was consulted online rather than on paper.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#VisaFraudScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Migration / visa fraud scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de fraude migratorio</rdfs:label>
    <rdfs:comment xml:lang="en">The offer promises employment in a foreign country (commonly Canada, the United States or Western Europe for Latin American victims) and demands payment for visa, gestor or recruiter services. The intermediary disappears after collecting payment. Commonly marketed as domestic work, caregiving, nanny placement or hospitality abroad.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#tipEventInvolves">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TIPEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:label xml:lang="en">TIP event involves victim</rdfs:label>
    <rdfs:label xml:lang="es">el evento de trata involucra a la víctima</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a trafficking-in-persons event to the victim it concerns, following the ICS-TIP rule that the TIP event is counted per victim.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#hasRedFlag">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#RedFlag"/>
    <rdfs:label xml:lang="en">has red flag</rdfs:label>
    <rdfs:label xml:lang="es">tiene señal de alerta</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a job offer to a red flag recorded in its reviewed classification.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#commentsOn">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SocialMediaComment"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#SocialMediaPost"/>
    <rdfs:label xml:lang="en">comments on</rdfs:label>
    <rdfs:label xml:lang="es">comenta en</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a social-media comment to the post it replies to. Recruiter replies in comment threads are modelled because in the Colmex corpus the recruitment contact is frequently made there rather than in the post itself.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#datasetRecordId">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#OpenDatasetRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">dataset record id</rdfs:label>
    <rdfs:label xml:lang="es">identificador de registro del dataset</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier of the record in the open dataset it came from, so that any figure can be traced back to the published dataset.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#explanationText">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#RiskClassification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">explanation text</rdfs:label>
    <rdfs:label xml:lang="es">texto explicativo</rdfs:label>
    <rdfs:comment xml:lang="en">Explanation of the risk classification in the language of the report.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#routeDominantExploitation">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TraffickingRoute"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#TypeOfExploitation"/>
    <rdfs:label xml:lang="en">route dominant exploitation</rdfs:label>
    <rdfs:label xml:lang="es">explotación dominante de la ruta</rdfs:label>
    <rdfs:comment xml:lang="en">The single exploitation type attested for the majority of victims on this route.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#EnrolInCrimeStoryPost">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#DirectRecruitmentPost"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#CriminalCultureExaltationPost"/>
    <rdfs:label xml:lang="en">Story: enrol in crime (NR*ECC)</rdfs:label>
    <rdfs:label xml:lang="es">Relato: enrolarse en lo criminal (NR*ECC)</rdfs:label>
    <rdfs:comment xml:lang="en">First recruitment story of Colmex 2025 (pp. 41-43). Sufficient condition NR AND ECC is not expressible in OWL 2 QL and is computed in the mapping.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#evidenceFor">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:label xml:lang="en">evidence for</rdfs:label>
    <rdfs:label xml:lang="es">evidencia de</rdfs:label>
    <rdfs:comment xml:lang="en">Links an evidence source to the pattern, route, offer or victim it documents.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#sourceDate">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:date. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:date literals.</skos:note>
    <rdfs:label xml:lang="en">source date</rdfs:label>
    <rdfs:label xml:lang="es">fecha de la fuente</rdfs:label>
    <rdfs:comment xml:lang="en">Publication date of the evidence source.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#MeansAbduction">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoMeans"/>
    <rdfs:label xml:lang="en">Abduction</rdfs:label>
    <rdfs:label xml:lang="es">Rapto</rdfs:label>
    <rdfs:comment xml:lang="en">The MEANS 'abduction' in the sense of Palermo Protocol Article 3(a).</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#patternHasKind">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">pattern kind</rdfs:label>
    <rdfs:label xml:lang="es">tipo de patrón</rdfs:label>
    <rdfs:comment xml:lang="en">The family a survivor-testimony pattern belongs to, as a literal. The values in use are classic_a (a canonical red flag), credible_b (a credible-lethal logistic signal), communication, recruitment, exploitation and deep_textual (extracted by deep-textual regex over press).</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#MinorAgeMentionSignal">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaRecruitmentSignal"/>
    <rdfs:label xml:lang="en">Minor age mention</rdfs:label>
    <rdfs:label xml:lang="es">Menciona edad de menor</rdfs:label>
    <rdfs:comment xml:lang="en">The item mentions an age under 18 ('puedo entrar con 16'). Colmex 2025, image 22. Links the item to child recruitment.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#hasDemographicProfile">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#DemographicProfile"/>
    <rdfs:label xml:lang="en">has demographic profile</rdfs:label>
    <rdfs:label xml:lang="es">tiene perfil demográfico</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a victim to their demographic profile. The profile is reified so that age group, gender, nationality and vulnerability factors can be recorded without ever attaching identifying attributes to the victim individual.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#offeredByEmployer">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/ratr-o#offeredBy"/>
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Employer"/>
    <rdfs:label xml:lang="en">offered by employer</rdfs:label>
    <rdfs:label xml:lang="es">ofrecida por el empleador</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a job offer to the employer that made it. A subproperty of :offeredBy.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#ClassicRedFlag">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#RedFlag"/>
    <rdfs:label xml:lang="en">Classic red flag (Type A)</rdfs:label>
    <rdfs:label xml:lang="es">Bandera roja clasica (Tipo A)</rdfs:label>
    <rdfs:comment xml:lang="en">One of the classic warning signs of Ramona's public infographic: high salary, no experience needed, urgent hiring, advance payment, paid travel, flexible hours, job in another state. The value is in :flagType.</rdfs:comment>
    <owl:disjointWith rdf:resource="https://w3id.org/ratr-o#CredibleLethalRedFlag"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#agentName">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Agent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">agent name</rdfs:label>
    <rdfs:label xml:lang="es">nombre del agente</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the agent as it appears in the offer or the report. For recruiters this is the name they gave, which is frequently false, and never a verified identity.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#tipEventRegisteredBy">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TIPEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Agent"/>
    <rdfs:label xml:lang="en">TIP event registered by</rdfs:label>
    <rdfs:label xml:lang="es">evento de trata registrado por</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a TIP event to the agent that registered it, typically an institution rather than a natural person.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#ageGroupName">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#AgeGroup"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">age group name</rdfs:label>
    <rdfs:label xml:lang="es">nombre del grupo etario</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the age band, for example '18-20' or '21-23'.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#PurposeForcedLabour">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoPurpose"/>
    <rdfs:label xml:lang="en">Forced labour or services</rdfs:label>
    <rdfs:label xml:lang="es">Trabajo o servicios forzados</rdfs:label>
    <rdfs:comment xml:lang="en">The PURPOSE 'forced labour or services' in the sense of Palermo Protocol Article 3(a).</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#communicationToolName">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#CommunicationTool"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary: whatsapp, messenger, telegram, sms, voice_call, in_person, email, other.</rdfs:comment>
    <rdfs:label xml:lang="en">communication tool name</rdfs:label>
    <rdfs:label xml:lang="es">nombre de la herramienta de comunicación</rdfs:label>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#tipEventHasMeans">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TIPEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#PalermoMeans"/>
    <rdfs:label xml:lang="en">TIP event has means</rdfs:label>
    <rdfs:label xml:lang="es">el evento de trata tiene el medio</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a TIP event to one of its Palermo Means. ICS-TIP requires at least one means per adult-victim event.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#hasMeansOfControl">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">means of control over victim</rdfs:label>
    <rdfs:label xml:lang="es">medio de control sobre la víctima</rdfs:label>
    <rdfs:comment xml:lang="en">Means of control exercised over the victim, as a code from the control-means list of the source dataset. Distinct from :PalermoMeans, which covers the means used to obtain the person; this property covers the means used to keep them.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#pctOfCases">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">percentage of cases</rdfs:label>
    <rdfs:label xml:lang="es">porcentaje de casos</rdfs:label>
    <rdfs:comment xml:lang="en">Share of the cases in the source corpus in which the survivor-testimony pattern appears, as a decimal percentage. The value is only meaningful together with the source asserted by :derivedFrom, because corpora differ in what they count.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#recruitmentMethodName">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#RecruitmentMethod"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary: personal_network, false_job_offer, social_media_contact, abduction, sale_by_family, debt_bondage, other.</rdfs:comment>
    <rdfs:label xml:lang="en">recruitment method name</rdfs:label>
    <rdfs:label xml:lang="es">nombre del método de reclutamiento</rdfs:label>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#ExploitationRisk">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#RiskClassification"/>
    <rdfs:label xml:lang="en">Labour exploitation risk</rdfs:label>
    <rdfs:label xml:lang="es">Riesgo de explotación laboral</rdfs:label>
    <rdfs:comment xml:lang="en">Risk that the offer leads to substandard working conditions, wage theft, excessive hours or other exploitation that does not rise to the legal definition of trafficking.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#matchesPattern">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:label xml:lang="en">matches pattern</rdfs:label>
    <rdfs:label xml:lang="es">coincide con el patrón</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a job offer to a survivor-testimony pattern whose detection rule it matches.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#contactedThrough">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#CommunicationTool"/>
    <rdfs:label xml:lang="en">contacted through</rdfs:label>
    <rdfs:label xml:lang="es">contactada a través de</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a victim to the communication tool through which the recruiter contacted them.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#languageISOCode">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Language"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">language ISO code</rdfs:label>
    <rdfs:label xml:lang="es">código ISO del idioma</rdfs:label>
    <rdfs:comment xml:lang="en">ISO 639-1 code of the language.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#MeansDeception">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoMeans"/>
    <rdfs:label xml:lang="en">Deception</rdfs:label>
    <rdfs:label xml:lang="es">Engaño</rdfs:label>
    <rdfs:comment xml:lang="en">The MEANS 'deception' in the sense of Palermo Protocol Article 3(a). A job offer whose terms misrepresent the role, the pay, the employer or the place of work realises this means.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#schemePalermoMeans">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#PalermoMeans"/>
    <rdfs:label xml:lang="en">scheme Palermo means</rdfs:label>
    <rdfs:label xml:lang="es">medio de Palermo del esquema</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a fraud scheme to the Palermo Means that characterises it.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#evidenceArchivedUrl">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:label xml:lang="en">evidence archived URL (e.g. archive.today)</rdfs:label>
    <rdfs:label xml:lang="es">URL archivada de la evidencia (por ejemplo archive.today)</rdfs:label>
    <rdfs:comment xml:lang="en">URL of an archived copy of the evidence source, used when the original stops resolving.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#MeansFraud">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoMeans"/>
    <rdfs:label xml:lang="en">Fraud</rdfs:label>
    <rdfs:label xml:lang="es">Fraude</rdfs:label>
    <rdfs:comment xml:lang="en">The MEANS 'fraud' in the sense of Palermo Protocol Article 3(a). Together with :MeansDeception this is the means that a deceptive job offer typically realises.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#hasAgeGroup">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#DemographicProfile"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#AgeGroup"/>
    <rdfs:label xml:lang="en">has age group</rdfs:label>
    <rdfs:label xml:lang="es">tiene grupo etario</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a demographic profile to an age group. RATR-O records age only in bands, never as a date of birth or an exact age.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#riskLevel">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#RiskClassification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary: safe, suspicious, high-risk, fraudulent.</rdfs:comment>
    <rdfs:label xml:lang="en">risk level</rdfs:label>
    <rdfs:label xml:lang="es">nivel de riesgo</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#offeredRole">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">offered role</rdfs:label>
    <rdfs:label xml:lang="es">rol ofrecido</rdfs:label>
    <rdfs:comment xml:lang="en">Job title or role as named in the offer, in the words of the offer.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Ontology rdf:about="https://w3id.org/ratr-o">
    <dc:title xml:lang="en">Ramona Anti-Trafficking and Recruitment-fraud Ontology (RATR-O)</dc:title>
    <dc:title xml:lang="es">Ontología Ramona contra el Reclutamiento Fraudulento y la Trata (RATR-O)</dc:title>
    <dc:creator>Daniela Camberos, Ramona AI</dc:creator>
    <dct:contributor>Magdalena Ortiz, TU Wien (proposed co-author, v1.0 onward)</dct:contributor>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dc:description xml:lang="en">OWL 2 QL ontology for detecting fraudulent job offers, recruitment fraud and trafficking recruitment in Latin America, designed as the conceptual layer of a Virtual Knowledge Graph.</dc:description>
    <owl:versionInfo>1.10.5</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://w3id.org/ratr-o/1.10.5"/>
    <owl:priorVersion rdf:resource="https://w3id.org/ratr-o/1.10.4"/>
    <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-21</dct:issued>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-21</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-10</dct:modified>
    <dct:publisher>Ramona AI</dct:publisher>
    <vann:preferredNamespaceUri>https://w3id.org/ratr-o#</vann:preferredNamespaceUri>
    <vann:preferredNamespacePrefix>ratro</vann:preferredNamespacePrefix>
    <dct:bibliographicCitation xml:lang="en">Camberos, D. (2026). Ramona Anti-Trafficking and Recruitment-fraud Ontology (RATR-O), version 1.10.5. https://w3id.org/ratr-o</dct:bibliographicCitation>
    <skos:note xml:lang="en">v1.9 (3 Nov 2026): persistent namespace moved to https://w3id.org/ratr-o (previous IRIs under ramona.ai were placeholders on a domain not controlled by the project). Adds the social-media criminal-recruitment module derived from El Colegio de Mexico (2025), Del scroll al jale. v1.9.1: in the OWL 2 QL profile under the OWL API checker (ROBOT 1.9.11); 16 data ranges outside the QL datatype map moved to rdfs:Literal; consistent under HermiT with and without data. See docs/validation/VALIDATION_REPORT.md. v1.10: real press offer corpus (data/real/press_offers.csv); Type A and Type B red-flag classes, criminal-recruitment offers and offer provenance. v1.10.1, v1.10.2 and v1.10.3: three audit passes before the delivery of O1, which found and fixed nineteen defects. The third pass executed the 40 reference queries and the seed files for the first time rather than reading them; see docs/AUDIT_O1_SUMMARY.md and docs/validation/QUERY_EXECUTION_REPORT.md. v1.10.3 restores the eight skos:closeMatch alignments to HUTRO with IRIs verified one by one in the BioPortal concept browser on 10 November 2026. v1.10.4: fourth pass. The four published serialisations were checked for isomorphism, mappings/ramona.r2rml.ttl was executed and produces the same 71,963 triples as the .obda, and 82 properties that carried only an English label were given the Spanish one, so all 283 terms are bilingual. Note on the published history: the commit that added the FAIR metadata and the extra serialisations changed this file while still calling itself 1.10.3, so the tag v1.10.3 and the branch disagreed about what 1.10.3 denotes. The tag v1.10.3 is left pointing where it pointed. v1.10.5: fifth pass. The victim module was loaded for the first time, from the CTDC release, and the domain and range axioms were checked against the data: the mappings stated a victim's country of exploitation with :inCountry and the kind of a source with :datasetName, so the TBox entailed that victims were job offers and press sources were open-dataset records. Adds :exploitedInCountry, :sourceKind and :schemeCode; the victim mappings now mint the :DemographicProfile the TBox always required. 1.10.5 is the version to cite.</skos:note>
    <rdfs:comment xml:lang="en">A domain ontology in OWL 2 QL (DL-Lite) for the detection of fraudulent job offers, labour-recruitment fraud, and human-trafficking recruitment patterns in Latin America. RATR-O models the full continuum of recruitment-based harm: from offers that defraud candidates (identity theft, financial scams, unpaid work) through offers that lead to labour exploitation, through to offers whose purpose is trafficking into forced labour, sexual exploitation, or forced criminality. A single JobOffer can exhibit indicators of any combination of these three outcomes, and RATR-O expresses them as distinct but compatible risk axes. The ontology is designed to operate as the conceptual layer of a Virtual Knowledge Graph over Ramona AI operational data and over open anti-trafficking datasets (CTDC, UNODC), following Xiao, Ding, Cogrel and Calvanese (2019). v1.0 aligns the generalisable fragment of HUTRO (Human Trafficking Ontology, BioPortal, 2025) with Ramona's domain-specific taxonomy of online recruitment fraud in Mexico and Latin America.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://bioportal.bioontology.org/ontologies/HUTRO"/>
  </owl:Ontology>
  <owl:Class rdf:about="https://w3id.org/ratr-o#PurposeServitude">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoPurpose"/>
    <rdfs:label xml:lang="en">Servitude</rdfs:label>
    <rdfs:label xml:lang="es">Servidumbre</rdfs:label>
    <rdfs:comment xml:lang="en">The PURPOSE 'servitude' in the sense of Palermo Protocol Article 3(a).</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/ratr-o#ColmexScrollAlJale2025">
    <rdf:type rdf:resource="https://w3id.org/ratr-o#ResearchReport"/>
    <rdfs:label xml:lang="es">Del scroll al 'jale': como se recluta en TikTok (El Colegio de Mexico, 2025)</rdfs:label>
    <ont:sourceTitle>Del scroll al 'jale': como se recluta en TikTok</ont:sourceTitle>
    <ont:sourceOutlet>Seminario sobre Violencia y Paz, El Colegio de Mexico</ont:sourceOutlet>
    <ont:sourceAuthor>Arias Vasquez, A. (coord.); Pena Gonzalez, R. (dir.); Aguayo Quezada, S. (coord. gral.)</ont:sourceAuthor>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#schemePalermoAction">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#PalermoAction"/>
    <rdfs:label xml:lang="en">scheme Palermo action</rdfs:label>
    <rdfs:label xml:lang="es">acción de Palermo del esquema</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a fraud scheme to the Palermo Action that characterises it.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#sourceKind">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">source kind</rdfs:label>
    <rdfs:label xml:lang="es">tipo de fuente</rdfs:label>
    <rdfs:comment xml:lang="en">The kind of evidence source as recorded at ingestion: press_article or press, ctdc, unodc, rnpdno, organisation_material, statistics_report. Introduced in v1.10.5: until then the mappings stated it with :datasetName, whose domain is :OpenDatasetRecord, so every source that carried a kind, press articles included, was entailed to be an open-dataset record.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#genderName">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Gender"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary: female, male, non_binary, unknown.</rdfs:comment>
    <rdfs:label xml:lang="en">gender name</rdfs:label>
    <rdfs:label xml:lang="es">nombre del género</rdfs:label>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#ConstructionLabourBondageScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Construction labour bondage scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de servidumbre en construcción</rdfs:label>
    <rdfs:comment xml:lang="en">Offer of construction work abroad or in another state with housing and 'flight to site' included. Upon arrival the worker finds pay deductions for housing, transport and tools that exceed the wage; documents are retained; movement off site is restricted. Documented by ILO in the Gulf States labour corridor (most notoriously Qatar World Cup preparation) and by HRW and Polaris in the US-Mexico corridor for Mexican and Central-American workers. Also attested internally in Mexico for workers displaced from southern states to the northern border.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://www.unodc.org/documents/human-trafficking/2015/Recruitment_Fees_Report-Final-22_June_2015_AG_Final.pdf"/>
    <rdfs:seeAlso rdf:resource="https://www.hrw.org/news/2012/06/12/qatar-migrant-construction-workers-face-abuse"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#lexiconSourceLocation">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#LexiconTerm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">location in source</rdfs:label>
    <rdfs:label xml:lang="es">ubicación en la fuente</rdfs:label>
    <rdfs:comment xml:lang="en">Page and image number in the source report.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#note"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#submittedOffer">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Submission"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:label xml:lang="en">submitted offer</rdfs:label>
    <rdfs:label xml:lang="es">oferta enviada</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a submission to the job offer it is about. Submissions are reified so that the same offer reported by several candidates is one offer with several submissions.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#offerLanguage">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">offer language ISO code</rdfs:label>
    <rdfs:label xml:lang="es">código ISO del idioma de la oferta</rdfs:label>
    <rdfs:comment xml:lang="en">ISO 639-1 code of the language the offer is written in.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#riskExplanationEs">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#RiskClassification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">risk explanation in Spanish</rdfs:label>
    <rdfs:label xml:lang="es">explicación del riesgo en español</rdfs:label>
    <rdfs:comment xml:lang="en">Explanation of the risk classification in Spanish, as shown to the person who reported the offer.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#offers">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Agent"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <owl:inverseOf rdf:resource="https://w3id.org/ratr-o#offeredBy"/>
    <rdfs:label xml:lang="en">offers</rdfs:label>
    <rdfs:label xml:lang="es">ofrece</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an agent to a job offer it makes. Inverse of :offeredBy.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#riskExplanationEn">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#RiskClassification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">risk explanation in English</rdfs:label>
    <rdfs:label xml:lang="es">explicación del riesgo en inglés</rdfs:label>
    <rdfs:comment xml:lang="en">Explanation of the risk classification in English, as shown to the person who reported the offer.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#exhibitsAction">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#PalermoAction"/>
    <rdfs:label xml:lang="en">exhibits Palermo action</rdfs:label>
    <rdfs:label xml:lang="es">exhibe la acción de Palermo</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a job offer to the Palermo Action it realises. For a deceptive recruitment offer this is normally :Recruitment.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#tipEventHasPurpose">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TIPEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#PalermoPurpose"/>
    <rdfs:label xml:lang="en">TIP event has purpose</rdfs:label>
    <rdfs:label xml:lang="es">el evento de trata tiene el propósito</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a TIP event to one of its Palermo Purposes. ICS-TIP requires at least one purpose per event.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#InPersonLureScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">In-person lure scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de citación presencial</rdfs:label>
    <rdfs:comment xml:lang="en">The offer exists solely to bring the candidate to a physical location under the appearance of a hiring event or interview. The real purpose is kidnapping, assault, sexual violence or femicide. Characterised by plausible role, nameless company, multi-use building address, request to come alone and without identification. Documented archetypal case: Edith Guadalupe Valdez Saldívar, Benito Juárez CDMX, April 2026.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#schemeTargetsGender">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Gender"/>
    <rdfs:label xml:lang="en">scheme targets gender</rdfs:label>
    <rdfs:label xml:lang="es">el esquema apunta al género</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a fraud scheme to the gender it preferentially targets.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#MeansPaymentOrBenefit">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoMeans"/>
    <rdfs:label xml:lang="en">Giving or receiving of payments or benefits to obtain consent</rdfs:label>
    <rdfs:label xml:lang="es">Dar o recibir pagos o beneficios para obtener consentimiento</rdfs:label>
    <rdfs:comment xml:lang="en">The MEANS 'giving or receiving of payments or benefits to achieve the consent of a person having control over another person' in the sense of Palermo Protocol Article 3(a).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#FalseDocumentation">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#DocumentationType"/>
    <rdfs:label xml:lang="en">False documentation</rdfs:label>
    <rdfs:label xml:lang="es">Documentación falsa</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://bioportal.bioontology.org/ontologies/HUTRO"/>
    <skos:closeMatch rdf:resource="https://bioportal.bioontology.org/ontologies/HUTROfalse_documentation"/>
    <skos:note xml:lang="en">Close match to the HUTRO concept 'false documentation' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'False Documentation'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile.</skos:note>
    <rdfs:comment xml:lang="en">Documentation carried by a victim that was forged, altered or issued in another person's name. One of the values of :DocumentationType.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#RecruitmentPattern">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:label xml:lang="en">Recruitment pattern</rdfs:label>
    <rdfs:label xml:lang="es">Patrón de reclutamiento</rdfs:label>
    <rdfs:comment xml:lang="en">A pattern describing how the recruiter established contact with the candidate (social media, family, friend, intimate partner, abduction, classifieds, street).</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#victimMaritalStatus">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">marital status</rdfs:label>
    <rdfs:label xml:lang="es">estado civil</rdfs:label>
    <rdfs:comment xml:lang="en">ICS-TIP additional disaggregating variable. Controlled vocab: single, married, cohabiting, separated, divorced, widowed, unknown.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#routeLatestYear">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TraffickingRoute"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:gYear. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:gYear literals.</skos:note>
    <rdfs:label xml:lang="en">route latest year</rdfs:label>
    <rdfs:label xml:lang="es">año más reciente de la ruta</rdfs:label>
    <rdfs:comment xml:lang="en">Most recent year for which the route is attested in the source dataset.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#hasTitle">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">offer title</rdfs:label>
    <rdfs:label xml:lang="es">título de la oferta</rdfs:label>
    <rdfs:comment xml:lang="en">Title or headline of the job offer as published.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#patternDescription">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">pattern description</rdfs:label>
    <rdfs:label xml:lang="es">descripción del patrón</rdfs:label>
    <rdfs:comment xml:lang="en">Description of the survivor-testimony pattern in prose.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#RecruiterReplyComment">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaComment"/>
    <rdfs:label xml:lang="en">Recruiter reply comment</rdfs:label>
    <rdfs:label xml:lang="es">Respuesta del reclutador</rdfs:label>
    <rdfs:comment xml:lang="en">A short reply by the post author or an associated account redirecting to a private channel or welcoming the applicant (e.g. 'manda mensaje', 'DM', 'bienvenido cuando quieras'). Colmex 2025, images 4, 13-14 and 18.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#MLMHealthBeautyScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PyramidScheme"/>
    <rdfs:label xml:lang="en">Health / beauty MLM scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema multinivel de salud y belleza</rdfs:label>
    <rdfs:comment xml:lang="en">A multi-level marketing operation centred on nutritional supplements, cosmetics, slimming products or wellness programmes. Presented as an employment or business opportunity, in practice the participant earns only by recruiting further 'distributors' and by purchasing inventory that cannot be sold on the open market. Canonical examples in Latin America include product lines marketed through Facebook groups and WhatsApp chains.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#detectedBy">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#RedFlag"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary: rule, nlp, human.</rdfs:comment>
    <rdfs:label xml:lang="en">detected by</rdfs:label>
    <rdfs:label xml:lang="es">detectado por</rdfs:label>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#GangRecruitmentSchoolsScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#ChildRecruitmentCriminalScheme"/>
    <rdfs:label xml:lang="en">Gang recruitment at schools scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de reclutamiento de pandillas o cárteles en escuelas</rdfs:label>
    <rdfs:comment xml:lang="en">Specific subtype of child recruitment where the entry point is the school ground or school exit. Recruiters are often students slightly older than the target or adults posing as relatives. Common in Central America (MS-13, Barrio 18) and in Mexican states with heavy cartel presence (Michoacán, Guerrero, Jalisco, Tamaulipas). The Gobierno de Zapopan published a public prevention programme in 2026. The Ramona press corpus holds 26 items from REDIM's data and advocacy blog (count recomputed 10 November 2026 from data/processed/press_summary.json).</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://www.zapopan.gob.mx/v3/inclusion/noticias/policia-de-zapopan-refuerza-acciones-preventivas-contra-la-desaparicion-de-personas-y-el"/>
    <rdfs:seeAlso rdf:resource="http://web.archive.org/web/20260723014408/https://www.zapopan.gob.mx/v3/inclusion/noticias/policia-de-zapopan-refuerza-acciones-preventivas-contra-la-desaparicion-de-personas-y-el"/>
    <rdfs:seeAlso rdf:resource="https://blog.derechosinfancia.org.mx/"/>
    <skos:note xml:lang="en">Checked 10 November 2026: the zapopan.gob.mx page does not respond. The Internet Archive snapshot of 23 July 2026 is cited alongside it.</skos:note>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#AgriculturalBondageScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Agricultural labour bondage scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de servidumbre en trabajo agrícola</rdfs:label>
    <rdfs:comment xml:lang="en">Offer of seasonal agricultural work (jornalero, harvest, produce packing) that leads to wage theft, deductions for housing and food that exceed the wage, confiscation of identification documents, and restriction of movement through geographic isolation. Documented by ILO, UNODC and the Polaris Project in the US-Mexico corridor (fresh produce, coffee, tomato) and in internal Mexican migration from southern states to Sinaloa, Sonora and Baja California. The CTDC dataset registers agricultural labour as a distinct exploitation subtype.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://www.unodc.org/documents/human-trafficking/2015/Recruitment_Fees_Report-Final-22_June_2015_AG_Final.pdf"/>
    <rdfs:seeAlso rdf:resource="https://polarisproject.org/"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#sourceAuthor">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">source author</rdfs:label>
    <rdfs:label xml:lang="es">autor de la fuente</rdfs:label>
    <rdfs:comment xml:lang="en">Author of the evidence source, where the source names one.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#countryISOCode">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Country"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">country ISO code</rdfs:label>
    <rdfs:label xml:lang="es">código ISO del país</rdfs:label>
    <rdfs:comment xml:lang="en">ISO 3166-1 code of the country.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#routeIsTransnational">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TraffickingRoute"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:boolean. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:boolean literals.</skos:note>
    <rdfs:label xml:lang="en">route is transnational</rdfs:label>
    <rdfs:label xml:lang="es">la ruta es transnacional</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the route crosses an international border. Internal routes matter in Mexico, where most documented recruitment-to-exploitation movement is domestic.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#riskScore">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">risk score</rdfs:label>
    <rdfs:label xml:lang="es">puntuación de riesgo</rdfs:label>
    <rdfs:comment xml:lang="en">Aggregate risk score computed for the offer by the classifier version recorded on the classification.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#itemHasSignal">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SocialMediaItem"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#SocialMediaRecruitmentSignal"/>
    <rdfs:label xml:lang="en">item has signal</rdfs:label>
    <rdfs:label xml:lang="es">tiene señal</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a social-media item to a recruitment signal detected in it.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#transportedBy">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#TransportationMeans"/>
    <rdfs:label xml:lang="en">transported by</rdfs:label>
    <rdfs:label xml:lang="es">transportada por</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a victim to the means of transportation used to move them.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#ClassicRedFlagPattern">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:label xml:lang="en">Classic red-flag pattern</rdfs:label>
    <rdfs:label xml:lang="es">Patrón de bandera roja clásica</rdfs:label>
    <rdfs:comment xml:lang="en">A survivor-testimony pattern drawn from Ramona's 7-flag canonical taxonomy (high salary, flexible hours, no experience, upfront pay, urgent acceptance, distant interview, out-of-state job).</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#routeVictimCount">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TraffickingRoute"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">route victim count</rdfs:label>
    <rdfs:label xml:lang="es">número de víctimas en la ruta</rdfs:label>
    <rdfs:comment xml:lang="en">Number of CTDC-registered victims attested on this (origin, destination) pair.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#victimOfExploitation">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#TypeOfExploitation"/>
    <rdfs:label xml:lang="en">victim of exploitation type</rdfs:label>
    <rdfs:label xml:lang="es">víctima del tipo de explotación</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a victim to a type of exploitation they were subjected to.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#BelicoStoryPost">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#CriminalCultureExaltationPost"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#AcousticFramingPost"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#CriminalLifeAspirationPost"/>
    <rdfs:label xml:lang="en">Story: belicos (ECC*A*AVC)</rdfs:label>
    <rdfs:label xml:lang="es">Relato: belicos (ECC*A*AVC)</rdfs:label>
    <rdfs:comment xml:lang="en">Third recruitment story of Colmex 2025 (pp. 47-50). Persuades without an explicit offer (no NR). Sufficient condition ECC AND A AND AVC is computed in the mapping.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#NationalReachSignal">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaRecruitmentSignal"/>
    <rdfs:label xml:lang="en">National reach</rdfs:label>
    <rdfs:label xml:lang="es">Alcance nacional</rdfs:label>
    <rdfs:comment xml:lang="en">Recruits from anywhere in the country ('todo Mexico'). Colmex 2025, image 10.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#datasetName">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#OpenDatasetRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Name of the open dataset (e.g. CTDC, UNODC-GLOTIP, RNPDNO).</rdfs:comment>
    <rdfs:label xml:lang="en">dataset name</rdfs:label>
    <rdfs:label xml:lang="es">nombre del dataset</rdfs:label>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#OnlineCryptoJobScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Crypto / forex job scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de empleo cripto / forex</rdfs:label>
    <rdfs:comment xml:lang="en">Advertised as 'crypto trader', 'forex analyst', 'Web3 community manager' or 'blockchain assistant' with high salary, full remote and no experience required. Often used as cover for pay-to-work (candidate buys a 'training course' or deposits 'starting capital'), identity theft (KYC data collected for money-laundering accounts), or cross-border trafficking into Southeast Asian crypto-scam compounds.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#schemePalermoPurpose">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#PalermoPurpose"/>
    <rdfs:label xml:lang="en">scheme Palermo purpose</rdfs:label>
    <rdfs:label xml:lang="es">propósito de Palermo del esquema</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a fraud scheme to the Palermo Purpose that characterises it.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#historicalOfferCount">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Agent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">historical offer count</rdfs:label>
    <rdfs:label xml:lang="es">ofertas históricas</rdfs:label>
    <rdfs:comment xml:lang="en">Number of offers previously recorded for this agent in Ramona's own data.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#Recruitment">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoAction"/>
    <rdfs:label xml:lang="en">Recruitment (act)</rdfs:label>
    <rdfs:label xml:lang="es">Reclutamiento (acción)</rdfs:label>
    <rdfs:comment xml:lang="en">The ACT of recruitment in the sense of Palermo Protocol Article 3(a). In RATR-O it is the act that a deceptive job offer realises, which is why recruitment-stage fraud is in scope of a trafficking ontology and not only of a consumer-fraud one.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#offerTargetProfile">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">target profile</rdfs:label>
    <rdfs:label xml:lang="es">perfil buscado</rdfs:label>
    <rdfs:comment xml:lang="en">Profile the offer asks for, in the words of the offer, for example that the candidate come alone or be a young woman.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#offeredLocation">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">offered location</rdfs:label>
    <rdfs:label xml:lang="es">ubicación ofrecida</rdfs:label>
    <rdfs:comment xml:lang="en">Place of work as named in the offer, in the words of the offer.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#travelledWith">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#DocumentationType"/>
    <rdfs:label xml:lang="en">travelled with documentation</rdfs:label>
    <rdfs:label xml:lang="es">viajó con la documentación</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a victim to the type of documentation they travelled with.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#schemeFirstAttestedYear">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:gYear. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:gYear literals.</skos:note>
    <rdfs:label xml:lang="en">scheme first attested year</rdfs:label>
    <rdfs:label xml:lang="es">año en que se documentó el esquema por primera vez</rdfs:label>
    <rdfs:comment xml:lang="en">Earliest year in which the scheme is attested by one of the sources cited on it.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#PayToWorkScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Pay-to-work scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de pago por trabajar</rdfs:label>
    <rdfs:comment xml:lang="en">The candidate is asked to pay the recruiter or a third party before being hired, under the guise of onboarding fees, training, interview fees, uniform costs, administrative processing, background check, or starter kit. Often the candidate is never contacted again.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#recruitsFor">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Recruiter"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">recruits for scheme</rdfs:label>
    <rdfs:label xml:lang="es">recluta para el esquema</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a recruiter to the fraud scheme they recruit for.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#offerVerbatimQuote">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">verbatim quote of the offer</rdfs:label>
    <rdfs:label xml:lang="es">cita textual de la oferta</rdfs:label>
    <rdfs:comment xml:lang="en">Exact text of the advertisement or recruiter message as quoted by the source, verified as a literal substring.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#schemeTargetsAgeGroup">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#AgeGroup"/>
    <rdfs:label xml:lang="en">scheme targets age group</rdfs:label>
    <rdfs:label xml:lang="es">el esquema apunta al grupo etario</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a fraud scheme to the age group it preferentially targets.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#flagKeywordPattern">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#RedFlag"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">flag keyword pattern</rdfs:label>
    <rdfs:label xml:lang="es">patrón de palabras clave de la señal</rdfs:label>
    <rdfs:comment xml:lang="en">Regex used by the rule-based classifier.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#schemePreferredTool">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#CommunicationTool"/>
    <rdfs:label xml:lang="en">preferred communication tool for scheme</rdfs:label>
    <rdfs:label xml:lang="es">herramienta de comunicación preferida del esquema</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a fraud scheme to the communication tool most often used to run it, as documented in the sources cited on the scheme.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#ForcedChildMarriageScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#DebtBondageTraffickingScheme"/>
    <rdfs:label xml:lang="en">Forced child marriage scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de matrimonio infantil forzado</rdfs:label>
    <rdfs:comment xml:lang="en">The offer frames a minor's placement as marriage or an 'informal union' under customary practice (usos y costumbres). The Secretaría de las Mujeres de Oaxaca recognises this explicitly as a form of human trafficking. According to ENADID 2014, 44.82% of women in Chiapas, 42.41% in Guerrero and 39.17% in Oaxaca reported child marriage or early union. Recognised by UNICEF as a harmful practice and by UN Women as a form of gender-based violence. Maps to :PurposeServitude in the Palermo Protocol.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://www.oaxaca.gob.mx/sm/matrimonio-infantil-forzado-una-forma-de-trata-smo/"/>
    <rdfs:seeAlso rdf:resource="http://web.archive.org/web/20250224033853/https://www.oaxaca.gob.mx/sm/matrimonio-infantil-forzado-una-forma-de-trata-smo/"/>
    <rdfs:seeAlso rdf:resource="https://blog.derechosinfancia.org.mx/2022/01/28/matrimonio-y-union-temprana-en-ninas-y-mujeres-adolescentes-de-mexico/"/>
    <skos:note xml:lang="en">Checked 10 November 2026: the oaxaca.gob.mx page returns HTTP 500. The Internet Archive snapshot of 24 February 2025 is cited alongside it.</skos:note>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#ForeignLanguageTeacherScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Foreign-language teacher scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de maestro de idiomas en el extranjero</rdfs:label>
    <rdfs:comment xml:lang="en">The candidate is offered a teaching position abroad (typically Spanish in Asia or English in Latin America) with housing, visa and flight paid by the agency. On arrival the promised contract does not exist: the candidate is placed in a different role, forced to pay back 'travel expenses', has documents retained, or finds the school is a front for sex tourism or forced domestic work. Documented corridors include Mexico-China, Mexico-Korea, and Peru-Japan.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#Harbouring">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoAction"/>
    <rdfs:label xml:lang="en">Harbouring (act)</rdfs:label>
    <rdfs:label xml:lang="es">Acogida (acción)</rdfs:label>
    <rdfs:comment xml:lang="en">The ACT of harbouring in the sense of Palermo Protocol Article 3(a): keeping the person in a place under the control of the perpetrator.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#hasRecruitmentMethod">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#RecruitmentMethod"/>
    <rdfs:label xml:lang="en">has recruitment method</rdfs:label>
    <rdfs:label xml:lang="es">tiene método de reclutamiento</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a job offer to the recruitment method it uses, in the sense of the ICS-TIP recruitment-method variable.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#itemText">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SocialMediaItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">item text</rdfs:label>
    <rdfs:label xml:lang="es">texto del contenido</rdfs:label>
    <rdfs:comment xml:lang="en">Text of the social-media item, that is the caption of a post or the body of a comment.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#recruitedVia">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#RecruitmentMethod"/>
    <rdfs:label xml:lang="en">recruited via</rdfs:label>
    <rdfs:label xml:lang="es">reclutada a través de</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a victim to the recruitment method used on them.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#patternName">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">pattern name</rdfs:label>
    <rdfs:label xml:lang="es">nombre del patrón</rdfs:label>
    <rdfs:comment xml:lang="en">Short name of the survivor-testimony pattern.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#sourceUrl">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:label xml:lang="en">source URL</rdfs:label>
    <rdfs:label xml:lang="es">URL de la fuente</rdfs:label>
    <rdfs:comment xml:lang="en">URL of the evidence source.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#GroupEmojiSignal">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaRecruitmentSignal"/>
    <rdfs:label xml:lang="en">Group emoji</rdfs:label>
    <rdfs:label xml:lang="es">Emoji de grupo</rdfs:label>
    <rdfs:comment xml:lang="en">Emojis used as identity markers (devil, ninja, skull, salute, rooster). Colmex 2025, images 10, 17, 18, 19, 22.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#operatesIn">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Country"/>
    <rdfs:label xml:lang="en">scheme operates in country</rdfs:label>
    <rdfs:label xml:lang="es">el esquema opera en el país</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a fraud scheme to a country where it has been documented.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#tipEventHappenedIn">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TIPEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Country"/>
    <rdfs:label xml:lang="en">TIP event happened in country</rdfs:label>
    <rdfs:label xml:lang="es">el evento de trata ocurrió en el país</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a TIP event to the country where it took place.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#offerClassifierConfidence">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">offer classifier confidence</rdfs:label>
    <rdfs:label xml:lang="es">confianza del clasificador sobre la oferta</rdfs:label>
    <rdfs:comment xml:lang="en">Confidence reported by the classifier that produced the offer's risk assessment, on a zero-to-one scale.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#GigEconomyFakeDriverScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Gig-economy fake driver scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de conductor gig fraudulento</rdfs:label>
    <rdfs:comment xml:lang="en">The candidate is offered work as a ride-hailing or delivery driver for a platform (Uber, DiDi, Cabify, Beat, Rappi, DiDi Food). The recruiter provides a 'rented' vehicle on terms that include daily rent, insurance fees and maintenance charges. The arithmetic guarantees the driver ends each week in deficit, binding them through accumulating debt. The vehicle is often stolen or fraudulently registered and is used to extract labour under the threat of criminal complaint.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#sourceLanguage">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">source language ISO code</rdfs:label>
    <rdfs:label xml:lang="es">código ISO del idioma de la fuente</rdfs:label>
    <rdfs:comment xml:lang="en">ISO 639-1 code of the language the evidence source is written in.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#contactHash">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Recruiter"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">contact hash</rdfs:label>
    <rdfs:label xml:lang="es">hash de contacto</rdfs:label>
    <rdfs:comment xml:lang="en">SHA-256 digest of the recruiter's contact identifier. The digest lets the same contact be recognised across reports without storing the phone number or the account name.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#FatalismSignal">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaRecruitmentSignal"/>
    <rdfs:label xml:lang="en">Fatalism</rdfs:label>
    <rdfs:label xml:lang="es">Fatalismo</rdfs:label>
    <rdfs:comment xml:lang="en">Normalises early death or no exit ('quizas manana ya no este', 'de aqui ya no sales'). Colmex 2025, images 16 and 18.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#hasRiskClassification">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#RiskClassification"/>
    <rdfs:label xml:lang="en">has risk classification</rdfs:label>
    <rdfs:label xml:lang="es">tiene clasificación de riesgo</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a job offer to a risk classification produced for it. A single offer may carry several classifications, one per classifier version, which is why the classification is reified rather than stored as a literal on the offer.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#Transfer">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoAction"/>
    <rdfs:label xml:lang="en">Transfer (act)</rdfs:label>
    <rdfs:label xml:lang="es">Traslado (acción)</rdfs:label>
    <rdfs:comment xml:lang="en">The ACT of transfer in the sense of Palermo Protocol Article 3(a): handing control over the person from one party to another.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#offerPayAmount">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">offered pay amount</rdfs:label>
    <rdfs:label xml:lang="es">monto ofrecido</rdfs:label>
    <rdfs:comment xml:lang="en">Pay amount stated in the offer.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#offerOutcome">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">reported outcome</rdfs:label>
    <rdfs:label xml:lang="es">desenlace reportado</rdfs:label>
    <rdfs:comment xml:lang="en">Controlled vocabulary: rescate, desaparicion, explotacion_sexual, explotacion_laboral, fraude_economico, homicidio, detencion_reclutador, other.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#itemHashtags">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SocialMediaItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">item hashtags</rdfs:label>
    <rdfs:label xml:lang="es">hashtags</rdfs:label>
    <rdfs:comment xml:lang="en">Hashtags carried by the item, as a space-separated list.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#hasNationality">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#DemographicProfile"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Country"/>
    <rdfs:label xml:lang="en">has nationality</rdfs:label>
    <rdfs:label xml:lang="es">tiene nacionalidad</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a demographic profile to a country of nationality.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#CredibleLethalPattern">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:label xml:lang="en">Credible-lethal pattern</rdfs:label>
    <rdfs:label xml:lang="es">Patrón creíble-letal</rdfs:label>
    <rdfs:comment xml:lang="en">A survivor-testimony pattern where the offer itself looks plausible and the risk sits in the logistics of the first contact (nameless WhatsApp, multi-use building, 'come alone', 'no ID', Messenger-to-WhatsApp funnel, personal-data filter). Type B in Ramona's dual-track classification.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#itemPostedOn">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SocialMediaItem"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Platform"/>
    <rdfs:label xml:lang="en">item posted on</rdfs:label>
    <rdfs:label xml:lang="es">publicado en</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a social-media item to the platform it was posted on.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#flagType">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#RedFlag"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary of 7 red flags defined by Ramona AI: sueldo_alto, horarios_flexibles, sin_experiencia, pago_adelantado, aceptacion_urgente, entrevista_lejana_traslado, empleo_fuera_estado.</rdfs:comment>
    <rdfs:label xml:lang="en">flag type</rdfs:label>
    <rdfs:label xml:lang="es">tipo de bandera</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#audioDescription">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SocialMediaPost"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">audio description</rdfs:label>
    <rdfs:label xml:lang="es">descripción del audio</rdfs:label>
    <rdfs:comment xml:lang="en">Description of the audio track of the post, including the song used. The audio is recorded because in the Colmex corpus the belico soundtrack is part of what makes the post legible as a recruitment post.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#inLanguage">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Language"/>
    <rdfs:label xml:lang="en">in language</rdfs:label>
    <rdfs:label xml:lang="es">en el idioma</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a job offer to the language it is written in.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#victimHasChildrenCount">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">number of children</rdfs:label>
    <rdfs:label xml:lang="es">número de hijas e hijos</rdfs:label>
    <rdfs:comment xml:lang="en">ICS-TIP additional disaggregating variable.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#documentationTypeName">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#DocumentationType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary: national_id, passport, visa, work_permit, none, confiscated, false.</rdfs:comment>
    <rdfs:label xml:lang="en">documentation type name</rdfs:label>
    <rdfs:label xml:lang="es">nombre del tipo de documentación</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#sourceOutlet">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">source outlet</rdfs:label>
    <rdfs:label xml:lang="es">medio de la fuente</rdfs:label>
    <rdfs:comment xml:lang="en">Outlet, publisher or institution that issued the evidence source.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#schemeNamedAfterCase">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">scheme archetypal case name</rdfs:label>
    <rdfs:label xml:lang="es">caso arquetípico que da nombre al esquema</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the archetypal public case the scheme is named after. Used only for cases already public in the press.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#lexiconPattern">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#LexiconTerm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">detection pattern (regex)</rdfs:label>
    <rdfs:label xml:lang="es">patrón de detección (regex)</rdfs:label>
    <rdfs:comment xml:lang="en">Regular expression used to detect the lexicon term in item text.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
  <owl:Class rdf:about="https://w3id.org/ratr-o#GroupCodeSignal">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaRecruitmentSignal"/>
    <rdfs:label xml:lang="en">Group code</rdfs:label>
    <rdfs:label xml:lang="es">Codigo de grupo</rdfs:label>
    <rdfs:comment xml:lang="en">Coded reference to a criminal group ('4L', 'las 4 letras', NG emoji, 'la maña', 'la mz'). Colmex 2025, images 3, 4, 19, 22.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#SelfApplicationComment">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaComment"/>
    <rdfs:label xml:lang="en">Self-application comment</rdfs:label>
    <rdfs:label xml:lang="es">Comentario de autopostulacion</rdfs:label>
    <rdfs:comment xml:lang="en">A comment in which a user asks to join or offers themself to a criminal group (e.g. 'busco jale', 'que se ocupa para entrar', 'puedo entrar con 16'). Colmex 2025, images 2, 4, 13-15, 20 and 22.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#platformName">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Platform"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">platform name</rdfs:label>
    <rdfs:label xml:lang="es">nombre de la plataforma</rdfs:label>
    <rdfs:comment xml:lang="en">Name of the platform.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#observedInCountry">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Country"/>
    <rdfs:label xml:lang="en">pattern observed in country</rdfs:label>
    <rdfs:label xml:lang="es">patrón observado en el país</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a survivor-testimony pattern to a country where the pattern has been observed.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#EmotionalConnectionStoryPost">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#DirectRecruitmentPost"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#AcousticFramingPost"/>
    <rdfs:label xml:lang="en">Story: emotional connection (NR*A)</rdfs:label>
    <rdfs:label xml:lang="es">Relato: conexion emocional (NR*A)</rdfs:label>
    <rdfs:comment xml:lang="en">Second recruitment story of Colmex 2025 (pp. 43-47). Sufficient condition NR AND A is computed in the mapping.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#IdentityTheftScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Identity theft scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de robo de identidad</rdfs:label>
    <rdfs:comment xml:lang="en">The offer's purpose is to harvest the candidate's personal data (CURP, INE, bank details) to commit downstream fraud against the candidate or third parties. Hiring is never actually intended.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#victimCaseClosedAt">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Victim"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:date. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:date literals.</skos:note>
    <rdfs:label xml:lang="en">victim case closed at</rdfs:label>
    <rdfs:label xml:lang="es">fecha de cierre del caso de la víctima</rdfs:label>
    <rdfs:comment xml:lang="en">Date on which the case concerning the victim was closed by the registering institution.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
  <owl:Class rdf:about="https://w3id.org/ratr-o#TraffickingRisk">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#RiskClassification"/>
    <rdfs:label xml:lang="en">Trafficking recruitment risk</rdfs:label>
    <rdfs:label xml:lang="es">Riesgo de reclutamiento para trata</rdfs:label>
    <rdfs:comment xml:lang="en">Risk that the offer is recruitment for trafficking in persons in the sense of the Palermo Protocol: for forced labour, sexual exploitation, forced criminality, forced marriage or organ removal.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#routeUpdatedAt">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#TraffickingRoute"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">route record last updated at</rdfs:label>
    <rdfs:label xml:lang="es">última actualización del registro de la ruta</rdfs:label>
    <rdfs:comment xml:lang="en">Timestamp at which the route record was last updated from its source dataset.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#candidateDefraudedBy">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Candidate"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">candidate defrauded by scheme</rdfs:label>
    <rdfs:label xml:lang="es">candidato defraudado por el esquema</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a candidate to the fraud scheme they were defrauded by, as reconstructed from their report.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#FraudRisk">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#RiskClassification"/>
    <rdfs:label xml:lang="en">Labour fraud risk</rdfs:label>
    <rdfs:label xml:lang="es">Riesgo de fraude laboral</rdfs:label>
    <rdfs:comment xml:lang="en">Risk that the offer is a fraud designed to extract money, data or unpaid work from the candidate, without necessarily leading to trafficking or exploitation.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#hasVerifiedIdentity">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Employer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:boolean. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:boolean literals.</skos:note>
    <rdfs:label xml:lang="en">has verified identity</rdfs:label>
    <rdfs:label xml:lang="es">tiene identidad verificada</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the employer's legal identity was verified against a public register.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#lexiconIsVerbatim">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#LexiconTerm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:boolean. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:boolean literals.</skos:note>
    <rdfs:label xml:lang="en">verbatim from source</rdfs:label>
    <rdfs:label xml:lang="es">textual de la fuente</rdfs:label>
    <rdfs:comment xml:lang="en">true if the term appears literally in the source report; false if it is a project variant (spelling, generic hashtag).</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#platformCountry">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#Platform"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#Country"/>
    <rdfs:label xml:lang="en">platform country</rdfs:label>
    <rdfs:label xml:lang="es">país de la plataforma</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a platform to the country of its operator, used to establish which jurisdiction a takedown request falls under.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#offerPayCurrency">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">offered pay currency</rdfs:label>
    <rdfs:label xml:lang="es">moneda ofrecida</rdfs:label>
    <rdfs:comment xml:lang="en">ISO 4217 code of the currency the pay is stated in.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#MeansThreatOfForce">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoMeans"/>
    <rdfs:label xml:lang="en">Threat or use of force</rdfs:label>
    <rdfs:label xml:lang="es">Amenaza o uso de la fuerza</rdfs:label>
    <rdfs:comment xml:lang="en">The MEANS 'threat or use of force' in the sense of Palermo Protocol Article 3(a).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#RecruitmentHashtagSignal">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaRecruitmentSignal"/>
    <rdfs:label xml:lang="en">Recruitment hashtag</rdfs:label>
    <rdfs:label xml:lang="es">Hashtag de reclutamiento</rdfs:label>
    <rdfs:comment xml:lang="en">Hashtag #reclutamiento, used by Colmex 2025 as an entry point to the corpus (p. 27).</rdfs:comment>
  </owl:Class>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#associatedWithRoute">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#TraffickingRoute"/>
    <rdfs:label xml:lang="en">associated with route</rdfs:label>
    <rdfs:label xml:lang="es">asociada con la ruta</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a job offer to a trafficking route it is associated with, normally through the origin and destination it names.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#hasVulnerabilityFactor">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#DemographicProfile"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#VulnerabilityFactor"/>
    <rdfs:label xml:lang="en">has vulnerability factor</rdfs:label>
    <rdfs:label xml:lang="es">tiene factor de vulnerabilidad</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a demographic profile to a vulnerability factor, in the sense of the ICS-TIP vulnerability variable.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#Receipt">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#PalermoAction"/>
    <rdfs:label xml:lang="en">Receipt of persons (act)</rdfs:label>
    <rdfs:label xml:lang="es">Recepción de personas (acción)</rdfs:label>
    <rdfs:comment xml:lang="en">The ACT of receipt of persons in the sense of Palermo Protocol Article 3(a): taking the person into one's control at the end of a transfer.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#postedOn">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:note xml:lang="en">Intended datatype xsd:date. It is outside the OWL 2 QL datatype map, so the TBox declares rdfs:Literal and the mapping layer emits xsd:date literals.</skos:note>
    <rdfs:label xml:lang="en">posted on</rdfs:label>
    <rdfs:label xml:lang="es">publicado el</rdfs:label>
    <rdfs:comment xml:lang="en">Date on which the offer was published.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
  <owl:Class rdf:about="https://w3id.org/ratr-o#CommunicationPattern">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SurvivorTestimonyPattern"/>
    <rdfs:label xml:lang="en">Communication pattern</rdfs:label>
    <rdfs:label xml:lang="es">Patrón de comunicación</rdfs:label>
    <rdfs:comment xml:lang="en">A pattern describing which communication tool was used for the first or dominant contact (WhatsApp, Messenger, Telegram, SMS, in-person, etc.).</rdfs:comment>
  </owl:Class>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/ratr-o#offerScreenshotUrl">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:label xml:lang="en">offer screenshot URL</rdfs:label>
    <rdfs:label xml:lang="es">URL de la captura de pantalla de la oferta</rdfs:label>
    <rdfs:comment xml:lang="en">URL of the stored screenshot of the offer. Screenshots are kept because deceptive offers are typically deleted by the recruiter within days.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#leadsToExploitation">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#TypeOfExploitation"/>
    <rdfs:label xml:lang="en">leads to exploitation</rdfs:label>
    <rdfs:label xml:lang="es">conduce a explotación</rdfs:label>
    <rdfs:comment xml:lang="en">Only asserted when the offer has been confirmed to have produced an exploitation outcome (from press case or dataset confirmation).</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#PressArticle">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:label xml:lang="en">Press article</rdfs:label>
    <rdfs:label xml:lang="es">Artículo de prensa</rdfs:label>
    <rdfs:comment xml:lang="en">An item of journalism used as the evidence anchor for a documented case. A subclass of :EvidenceSource. Press records in RATR-O are aggregated at the article level, with outlet, title, URL and classification only, and carry no personal data about the people the article names.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#CommunicationTool">
    <rdfs:label xml:lang="en">Communication tool</rdfs:label>
    <rdfs:label xml:lang="es">Herramienta de comunicación</rdfs:label>
    <rdfs:comment xml:lang="en">A tool used for communication between recruiters, smugglers, traffickers or victims. Distinct from Platform because it describes the tool itself, not the platform it runs on.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://bioportal.bioontology.org/ontologies/HUTRO"/>
    <skos:closeMatch rdf:resource="https://bioportal.bioontology.org/ontologies/HUTROsmuggler_trafficker_communication_tools"/>
    <skos:note xml:lang="en">Close match to the HUTRO concept 'smuggler and trafficker communication tools' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Smuggler and Trafficker Communication Tools'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile. HUTRO omits the conjunction in the local name. Versions up to 1.10 of this file used smuggler_and_trafficker_communication_tools, which does not resolve.</skos:note>
    <skos:note xml:lang="en">Eight tools in the reference vocabulary. Of the 295 offers in the verified press corpus, 106 name the platform they were carried on: WhatsApp leads with 37 of those 106, which is 12.5% of the whole corpus. The figure of 21% in earlier versions of this note is not supported by the shipped data and is withdrawn. Counted on 10 November 2026.</skos:note>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#SocialMediaPost">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaItem"/>
    <rdfs:label xml:lang="en">Social-media post</rdfs:label>
    <rdfs:label xml:lang="es">Publicación en red social</rdfs:label>
    <rdfs:comment xml:lang="en">A video or image post with its overlay text, caption, hashtags and audio. Unit of analysis of the Colmex 2025 corpus.</rdfs:comment>
    <owl:disjointWith rdf:resource="https://w3id.org/ratr-o#SocialMediaComment"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#PalermoMeans">
    <rdfs:label xml:lang="en">Palermo Means</rdfs:label>
    <rdfs:label xml:lang="es">Medio (Palermo)</rdfs:label>
    <rdfs:comment xml:lang="en">The MEANS element of the Palermo Protocol Article 3(a) definition: 'the threat or use of force or other forms of coercion, of abduction, of fraud, of deception, of the abuse of power or of a position of vulnerability or of the giving or receiving of payments or benefits to achieve the consent of a person having control over another person'.</rdfs:comment>
    <skos:note xml:lang="en">Eight canonical sub-concepts from Article 3(a).</skos:note>
    <rdfs:seeAlso rdf:resource="https://www.ohchr.org/en/instruments-mechanisms/instruments/protocol-prevent-suppress-and-punish-trafficking-persons"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#TIPEvent">
    <rdfs:label xml:lang="en">TIP event</rdfs:label>
    <rdfs:label xml:lang="es">Evento de trata de personas</rdfs:label>
    <rdfs:comment xml:lang="en">A trafficking-in-persons event as defined by the International Classification Standard for Administrative Data on Trafficking in Persons (ICS-TIP, IOM and UNODC, 2023). The TIP event is the central unit of classification in ICS-TIP. In RATR-O a TIPEvent aggregates one victim with at least one Palermo Action, at least one Palermo Means, and at least one Palermo Purpose.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf"/>
    <skos:note xml:lang="en">Central unit of classification in ICS-TIP (IOM+UNODC 2023). Aggregates one Victim, at least one PalermoAction, one PalermoMeans and one PalermoPurpose.</skos:note>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#AcousticFramingPost">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaPost"/>
    <rdfs:label xml:lang="en">Acoustic framing post (A)</rdfs:label>
    <rdfs:label xml:lang="es">Publicación con acústica (A)</rdfs:label>
    <rdfs:comment xml:lang="en">Condition A of Colmex 2025: background music or sound (corridos belicos, gunfire, radio chatter) that gives an emotional frame to criminal activity.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#VulnerabilityFactor">
    <rdfs:seeAlso rdf:resource="https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf"/>
    <rdfs:seeAlso rdf:resource="https://bioportal.bioontology.org/ontologies/HUTRO"/>
    <rdfs:label xml:lang="en">Vulnerability factor</rdfs:label>
    <rdfs:label xml:lang="es">Factor de vulnerabilidad</rdfs:label>
    <rdfs:comment xml:lang="en">A socioeconomic, demographic or situational factor that increases the probability of a candidate accepting a high-risk offer.</rdfs:comment>
    <skos:closeMatch rdf:resource="https://bioportal.bioontology.org/ontologies/HUTROvulnerability_factor"/>
    <skos:note xml:lang="en">Close match to the HUTRO concept 'vulnerability factor' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Vulnerability Factor'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile.</skos:note>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#TypeOfExploitation">
    <rdfs:seeAlso rdf:resource="https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf"/>
    <rdfs:seeAlso rdf:resource="https://bioportal.bioontology.org/ontologies/HUTRO"/>
    <rdfs:label xml:lang="en">Type of exploitation</rdfs:label>
    <rdfs:label xml:lang="es">Tipo de explotación</rdfs:label>
    <rdfs:comment xml:lang="en">The exploitation outcome associated with a trafficking case. Controlled vocabulary covers labour, sexual, forced criminality, forced marriage, organ removal, mixed.</rdfs:comment>
    <skos:closeMatch rdf:resource="https://bioportal.bioontology.org/ontologies/HUTROtype_of_exploitation"/>
    <skos:note xml:lang="en">Close match to the HUTRO concept 'type of exploitation' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Type of exploitation'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile.</skos:note>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#CriminalRecruitmentOffer">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nb2683efd1b8049e5af353dc697f33cb6b2">
        <owl:onProperty rdf:resource="https://w3id.org/ratr-o#exhibitsFraudScheme"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/ratr-o#ForcedCriminalityScheme"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Criminal recruitment offer</rdfs:label>
    <rdfs:label xml:lang="es">Oferta de reclutamiento criminal</rdfs:label>
    <rdfs:comment xml:lang="en">A job offer whose purpose is to recruit into organised-crime activity (lookout, hitman, armed 'security', drug logistics), whatever the channel.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#TransportationMeans">
    <rdfs:label xml:lang="en">Transportation means</rdfs:label>
    <rdfs:label xml:lang="es">Medio de transporte</rdfs:label>
    <rdfs:comment xml:lang="en">The means of transport used at a stage of the trafficking route.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://bioportal.bioontology.org/ontologies/HUTRO"/>
    <skos:closeMatch rdf:resource="https://bioportal.bioontology.org/ontologies/HUTROtransportation_means"/>
    <skos:note xml:lang="en">Close match to the HUTRO concept 'transportation means' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Transportation Means'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile.</skos:note>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#CriminalCultureExaltationPost">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaPost"/>
    <rdfs:label xml:lang="en">Criminal-culture exaltation post (ECC)</rdfs:label>
    <rdfs:label xml:lang="es">Publicación con exaltación de la cultura criminal (ECC)</rdfs:label>
    <rdfs:comment xml:lang="en">Condition ECC of Colmex 2025: the post uses at least one iconographic symbol of criminal identity (weapons, armoured 'monstruas', tactical vests, convoys, group emblems).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#RecruitmentMethod">
    <rdfs:seeAlso rdf:resource="https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf"/>
    <rdfs:seeAlso rdf:resource="https://bioportal.bioontology.org/ontologies/HUTRO"/>
    <rdfs:label xml:lang="en">Recruitment method</rdfs:label>
    <rdfs:label xml:lang="es">Método de reclutamiento</rdfs:label>
    <rdfs:comment xml:lang="en">The mechanism by which a potential victim is initially approached and enlisted into a trafficking or fraudulent-employment scheme.</rdfs:comment>
    <skos:closeMatch rdf:resource="https://bioportal.bioontology.org/ontologies/HUTROrecuritment_method"/>
    <skos:note xml:lang="en">Close match to the HUTRO concept 'recruitment method' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Recruitment Method'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile. The local name reproduces the spelling used in HUTRO, recuritment_method, which is misspelt at the source. Versions up to 1.10 of this file used the corrected spelling, which does not resolve.</skos:note>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#OpenDatasetRecord">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:label xml:lang="en">Open dataset record</rdfs:label>
    <rdfs:label xml:lang="es">Registro de dataset abierto</rdfs:label>
    <rdfs:comment xml:lang="en">A single anonymised case record drawn from an open anti-trafficking dataset such as CTDC or UNODC.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#DocumentationType">
    <rdfs:label xml:lang="en">Documentation type</rdfs:label>
    <rdfs:label xml:lang="es">Tipo de documentación</rdfs:label>
    <rdfs:comment xml:lang="en">An identity or travel document demanded or withheld during recruitment. Includes the case of falsified documents.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://bioportal.bioontology.org/ontologies/HUTRO"/>
    <skos:closeMatch rdf:resource="https://bioportal.bioontology.org/ontologies/HUTROdocumentation_type"/>
    <skos:note xml:lang="en">Close match to the HUTRO concept 'documentation type' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Documentation Type'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile.</skos:note>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#ForcedCriminalityScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Forced criminality scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de reclutamiento para criminalidad forzada</rdfs:label>
    <rdfs:comment xml:lang="en">Offer advertised as 'private security', 'bodyguard', 'armed escort', 'watchman at a ranch' or 'warehouse security' with atypically high salary. The real purpose is enlistment into organised-crime armed structures, most notably as halcones, sicarios, or coca-processing labour. Archetypal Mexican case: the CJNG Rancho Izaguirre (Teuchitlán, Jalisco) recruiting scheme of 2024-2025.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#Victim">
    <rdfs:seeAlso rdf:resource="https://www.unodc.org/unodc/data-and-analysis/glotip.html"/>
    <rdfs:seeAlso rdf:resource="https://www.ctdatacollaborative.org/page/global-synthetic-dataset"/>
    <rdfs:label xml:lang="en">Victim</rdfs:label>
    <rdfs:label xml:lang="es">Víctima</rdfs:label>
    <rdfs:comment xml:lang="en">A person documented as having been exploited or attempted-to-be-exploited in a trafficking or fraudulent-employment scheme. Sourced from anonymised CTDC records and publicly reported press cases.</rdfs:comment>
    <skos:note xml:lang="en">Victim records come from CTDC v2025 (the IOM differential-privacy synthetic release) and from anonymised press case references, loaded by scripts/ingest_ctdc.py. The seed files in db/ create the victim tables but populate none of them, because the CTDC release is not redistributed in this repository. Until that script is run the 18 victim mappings produce nothing and the queries that rest on them return no rows; docs/MAPPING_COVERAGE.md lists which.</skos:note>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#SocialMediaRecruitmentSignal">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#RedFlag"/>
    <rdfs:label xml:lang="en">Social-media recruitment signal</rdfs:label>
    <rdfs:label xml:lang="es">Señal de reclutamiento en redes</rdfs:label>
    <rdfs:comment xml:lang="en">A textual or symbolic cue in a social-media item associated with criminal recruitment. Derived from the lexicon in data/lexicon/tiktok_reclutamiento_lexicon.csv (Colmex 2025).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#Submission">
    <rdfs:label xml:lang="en">Submission</rdfs:label>
    <rdfs:label xml:lang="es">Solicitud</rdfs:label>
    <rdfs:comment xml:lang="en">An act by a Candidate of submitting an offer for Ramona verification.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/ratr-o#exhibitsFraudScheme">
    <rdfs:domain rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">exhibits fraud scheme</rdfs:label>
    <rdfs:label xml:lang="es">presenta esquema de fraude</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a job offer to the named fraud scheme it instantiates.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/ratr-o#ChildRecruitmentCriminalScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#ForcedCriminalityScheme"/>
    <rdfs:label xml:lang="en">Child recruitment into criminal organisations</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de reclutamiento infantil por grupos delictivos</rdfs:label>
    <rdfs:comment xml:lang="en">Recruitment of minors by organised-crime organisations as halcones (lookouts), runners, enforcers, or in the production and logistics of drug trafficking. Extensively documented in Mexico by REDIM (Red por los Derechos de la Infancia en México) in their 2010-2024 series. Recognised by the CNDH and ongoing federal legislative debate. Entry points include offers disguised as 'security', 'warehouse work' or 'deliveries', plus in-school contact and social-media grooming. UNICEF treats recruitment of minors by armed groups as a grave violation.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://blog.derechosinfancia.org.mx/2025/12/09/reclutamiento-y-utilizacion-de-ninas-ninos-y-adolescentes-por-agrupaciones-delictivas-en-mexico-2010-2024/"/>
    <rdfs:seeAlso rdf:resource="https://blog.derechosinfancia.org.mx/2025/12/10/reclutamiento-y-utilizacion-de-ninas-ninos-y-adolescentes-por-agrupaciones-delictivas-en-michoacan-2010-2024/"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#Gender">
    <rdfs:label xml:lang="en">Gender</rdfs:label>
    <rdfs:label xml:lang="es">Género</rdfs:label>
    <rdfs:comment xml:lang="en">The gender recorded for a demographic profile or targeted by a fraud scheme. Modelled as a class of individuals rather than a literal so that the value set stays open and can be aligned to the categories of external datasets without changing the TBox.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#EvidenceSource">
    <rdfs:label xml:lang="en">Evidence source</rdfs:label>
    <rdfs:label xml:lang="es">Fuente de evidencia</rdfs:label>
    <rdfs:comment xml:lang="en">A public document or case file from which a pattern, route, offer or victim record was derived (e.g. press article, CTDC record, NGO report).</rdfs:comment>
    <skos:note xml:lang="en">Provenance chain. 1,337 evidence sources in the seeds, 1,335 of them press articles. 1,325 of the 1,379 rows of ramona.offers carry :offerDocumentedIn (db/13_offer_provenance.sql); the 47 hand-curated offers do not, because the seeds do not record which of the five curated sources each came from, and 7 synthesised offers find no matching source. Routes and patterns carry :hasEvidenceSource. Counted on 10 November 2026.</skos:note>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#SocialMediaComment">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaItem"/>
    <rdfs:label xml:lang="en">Social-media comment</rdfs:label>
    <rdfs:label xml:lang="es">Comentario en red social</rdfs:label>
    <rdfs:comment xml:lang="en">A comment published under a post. Colmex 2025 documents that recruitment interaction frequently happens in comments rather than in the post itself.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#FraudScheme">
    <rdfs:label xml:lang="en">Fraud scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de fraude</rdfs:label>
    <rdfs:comment xml:lang="en">A named operational pattern by which a fraudulent job offer harms the candidate. Independent of the RiskClassification axes: a single offer can exhibit one or more named schemes.</rdfs:comment>
    <skos:note xml:lang="en">26 subclasses in all, 21 of them direct. 15 are attested in the verified press corpus; the rest are declared for schemes documented in official sources but not yet matched by a row. Counted against the ontology and the seed files on 10 November 2026.</skos:note>
    <rdfs:seeAlso rdf:resource="https://ramonaaliadalaboral.com/"/>
    <rdfs:seeAlso rdf:resource="https://www.unodc.org/unodc/en/human-trafficking/faqs.html"/>
    <rdfs:seeAlso rdf:resource="https://www.ilo.org/publications/caught-sea-forced-labour-and-trafficking-fisheries"/>
    <rdfs:seeAlso rdf:resource="https://fifpro.org/en/supporting-players/safe-working-environments/human-trafficking/"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#TraffickingRoute">
    <rdfs:seeAlso rdf:resource="https://www.unodc.org/documents/data-and-analysis/tip/2023/ICS-TIP_2023-v4.pdf"/>
    <rdfs:seeAlso rdf:resource="https://bioportal.bioontology.org/ontologies/HUTRO"/>
    <rdfs:label xml:lang="en">Trafficking route</rdfs:label>
    <rdfs:label xml:lang="es">Ruta de trata</rdfs:label>
    <skos:closeMatch rdf:resource="https://bioportal.bioontology.org/ontologies/HUTROtrafficking_transit_places"/>
    <skos:note xml:lang="en">Close match to the HUTRO concept 'trafficking transit places' (Human Trafficking Ontology, Danial Zemchal Tesfahans, BioPortal submission 1 of 22 April 2025, status alpha, SKOS format). The concept IRI was verified on 10 November 2026 in the BioPortal concept browser, which reports it as the concept Id and resolves it to the preferred label 'Trafficking Transit Places'. HUTRO concepts are skos:Concept instances that also carry owl:NamedIndividual, so the match is recorded as an annotation assertion on this class rather than as an OWL object-property assertion, which keeps the ontology inside the OWL 2 QL profile.</skos:note>
    <skos:note xml:lang="en">1,778 routes in the seeds: 1,771 CTDC corridors, each with at least 3 victims, plus 7 routes attested in the press and curated by hand. Both sets are keyed by ISO 3166-1 alpha-3. Counted against the seed files on 10 November 2026.</skos:note>
    <rdfs:comment xml:lang="en">An origin-to-destination pair, optionally with stopover countries, along which victims are moved. Routes in the demonstrator are derived from aggregated citizenship and country-of-exploitation pairs in the CTDC global synthetic dataset, never from individual case records.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#PalermoPurpose">
    <rdfs:label xml:lang="en">Palermo Purpose</rdfs:label>
    <rdfs:label xml:lang="es">Finalidad (Palermo)</rdfs:label>
    <rdfs:comment xml:lang="en">The PURPOSE element of the Palermo Protocol Article 3(a): 'for the purpose of exploitation', which the Protocol exemplifies as 'the exploitation of the prostitution of others or other forms of sexual exploitation, forced labour or services, slavery or practices similar to slavery, servitude or the removal of organs'.</rdfs:comment>
    <skos:note xml:lang="en">Five canonical sub-concepts from Article 3(a).</skos:note>
    <rdfs:seeAlso rdf:resource="https://www.ohchr.org/en/instruments-mechanisms/instruments/protocol-prevent-suppress-and-punish-trafficking-persons"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#Employer">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#Agent"/>
    <rdfs:label xml:lang="en">Employer</rdfs:label>
    <rdfs:label xml:lang="es">Empleador</rdfs:label>
    <rdfs:comment xml:lang="en">The organisation or natural person named in a job offer as the party that would employ the candidate. Kept disjoint from :Recruiter so that offers where the two coincide must assert both roles explicitly, and offers that impersonate a real company can be distinguished from offers made by that company.</rdfs:comment>
    <owl:disjointWith rdf:resource="https://w3id.org/ratr-o#Recruiter"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#RedFlag">
    <rdfs:label xml:lang="en">Red flag</rdfs:label>
    <rdfs:label xml:lang="es">Bandera roja</rdfs:label>
    <rdfs:comment xml:lang="en">A detected indicator of potential fraud or trafficking recruitment risk. Seven canonical flags are defined by Ramona AI.</rdfs:comment>
    <skos:note xml:lang="en">Seven canonical Ramona flags plus 50 deep-textual patterns extracted from press corpus.</skos:note>
    <rdfs:seeAlso rdf:resource="https://ramonaaliadalaboral.com/"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#DirectRecruitmentPost">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaPost"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#JobOffer"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nb2683efd1b8049e5af353dc697f33cb6b1">
        <owl:onProperty rdf:resource="https://w3id.org/ratr-o#exhibitsFraudScheme"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/ratr-o#ForcedCriminalityScheme"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#CriminalRecruitmentOffer"/>
    <rdfs:label xml:lang="en">Direct recruitment post (NR)</rdfs:label>
    <rdfs:label xml:lang="es">Publicación con narrativa de reclutamiento directo (NR)</rdfs:label>
    <rdfs:comment xml:lang="en">Condition NR of Colmex 2025: the post explicitly invites the audience to join a criminal group (e.g. 'Quieres jale? Todavia hay plazas', 'seguimos con el reclutamiento activo'). Such a post is a job offer, and every such offer exhibits some forced-criminality scheme (existential axiom, allowed on the right-hand side in OWL 2 QL).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#PyramidScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Pyramid / MLM scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema piramidal / multinivel</rdfs:label>
    <rdfs:comment xml:lang="en">The candidate's actual income depends on recruiting further candidates, not on the advertised job. Covers classic pyramid schemes and multi-level-marketing operations disguised as employment.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#DemographicProfile">
    <rdfs:label xml:lang="en">Demographic profile</rdfs:label>
    <rdfs:label xml:lang="es">Perfil demográfico</rdfs:label>
    <rdfs:comment xml:lang="en">An anonymised demographic description of a victim or candidate, covering age group, gender, nationality and education.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#CriminalLifeAspirationPost">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#SocialMediaPost"/>
    <rdfs:label xml:lang="en">Criminal-life aspiration post (AVC)</rdfs:label>
    <rdfs:label xml:lang="es">Publicación con aspiración a la vida criminal (AVC)</rdfs:label>
    <rdfs:comment xml:lang="en">Condition AVC of Colmex 2025: the post expresses the desire to join criminal life as a life project (e.g. 'Al unico circulo social que me interesa pertenecer (en proceso)', 'Disfruto mi vida quizas manana ya no este').</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#DominanceBucket">
    <rdfs:label xml:lang="en">Dominance bucket</rdfs:label>
    <rdfs:label xml:lang="es">Rango de dominancia</rdfs:label>
    <rdfs:comment xml:lang="en">A qualitative frequency band used to describe how often a pattern is observed in the observatory corpus: hot is at least 5 percent of cases, warm is 1 to 5 percent, cold is below 1 percent. The band is a class with one individual per value so that a query can group patterns by band; :dominanceBucketValue carries the same information as a literal for clients that do not traverse the object property.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#SurvivorTestimonyPattern">
    <rdfs:label xml:lang="en">Survivor testimony pattern</rdfs:label>
    <rdfs:label xml:lang="es">Patrón de testimonio de sobreviviente</rdfs:label>
    <rdfs:comment xml:lang="en">A recurring linguistic or logistical pattern extracted from survivor interviews or documented cases.</rdfs:comment>
    <skos:note xml:lang="en">95 patterns in the seeds. 88 carry one of six kind values: classic_a (5), credible_b (7), communication (7), recruitment (9), exploitation (10), deep_textual (50); 7 carry none. Five of the six kinds have a subclass here; deep_textual has none and is read off :patternHasKind. Counted against the seed files on 10 November 2026.</skos:note>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#DebtBondageTraffickingScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#FraudScheme"/>
    <rdfs:label xml:lang="en">Debt bondage trafficking scheme</rdfs:label>
    <rdfs:label xml:lang="es">Esquema de trata con deuda</rdfs:label>
    <rdfs:comment xml:lang="en">The offer relocates the candidate to a destination where exploitation is performed, often across borders, and binds the victim through a manufactured debt: smuggling fees, transportation, housing, paperwork. Covers the Tapachula-to-United States labour-exploitation corridor, the Latin-America-to-Western-Europe sex-trafficking pattern (e.g. falsely advertised childcare jobs in Paris), and domestic-work trafficking with document retention.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#Country">
    <rdfs:label xml:lang="en">Country</rdfs:label>
    <rdfs:label xml:lang="es">País</rdfs:label>
    <rdfs:comment xml:lang="en">A country or territory used as the origin, destination, stopover or jurisdiction of an offer, a route, a platform, a recruiter or a TIP event. Identified by its ISO 3166-1 code through :countryISOCode.</rdfs:comment>
    <skos:note xml:lang="en">248 countries and territories loaded from the ISO 3166-1 tables through pycountry (db/08_enriched_countries.sql); 92 of them are attested in the CTDC corridors. Counted against the seed files on 10 November 2026.</skos:note>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#Platform">
    <rdfs:label xml:lang="en">Platform</rdfs:label>
    <rdfs:label xml:lang="es">Plataforma</rdfs:label>
    <rdfs:comment xml:lang="en">A digital service on which a job offer or a social-media item is published or through which first contact happens (for example a social network, a messaging application or a job board). Platform identity is recorded because the channel is one of the few attributes present in almost every report Ramona receives.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#ResearchReport">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#EvidenceSource"/>
    <rdfs:label xml:lang="en">Research report</rdfs:label>
    <rdfs:label xml:lang="es">Informe de investigacion</rdfs:label>
    <rdfs:comment xml:lang="en">A published academic or civil-society research report used as evidence for patterns, lexicon terms or schemes.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#SocialMediaItem">
    <rdfs:label xml:lang="en">Social-media item</rdfs:label>
    <rdfs:label xml:lang="es">Contenido en red social</rdfs:label>
    <rdfs:comment xml:lang="en">A unit of content observed on a social-media platform: a post (video, image, caption) or a comment under a post.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#Recruiter">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#Agent"/>
    <rdfs:label xml:lang="en">Recruiter</rdfs:label>
    <rdfs:label xml:lang="es">Reclutador</rdfs:label>
    <rdfs:comment xml:lang="en">An agent that makes first contact with a candidate and conducts the recruitment interaction, whether or not it is the party that would employ the candidate. Disjoint with :Employer, because in Ramona's casework the deceptive party is typically the recruiter and the named employer either does not exist or is impersonated.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#Language">
    <rdfs:label xml:lang="en">Language</rdfs:label>
    <rdfs:label xml:lang="es">Idioma</rdfs:label>
    <rdfs:comment xml:lang="en">A natural language in which an offer, a social-media item or an evidence source is written. Identified by its ISO 639-1 code through :languageISOCode.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#CredibleLethalRedFlag">
    <rdfs:subClassOf rdf:resource="https://w3id.org/ratr-o#RedFlag"/>
    <rdfs:label xml:lang="en">Credible-lethal red flag (Type B)</rdfs:label>
    <rdfs:label xml:lang="es">Bandera roja creible-letal (Tipo B)</rdfs:label>
    <rdfs:comment xml:lang="en">A logistic signal inside an otherwise plausible offer: nameless company, WhatsApp without logo, meeting in a multi-use building, asked to come alone or without ID, Messenger-to-WhatsApp funnel, atypical hours, personal-data harvesting, plausible bait role, last-minute relocation. The value is in :flagType.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#LexiconTerm">
    <rdfs:label xml:lang="en">Lexicon term</rdfs:label>
    <rdfs:label xml:lang="es">Término del léxico</rdfs:label>
    <rdfs:comment xml:lang="en">A word, phrase, emoji or hashtag used in recruitment content, with a detection pattern and provenance. Instances are loaded from data/lexicon/tiktok_reclutamiento_lexicon.csv.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#PalermoAction">
    <rdfs:label xml:lang="en">Palermo Action</rdfs:label>
    <rdfs:label xml:lang="es">Acción (Palermo)</rdfs:label>
    <rdfs:comment xml:lang="en">The ACT element of the Palermo Protocol Article 3(a) definition of trafficking in persons: 'the recruitment, transportation, transfer, harbouring or receipt of persons'.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://www.ohchr.org/en/instruments-mechanisms/instruments/protocol-prevent-suppress-and-punish-trafficking-persons"/>
    <skos:note xml:lang="en">Five canonical sub-concepts from Article 3(a) of the Palermo Protocol.</skos:note>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#AgeGroup">
    <rdfs:label xml:lang="en">Age group</rdfs:label>
    <rdfs:label xml:lang="es">Grupo etario</rdfs:label>
    <rdfs:comment xml:lang="en">A coarse age bucket aligned to CTDC: 0-8, 9-17, 18-20, 21-23, 24-26, 27-29, 30-38, 39-47, 48+.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#Candidate">
    <rdfs:label xml:lang="en">Candidate</rdfs:label>
    <rdfs:label xml:lang="es">Candidato</rdfs:label>
    <rdfs:comment xml:lang="en">User who submitted an offer to Ramona for verification.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#RiskClassification">
    <rdfs:label xml:lang="en">Risk classification</rdfs:label>
    <rdfs:label xml:lang="es">Clasificación de riesgo</rdfs:label>
    <rdfs:comment xml:lang="en">An assessment of an offer along Ramona's risk axes. Three independent dimensions are covered, each modelled as a subclass: :FraudRisk, :ExploitationRisk and :TraffickingRisk.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#JobOffer">
    <rdfs:label xml:lang="en">Job offer</rdfs:label>
    <rdfs:label xml:lang="es">Oferta laboral</rdfs:label>
    <rdfs:comment xml:lang="en">A posting advertising employment, submitted to Ramona or harvested from public channels.</rdfs:comment>
    <skos:note xml:lang="en">1,674 :JobOffer individuals in the seeds: 47 hand-curated Ramona cases and 1,332 offers synthesised from classified press articles (ramona.offers, 1,379 rows), plus 295 offers extracted from the verified press corpus (ramona.press_offers). Earlier versions of this note claimed 2,050, counting 50 curated cases and 668 offers synthesised from CTDC records; the seeds contain 47 curated cases and no CTDC-synthesised offers. Counted against the seed files on 10 November 2026.</skos:note>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/ratr-o#Agent">
    <rdfs:label xml:lang="en">Agent</rdfs:label>
    <rdfs:label xml:lang="es">Agente</rdfs:label>
    <rdfs:comment xml:lang="en">An actor who can post or be associated with a job offer.</rdfs:comment>
  </owl:Class>
</rdf:RDF>
