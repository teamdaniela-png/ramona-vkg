mappingId   M-Legit-Offer
target      <https://w3id.org/ratr-o/data/legit-offer/{legit_id}> a :JobOffer ; :offeredRole {job_title}^^xsd:string ; :offeredByEmployer <https://w3id.org/ratr-o/data/legit-offer/{legit_id}/employer> ; :offerDocumentedIn <https://w3id.org/ratr-o/data/legit-offer/{legit_id}/posting> .
source      SELECT legit_id, job_title FROM ramona.legit_offers

mappingId   M-Legit-Country
target      <https://w3id.org/ratr-o/data/legit-offer/{legit_id}> :inCountry <https://w3id.org/ratr-o/data/country/{country_iso3}> .
source      SELECT l.legit_id, c.country_iso3 FROM ramona.legit_offers l JOIN ramona.countries c ON c.country_code = l.country_code

mappingId   M-Legit-Location
target      <https://w3id.org/ratr-o/data/legit-offer/{legit_id}> :offeredLocation {offer_location}^^xsd:string .
source      SELECT legit_id, offer_location FROM ramona.legit_offers WHERE offer_location IS NOT NULL

mappingId   M-Legit-WeeklyMXN
target      <https://w3id.org/ratr-o/data/legit-offer/{legit_id}> :offeredSalaryMXN {weekly_mxn}^^xsd:decimal .
source      SELECT legit_id, weekly_mxn FROM ramona.legit_offers WHERE weekly_mxn IS NOT NULL

mappingId   M-Legit-Platform
target      <https://w3id.org/ratr-o/data/legit-offer/{legit_id}> :postedVia <https://w3id.org/ratr-o/data/platform/{platform_id}> .
source      SELECT legit_id, platform_id FROM ramona.legit_offers

mappingId   M-Legit-Employer
target      <https://w3id.org/ratr-o/data/legit-offer/{legit_id}/employer> a :Employer ; :agentName {employer_name}^^xsd:string ; :hasVerifiedIdentity {employer_verified}^^xsd:boolean .
source      SELECT legit_id, employer_name, employer_verified FROM ramona.legit_offers

mappingId   M-Legit-Posting
target      <https://w3id.org/ratr-o/data/legit-offer/{legit_id}/posting> a :EvidenceSource ; :sourceOutlet {board}^^xsd:string ; :sourceKind {source_kind}^^xsd:string .
source      SELECT legit_id, board, 'job_board_posting' AS source_kind FROM ramona.legit_offers

mappingId   M-Legit-PostingUrl
target      <https://w3id.org/ratr-o/data/legit-offer/{legit_id}/posting> :sourceUrl {posting_url}^^xsd:anyURI .
source      SELECT legit_id, posting_url FROM ramona.legit_offers WHERE posting_url IS NOT NULL

mappingId   M-Legit-Flag
target      <https://w3id.org/ratr-o/data/legit-offer/{legit_id}> :hasRedFlag <https://w3id.org/ratr-o/data/legit-offer/{legit_id}/flag/{flag}> .
source      SELECT legit_id, flag FROM ramona.legit_offer_flags

mappingId   M-Legit-FlagType
target      <https://w3id.org/ratr-o/data/legit-offer/{legit_id}/flag/{flag}> :flagType {flag}^^xsd:string .
source      SELECT legit_id, flag FROM ramona.legit_offer_flags

mappingId   M-Legit-FlagA
target      <https://w3id.org/ratr-o/data/legit-offer/{legit_id}/flag/{flag}> a :ClassicRedFlag .
source      SELECT legit_id, flag FROM ramona.legit_offer_flags WHERE track = 'A'

mappingId   M-Legit-FlagB
target      <https://w3id.org/ratr-o/data/legit-offer/{legit_id}/flag/{flag}> a :CredibleLethalRedFlag .
source      SELECT legit_id, flag FROM ramona.legit_offer_flags WHERE track = 'B'

]]
