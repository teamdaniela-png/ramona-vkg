[PrefixDeclaration]
:       https://w3id.org/ratr-o#
ont:    https://w3id.org/ratr-o#
rdf:    http://www.w3.org/1999/02/22-rdf-syntax-ns#
rdfs:   http://www.w3.org/2000/01/rdf-schema#
xsd:    http://www.w3.org/2001/XMLSchema#
owl:    http://www.w3.org/2002/07/owl#

[MappingDeclaration] @collection [[

mappingId   M-Country
target      <https://w3id.org/ratr-o/data/country/{country_iso3}> a :Country ; :countryName {country_name}^^xsd:string ; :countryISOCode {country_iso3}^^xsd:string .
source      SELECT country_iso3, country_name FROM ramona.countries WHERE country_iso3 IS NOT NULL

mappingId   M-Language
target      <https://w3id.org/ratr-o/data/language/{language_code}> a :Language ; :languageName {language_name}^^xsd:string ; :languageISOCode {language_code}^^xsd:string .
source      SELECT language_code, language_name FROM ramona.languages

mappingId   M-Platform
target      <https://w3id.org/ratr-o/data/platform/{platform_id}> a :Platform ; :platformName {platform_name}^^xsd:string ; :platformType {platform_type}^^xsd:string .
source      SELECT platform_id, platform_name, platform_type FROM ramona.platforms

mappingId   M-Platform-Country
target      <https://w3id.org/ratr-o/data/platform/{platform_id}> :platformCountry <https://w3id.org/ratr-o/data/country/{country_iso3}> .
source      SELECT p.platform_id, c.country_iso3 FROM ramona.platforms p JOIN ramona.countries c ON c.country_code = p.platform_country WHERE c.country_iso3 IS NOT NULL

mappingId   M-EvidenceSource
target      <https://w3id.org/ratr-o/data/evidence/{source_id}> a :EvidenceSource ; :sourceTitle {source_title}^^xsd:string ; :sourceOutlet {source_outlet}^^xsd:string ; :sourceDate {source_date}^^xsd:date .
source      SELECT source_id, source_title, source_outlet, source_date FROM ramona.evidence_sources

mappingId   M-EvidenceSource-PressArticle
target      <https://w3id.org/ratr-o/data/evidence/{source_id}> a :PressArticle .
source      SELECT source_id FROM ramona.evidence_sources WHERE source_kind = 'press_article'

mappingId   M-EvidenceSource-SourceKind
target      <https://w3id.org/ratr-o/data/evidence/{source_id}> :sourceKind {source_kind}^^xsd:string .
source      SELECT source_id, source_kind FROM ramona.evidence_sources WHERE source_kind IS NOT NULL

mappingId   M-Route-VictimCount
target      <https://w3id.org/ratr-o/data/route/{route_id}> :routeVictimCount {victim_count}^^xsd:integer .
source      SELECT r.route_id, c.victim_count FROM ramona.trafficking_routes r JOIN ramona.route_victim_counts c ON r.route_name = c.origin_country || ' -> ' || c.destination_country

mappingId   M-Offer-Evidence
target      <https://w3id.org/ratr-o/data/offer/{offer_id}> :offerDocumentedIn <https://w3id.org/ratr-o/data/evidence/{evidence_source}> .
source      SELECT offer_id, evidence_source FROM ramona.offers WHERE evidence_source IS NOT NULL

mappingId   M-EvidenceSource-URL
target      <https://w3id.org/ratr-o/data/evidence/{source_id}> :sourceUrl {source_url}^^xsd:anyURI .
source      SELECT source_id, source_url FROM ramona.evidence_sources WHERE source_url IS NOT NULL

mappingId   M-Route
target      <https://w3id.org/ratr-o/data/route/{route_id}> a :TraffickingRoute ; :routeName {route_name}^^xsd:string ; :originCountry <https://w3id.org/ratr-o/data/country/{origin_country}> ; :destinationCountry <https://w3id.org/ratr-o/data/country/{destination_country}> .
source      SELECT route_id, route_name, origin_country, destination_country FROM ramona.trafficking_routes

mappingId   M-Route-KnownSince
target      <https://w3id.org/ratr-o/data/route/{route_id}> :knownSince {known_since}^^xsd:date .
source      SELECT route_id, known_since FROM ramona.trafficking_routes WHERE known_since IS NOT NULL

mappingId   M-Route-Evidence
target      <https://w3id.org/ratr-o/data/route/{route_id}> :hasEvidenceSource <https://w3id.org/ratr-o/data/evidence/{evidence_source}> .
source      SELECT route_id, evidence_source FROM ramona.trafficking_routes WHERE evidence_source IS NOT NULL

mappingId   M-Pattern
target      <https://w3id.org/ratr-o/data/pattern/{pattern_id}> a :SurvivorTestimonyPattern ; :patternName {pattern_name}^^xsd:string ; :patternDescription {pattern_description}^^xsd:string .
source      SELECT pattern_id, pattern_name, pattern_description FROM ramona.survivor_patterns

mappingId   M-Pattern-Measures
target      <https://w3id.org/ratr-o/data/pattern/{pattern_id}> :observedCount {observed_count}^^xsd:integer ; :patternHasKind {pattern_kind}^^xsd:string .
source      SELECT pattern_id, observed_count, pattern_kind FROM ramona.survivor_patterns WHERE observed_count IS NOT NULL AND pattern_kind IS NOT NULL

mappingId   M-Pattern-Type-ClassicRedFlagPattern
target      <https://w3id.org/ratr-o/data/pattern/{pattern_id}> a :ClassicRedFlagPattern .
source      SELECT pattern_id FROM ramona.survivor_patterns WHERE pattern_kind = 'classic_a'

mappingId   M-Pattern-Type-CredibleLethalPattern
target      <https://w3id.org/ratr-o/data/pattern/{pattern_id}> a :CredibleLethalPattern .
source      SELECT pattern_id FROM ramona.survivor_patterns WHERE pattern_kind = 'credible_b'

mappingId   M-Pattern-Type-CommunicationPattern
target      <https://w3id.org/ratr-o/data/pattern/{pattern_id}> a :CommunicationPattern .
source      SELECT pattern_id FROM ramona.survivor_patterns WHERE pattern_kind = 'communication'

mappingId   M-Pattern-Type-RecruitmentPattern
target      <https://w3id.org/ratr-o/data/pattern/{pattern_id}> a :RecruitmentPattern .
source      SELECT pattern_id FROM ramona.survivor_patterns WHERE pattern_kind = 'recruitment'

mappingId   M-Pattern-Type-ExploitationPattern
target      <https://w3id.org/ratr-o/data/pattern/{pattern_id}> a :ExploitationPattern .
source      SELECT pattern_id FROM ramona.survivor_patterns WHERE pattern_kind = 'exploitation'

mappingId   M-Pattern-Bucket
target      <https://w3id.org/ratr-o/data/pattern/{pattern_id}> :dominanceBucketValue {dominance_bucket}^^xsd:string ; :hasDominanceBucket <https://w3id.org/ratr-o/data/dominance-bucket/{dominance_bucket}> .
source      SELECT pattern_id, dominance_bucket FROM ramona.survivor_patterns WHERE dominance_bucket IS NOT NULL

mappingId   M-DominanceBucket
target      <https://w3id.org/ratr-o/data/dominance-bucket/{dominance_bucket}> a :DominanceBucket .
source      SELECT DISTINCT dominance_bucket FROM ramona.survivor_patterns WHERE dominance_bucket IS NOT NULL

mappingId   M-Pattern-Evidence
target      <https://w3id.org/ratr-o/data/pattern/{pattern_id}> :derivedFrom <https://w3id.org/ratr-o/data/evidence/{evidence_source}> .
source      SELECT pattern_id, evidence_source FROM ramona.survivor_patterns WHERE evidence_source IS NOT NULL

mappingId   M-Employer
target      <https://w3id.org/ratr-o/data/employer/{employer_id}> a :Employer ; :hasVerifiedIdentity {has_verified_identity}^^xsd:boolean ; :historicalOfferCount {historical_offer_count}^^xsd:integer ; :historicalFlagCount {historical_flag_count}^^xsd:integer .
source      SELECT employer_id, has_verified_identity, historical_offer_count, historical_flag_count FROM ramona.employers

mappingId   M-Employer-Name
target      <https://w3id.org/ratr-o/data/employer/{employer_id}> :agentName {employer_name}^^xsd:string .
source      SELECT employer_id, employer_name FROM ramona.employers WHERE employer_name IS NOT NULL

mappingId   M-Recruiter
target      <https://w3id.org/ratr-o/data/recruiter/{recruiter_id}> a :Recruiter ; :historicalOfferCount {historical_offer_count}^^xsd:integer ; :historicalFlagCount {historical_flag_count}^^xsd:integer .
source      SELECT recruiter_id, historical_offer_count, historical_flag_count FROM ramona.recruiters

mappingId   M-Recruiter-Contact
target      <https://w3id.org/ratr-o/data/recruiter/{recruiter_id}> :contactHash {contact_hash}^^xsd:string .
source      SELECT recruiter_id, contact_hash FROM ramona.recruiters WHERE contact_hash IS NOT NULL

mappingId   M-Recruiter-Name
target      <https://w3id.org/ratr-o/data/recruiter/{recruiter_id}> :agentName {agent_name}^^xsd:string .
source      SELECT recruiter_id, agent_name FROM ramona.recruiters WHERE agent_name IS NOT NULL

mappingId   M-Recruiter-Country
target      <https://w3id.org/ratr-o/data/recruiter/{recruiter_id}> :recruiterCountry <https://w3id.org/ratr-o/data/country/{country_iso3}> .
source      SELECT r.recruiter_id, c.country_iso3 FROM ramona.recruiters r JOIN ramona.countries c ON c.country_code = r.recruiter_country WHERE c.country_iso3 IS NOT NULL

mappingId   M-Candidate
target      <https://w3id.org/ratr-o/data/candidate/{candidate_id}> a :Candidate .
source      SELECT candidate_id FROM ramona.candidates

mappingId   M-Classification
target      <https://w3id.org/ratr-o/data/classification/{classification_id}> a :RiskClassification ; :riskLevel {risk_level}^^xsd:string ; :classifiedOn {classified_at}^^xsd:date ; :classifierVersion {classifier_version}^^xsd:string .
source      SELECT classification_id, risk_level, classified_at, classifier_version FROM ramona.classifications

mappingId   M-Classification-Explanation
target      <https://w3id.org/ratr-o/data/classification/{classification_id}> :explanationText {explanation_text}^^xsd:string .
source      SELECT classification_id, explanation_text FROM ramona.classifications WHERE explanation_text IS NOT NULL

mappingId   M-Offer
target      <https://w3id.org/ratr-o/data/offer/{offer_id}> a :JobOffer ; :hasRawText {raw_text}^^xsd:string ; :inCountry <https://w3id.org/ratr-o/data/country/{country_iso3}> ; :inLanguage <https://w3id.org/ratr-o/data/language/{language_code}> .
source      SELECT o.offer_id, o.raw_text, c.country_iso3, o.language_code FROM ramona.offers o JOIN ramona.countries c ON c.country_code = o.country_code

mappingId   M-Offer-PostedVia
target      <https://w3id.org/ratr-o/data/offer/{offer_id}> :postedVia <https://w3id.org/ratr-o/data/platform/{source_platform}> .
source      SELECT offer_id, source_platform FROM ramona.offers WHERE source_platform IS NOT NULL

mappingId   M-Offer-PostedOn
target      <https://w3id.org/ratr-o/data/offer/{offer_id}> :postedOn {posted_at}^^xsd:date .
source      SELECT offer_id, posted_at FROM ramona.offers WHERE posted_at IS NOT NULL

mappingId   M-Offer-Role
target      <https://w3id.org/ratr-o/data/offer/{offer_id}> :offeredRole {offered_role}^^xsd:string .
source      SELECT offer_id, offered_role FROM ramona.offers WHERE offered_role IS NOT NULL

mappingId   M-Offer-Location
target      <https://w3id.org/ratr-o/data/offer/{offer_id}> :offeredLocation {offered_location}^^xsd:string .
source      SELECT offer_id, offered_location FROM ramona.offers WHERE offered_location IS NOT NULL

mappingId   M-Offer-Salary
target      <https://w3id.org/ratr-o/data/offer/{offer_id}> :offeredSalaryMXN {offered_salary_mxn}^^xsd:decimal .
source      SELECT offer_id, offered_salary_mxn FROM ramona.offers WHERE offered_salary_mxn IS NOT NULL

mappingId   M-Offer-RiskScore
target      <https://w3id.org/ratr-o/data/offer/{offer_id}> :riskScore {risk_score}^^xsd:decimal .
source      SELECT offer_id, risk_score FROM ramona.offers WHERE risk_score IS NOT NULL

mappingId   M-Offer-Recruiter
target      <https://w3id.org/ratr-o/data/offer/{offer_id}> :offeredByRecruiter <https://w3id.org/ratr-o/data/recruiter/{recruiter_id}> ; :offeredBy <https://w3id.org/ratr-o/data/recruiter/{recruiter_id}> .
source      SELECT offer_id, recruiter_id FROM ramona.offers WHERE recruiter_id IS NOT NULL

mappingId   M-Offer-Employer
target      <https://w3id.org/ratr-o/data/offer/{offer_id}> :offeredByEmployer <https://w3id.org/ratr-o/data/employer/{employer_id}> ; :offeredBy <https://w3id.org/ratr-o/data/employer/{employer_id}> .
source      SELECT offer_id, employer_id FROM ramona.offers WHERE employer_id IS NOT NULL

mappingId   M-Offer-Classification
target      <https://w3id.org/ratr-o/data/offer/{offer_id}> :hasRiskClassification <https://w3id.org/ratr-o/data/classification/{classification_id}> .
source      SELECT offer_id, classification_id FROM ramona.offers WHERE classification_id IS NOT NULL

mappingId   M-RedFlag
target      <https://w3id.org/ratr-o/data/flag/{flag_id}> a :RedFlag ; :flagType {flag_type}^^xsd:string ; :flagConfidence {flag_confidence}^^xsd:decimal ; :detectedBy {detected_by}^^xsd:string .
source      SELECT flag_id, flag_type, flag_confidence, detected_by FROM ramona.red_flags

mappingId   M-Offer-RedFlag
target      <https://w3id.org/ratr-o/data/offer/{offer_id}> :hasRedFlag <https://w3id.org/ratr-o/data/flag/{flag_id}> .
source      SELECT flag_id, offer_id FROM ramona.red_flags

mappingId   M-Offer-Pattern
target      <https://w3id.org/ratr-o/data/offer/{offer_id}> :matchesPattern <https://w3id.org/ratr-o/data/pattern/{pattern_id}> .
source      SELECT offer_id, pattern_id FROM ramona.offer_patterns

mappingId   M-Offer-Route
target      <https://w3id.org/ratr-o/data/offer/{offer_id}> :associatedWithRoute <https://w3id.org/ratr-o/data/route/{route_id}> .
source      SELECT offer_id, route_id FROM ramona.offer_routes

mappingId   M-Submission
target      <https://w3id.org/ratr-o/data/submission/{submission_id}> a :Submission ; :submittedBy <https://w3id.org/ratr-o/data/candidate/{candidate_id}> ; :submittedOffer <https://w3id.org/ratr-o/data/offer/{offer_id}> .
source      SELECT submission_id, candidate_id, offer_id FROM ramona.submissions

# =========================================================================
# Victim-centric layer: CTDC records and the press observatory
# =========================================================================

mappingId   M-AgeGroup
target      <https://w3id.org/ratr-o/data/agegroup/{age_group_code}> a :AgeGroup ; :ageGroupName {age_group_label}^^xsd:string .
source      SELECT age_group_code, age_group_label FROM public.age_group

mappingId   M-Gender
target      <https://w3id.org/ratr-o/data/gender/{gender_code}> a :Gender ; :genderName {gender_label}^^xsd:string .
source      SELECT gender_code, gender_label FROM public.gender

mappingId   M-RecruitmentMethod
target      <https://w3id.org/ratr-o/data/recruitmentmethod/{recruitment_method_code}> a :RecruitmentMethod ; :recruitmentMethodName {recruitment_method_label}^^xsd:string .
source      SELECT recruitment_method_code, recruitment_method_label FROM public.recruitment_method

mappingId   M-ExploitationType
target      <https://w3id.org/ratr-o/data/exploitation/{exploitation_type_code}> a :TypeOfExploitation ; :exploitationType {exploitation_type_label}^^xsd:string .
source      SELECT exploitation_type_code, exploitation_type_label FROM public.exploitation_type

mappingId   M-Vulnerability
target      <https://w3id.org/ratr-o/data/vulnerability/{vulnerability_code}> a :VulnerabilityFactor ; :vulnerabilityFactorName {vulnerability_label}^^xsd:string .
source      SELECT vulnerability_code, vulnerability_label FROM public.vulnerability_factor

mappingId   M-CommunicationTool
target      <https://w3id.org/ratr-o/data/tool/{tool_code}> a :CommunicationTool ; :communicationToolName {tool_label}^^xsd:string .
source      SELECT tool_code, tool_label FROM public.communication_tool

mappingId   M-TransportationMeans
target      <https://w3id.org/ratr-o/data/transport/{tm_code}> a :TransportationMeans ; :transportationMeansName {tm_label}^^xsd:string .
source      SELECT tm_code, tm_label FROM public.transportation_means

mappingId   M-DocumentationType
target      <https://w3id.org/ratr-o/data/doc/{doc_code}> a :DocumentationType ; :documentationTypeName {doc_label}^^xsd:string .
source      SELECT doc_code, doc_label FROM public.documentation_type

mappingId   M-EvidenceSourceExtended
target      <https://w3id.org/ratr-o/data/evidence-ext/{source_id}> a :EvidenceSource ; :sourceTitle {title}^^xsd:string ; :sourceOutlet {outlet}^^xsd:string .
source      SELECT source_id, title, outlet FROM public.evidence_source_extended

mappingId   M-EvidenceSource-Author
target      <https://w3id.org/ratr-o/data/evidence-ext/{source_id}> :sourceAuthor {author}^^xsd:string .
source      SELECT source_id, author FROM public.evidence_source_extended WHERE author IS NOT NULL

mappingId   M-EvidenceSource-DatasetRecord
target      <https://w3id.org/ratr-o/data/evidence-ext/{source_id}> :datasetRecordId {dataset_record_id}^^xsd:string .
source      SELECT source_id, dataset_record_id FROM public.evidence_source_extended WHERE dataset_record_id IS NOT NULL AND source_kind IN ('ctdc','unodc','rnpdno')

mappingId   M-EvidenceSource-Kind
target      <https://w3id.org/ratr-o/data/evidence-ext/{source_id}> :sourceKind {source_kind}^^xsd:string .
source      SELECT source_id, source_kind FROM public.evidence_source_extended

mappingId   M-PressArticle
target      <https://w3id.org/ratr-o/data/evidence-ext/{source_id}> a :PressArticle ; :sourceUrl {url}^^xsd:anyURI .
source      SELECT source_id, url FROM public.evidence_source_extended WHERE source_kind = 'press' AND url IS NOT NULL

mappingId   M-OpenDatasetRecord
target      <https://w3id.org/ratr-o/data/evidence-ext/{source_id}> a :OpenDatasetRecord ; :datasetName {dataset_name}^^xsd:string .
source      SELECT source_id, dataset_name FROM public.evidence_source_extended WHERE source_kind IN ('ctdc','unodc','rnpdno')

mappingId   M-Victim
target      <https://w3id.org/ratr-o/data/victim/{victim_id}> a :Victim ; :victimId {external_id}^^xsd:string ; :yearOfRegistration {year_of_registration}^^xsd:gYear .
source      SELECT victim_id, external_id, year_of_registration FROM public.victim WHERE year_of_registration IS NOT NULL

mappingId   M-Victim-NoYear
target      <https://w3id.org/ratr-o/data/victim/{victim_id}> a :Victim ; :victimId {external_id}^^xsd:string .
source      SELECT victim_id, external_id FROM public.victim WHERE year_of_registration IS NULL

mappingId   M-Victim-Source
target      <https://w3id.org/ratr-o/data/victim/{victim_id}> :hasEvidenceSource <https://w3id.org/ratr-o/data/evidence-ext/{source_id}> .
source      SELECT victim_id, source_id FROM public.victim WHERE source_id IS NOT NULL

mappingId   M-Victim-Profile
target      <https://w3id.org/ratr-o/data/victim/{victim_id}> :hasDemographicProfile <https://w3id.org/ratr-o/data/victim/{victim_id}/profile> .
source      SELECT v.victim_id FROM public.victim v WHERE v.age_group_code IS NOT NULL OR v.gender_code IS NOT NULL OR v.citizenship_iso3 IS NOT NULL OR EXISTS (SELECT 1 FROM public.victim_vulnerability vv WHERE vv.victim_id = v.victim_id)

mappingId   M-Victim-ProfileType
target      <https://w3id.org/ratr-o/data/victim/{victim_id}/profile> a :DemographicProfile .
source      SELECT v.victim_id FROM public.victim v WHERE v.age_group_code IS NOT NULL OR v.gender_code IS NOT NULL OR v.citizenship_iso3 IS NOT NULL OR EXISTS (SELECT 1 FROM public.victim_vulnerability vv WHERE vv.victim_id = v.victim_id)

mappingId   M-Victim-Age
target      <https://w3id.org/ratr-o/data/victim/{victim_id}/profile> :hasAgeGroup <https://w3id.org/ratr-o/data/agegroup/{age_group_code}> .
source      SELECT victim_id, age_group_code FROM public.victim WHERE age_group_code IS NOT NULL

mappingId   M-Victim-Gender
target      <https://w3id.org/ratr-o/data/victim/{victim_id}/profile> :hasGender <https://w3id.org/ratr-o/data/gender/{gender_code}> .
source      SELECT victim_id, gender_code FROM public.victim WHERE gender_code IS NOT NULL

mappingId   M-Victim-Citizenship
target      <https://w3id.org/ratr-o/data/victim/{victim_id}/profile> :hasNationality <https://w3id.org/ratr-o/data/country/{citizenship_iso3}> .
source      SELECT victim_id, citizenship_iso3 FROM public.victim WHERE citizenship_iso3 IS NOT NULL

mappingId   M-Victim-CoE
target      <https://w3id.org/ratr-o/data/victim/{victim_id}> :exploitedInCountry <https://w3id.org/ratr-o/data/country/{country_of_exploitation_iso3}> .
source      SELECT victim_id, country_of_exploitation_iso3 FROM public.victim WHERE country_of_exploitation_iso3 IS NOT NULL

mappingId   M-Victim-Recruitment
target      <https://w3id.org/ratr-o/data/victim/{victim_id}> :recruitedVia <https://w3id.org/ratr-o/data/recruitmentmethod/{recruitment_method_code}> .
source      SELECT victim_id, recruitment_method_code FROM public.victim WHERE recruitment_method_code IS NOT NULL

mappingId   M-Victim-CommunicationTool
target      <https://w3id.org/ratr-o/data/victim/{victim_id}> :contactedThrough <https://w3id.org/ratr-o/data/tool/{communication_tool_code}> .
source      SELECT victim_id, communication_tool_code FROM public.victim WHERE communication_tool_code IS NOT NULL

mappingId   M-Victim-Exploitation
target      <https://w3id.org/ratr-o/data/victim/{victim_id}> :victimOfExploitation <https://w3id.org/ratr-o/data/exploitation/{exploitation_type_code}> .
source      SELECT victim_id, exploitation_type_code FROM public.victim_exploitation

mappingId   M-Victim-Means
target      <https://w3id.org/ratr-o/data/victim/{victim_id}> :hasMeansOfControl {means_code}^^xsd:string .
source      SELECT victim_id, means_code FROM public.victim_means_of_control

mappingId   M-Victim-Vulnerability
target      <https://w3id.org/ratr-o/data/victim/{victim_id}/profile> :hasVulnerabilityFactor <https://w3id.org/ratr-o/data/vulnerability/{vulnerability_code}> .
source      SELECT victim_id, vulnerability_code FROM public.victim_vulnerability

mappingId   M-Victim-Transport
target      <https://w3id.org/ratr-o/data/victim/{victim_id}> :transportedBy <https://w3id.org/ratr-o/data/transport/{transportation_code}> .
source      SELECT victim_id, transportation_code FROM public.victim WHERE transportation_code IS NOT NULL

mappingId   M-Victim-Documentation
target      <https://w3id.org/ratr-o/data/victim/{victim_id}> :travelledWith <https://w3id.org/ratr-o/data/doc/{documentation_code}> .
source      SELECT victim_id, documentation_code FROM public.victim WHERE documentation_code IS NOT NULL

mappingId   M-Exemplar-Scheme
target      <https://w3id.org/ratr-o/data/scheme/{scheme_code}> :schemeCode {scheme_code}^^xsd:string ; :evidencedByPressArticle <https://w3id.org/ratr-o/data/evidence/{source_id}> .
source      SELECT x.scheme_code, e.source_id FROM ramona.fraudscheme_exemplars x JOIN ramona.evidence_sources e ON e.source_url = x.url

mappingId   M-Exemplar-SchemeType-AgriculturalBondageScheme
target      <https://w3id.org/ratr-o/data/scheme/{scheme_code}> a :AgriculturalBondageScheme .
source      SELECT DISTINCT scheme_code FROM ramona.fraudscheme_exemplars WHERE scheme_code = 'AgriculturalBondageScheme'

mappingId   M-Exemplar-SchemeType-CentralAmericanMigrantLabourScheme
target      <https://w3id.org/ratr-o/data/scheme/{scheme_code}> a :CentralAmericanMigrantLabourScheme .
source      SELECT DISTINCT scheme_code FROM ramona.fraudscheme_exemplars WHERE scheme_code = 'CentralAmericanMigrantLabourScheme'

mappingId   M-Exemplar-SchemeType-ChildRecruitmentCriminalScheme
target      <https://w3id.org/ratr-o/data/scheme/{scheme_code}> a :ChildRecruitmentCriminalScheme .
source      SELECT DISTINCT scheme_code FROM ramona.fraudscheme_exemplars WHERE scheme_code = 'ChildRecruitmentCriminalScheme'

mappingId   M-Exemplar-SchemeType-ConstructionLabourBondageScheme
target      <https://w3id.org/ratr-o/data/scheme/{scheme_code}> a :ConstructionLabourBondageScheme .
source      SELECT DISTINCT scheme_code FROM ramona.fraudscheme_exemplars WHERE scheme_code = 'ConstructionLabourBondageScheme'

mappingId   M-Exemplar-SchemeType-ForcedCriminalityScheme
target      <https://w3id.org/ratr-o/data/scheme/{scheme_code}> a :ForcedCriminalityScheme .
source      SELECT DISTINCT scheme_code FROM ramona.fraudscheme_exemplars WHERE scheme_code = 'ForcedCriminalityScheme'

mappingId   M-Exemplar-SchemeType-ForeignLanguageTeacherScheme
target      <https://w3id.org/ratr-o/data/scheme/{scheme_code}> a :ForeignLanguageTeacherScheme .
source      SELECT DISTINCT scheme_code FROM ramona.fraudscheme_exemplars WHERE scheme_code = 'ForeignLanguageTeacherScheme'

mappingId   M-Exemplar-SchemeType-GangRecruitmentSchoolsScheme
target      <https://w3id.org/ratr-o/data/scheme/{scheme_code}> a :GangRecruitmentSchoolsScheme .
source      SELECT DISTINCT scheme_code FROM ramona.fraudscheme_exemplars WHERE scheme_code = 'GangRecruitmentSchoolsScheme'

