@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix : <https://ramona.ai/ont#> .
@prefix ont: <https://ramona.ai/ont#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<#TM_M_Country> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT country_code, country_name FROM ramona.countries""" ] ;
    rr:subjectMap [
        rr:template "https://ramona.ai/country/{country_code}" ;
        rr:class :Country ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate :countryName ;
        rr:objectMap [ rr:column "country_name" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :countryISOCode ;
        rr:objectMap [ rr:column "country_code" ; rr:datatype xsd:string ]
    ] .

