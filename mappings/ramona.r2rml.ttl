    rr:logicalTable [ rr:sqlQuery """SELECT source_id, url FROM public.evidence_source_extended WHERE source_kind = 'press' AND url IS NOT NULL""" ] ;
    rr:subjectMap [
        rr:template "https://ramona.ai/evidence-ext/{source_id}" ;
        rr:class :PressArticle ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate :sourceUrl ;
        rr:objectMap [ rr:column "url" ; rr:datatype xsd:anyURI ]
    ] .

<#TM_M_OpenDatasetRecord> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT source_id, dataset_name FROM public.evidence_source_extended WHERE source_kind IN ('ctdc','unodc','rnpdno')""" ] ;
    rr:subjectMap [
        rr:template "https://ramona.ai/evidence-ext/{source_id}" ;
        rr:class :OpenDatasetRecord ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate :datasetName ;
        rr:objectMap [ rr:column "dataset_name" ; rr:datatype xsd:string ]
    ] .

