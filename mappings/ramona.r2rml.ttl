<#TM_M_Route_VictimCount> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT r.route_id, c.victim_count FROM ramona.trafficking_routes r JOIN ramona.route_victim_counts c ON r.route_name = c.origin_country || ' -> ' || c.destination_country""" ] ;
