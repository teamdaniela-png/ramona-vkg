    ] .

<#TM_M_Platform_Country> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT p.platform_id, c.country_iso3 FROM ramona.platforms p JOIN ramona.countries c ON c.country_code = p.platform_country WHERE c.country_iso3 IS NOT NULL""" ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ratr-o/data/platform/{platform_id}" ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate :platformCountry ;
        rr:objectMap [ rr:template "https://w3id.org/ratr-o/data/country/{country_iso3}" ]
    ] .

