# Ramona VKG — W3C R2RML mapping
# Converted from mappings/ramona.obda (Ontop native format) by scripts/obda_to_r2rml.py
# Licence: Apache 2.0.

@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <https://w3id.org/ratr-o#> .
@prefix ont: <https://w3id.org/ratr-o#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<#TM_M_Country> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT country_iso3, country_name FROM ramona.countries WHERE country_iso3 IS NOT NULL""" ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ratr-o/data/country/{country_iso3}" ;
        rr:class :Country ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate :countryName ;
        rr:objectMap [ rr:column "country_name" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :countryISOCode ;
        rr:objectMap [ rr:column "country_iso3" ; rr:datatype xsd:string ]
    ] .

<#TM_M_Language> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT language_code, language_name FROM ramona.languages""" ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ratr-o/data/language/{language_code}" ;
        rr:class :Language ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate :languageName ;
        rr:objectMap [ rr:column "language_name" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :languageISOCode ;
        rr:objectMap [ rr:column "language_code" ; rr:datatype xsd:string ]
    ] .

<#TM_M_Platform> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT platform_id, platform_name, platform_type FROM ramona.platforms""" ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ratr-o/data/platform/{platform_id}" ;
        rr:class :Platform ;
