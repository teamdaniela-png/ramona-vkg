    rr:logicalTable [ rr:sqlQuery """SELECT legit_id, job_title FROM ramona.legit_offers""" ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ratr-o/data/legit-offer/{legit_id}" ;
        rr:class :JobOffer ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate :offeredRole ;
        rr:objectMap [ rr:column "job_title" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :offeredByEmployer ;
        rr:objectMap [ rr:template "https://w3id.org/ratr-o/data/legit-offer/{legit_id}/employer" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :offerDocumentedIn ;
        rr:objectMap [ rr:template "https://w3id.org/ratr-o/data/legit-offer/{legit_id}/posting" ]
    ] .

<#TM_M_Legit_Country> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT l.legit_id, c.country_iso3 FROM ramona.legit_offers l JOIN ramona.countries c ON c.country_code = l.country_code""" ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ratr-o/data/legit-offer/{legit_id}" ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate :inCountry ;
        rr:objectMap [ rr:template "https://w3id.org/ratr-o/data/country/{country_iso3}" ]
    ] .

