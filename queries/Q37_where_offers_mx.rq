PREFIX : <https://w3id.org/ratr-o#>
# Q37 (CQ33). Where are real recruitment offers in Mexico located? (offered location as reported)
SELECT ?state (COUNT(DISTINCT ?offer) AS ?n) WHERE {
  ?offer a :JobOffer ; :inCountry <https://w3id.org/ratr-o/data/country/MEX> ; :offeredLocation ?loc .
  VALUES (?state ?rx) { ("Jalisco" "jalisco|guadalajara|zapopan|teuchitl|tlaquepaque") ("CDMX" "cdmx|ciudad de m[eé]xico|iztapalapa")
    ("Estado de Mexico" "estado de m[eé]xico|edomex|ecatepec|toluca") ("Puebla" "puebla") ("Chihuahua" "chihuahua|ju[aá]rez")
    ("Quintana Roo" "quintana roo|canc[uú]n") ("Guanajuato" "guanajuato|le[oó]n|celaya") ("Michoacan" "michoac[aá]n|morelia|uruapan")
    ("Tamaulipas" "tamaulipas|reynosa|nuevo laredo") ("Sinaloa" "sinaloa|culiac[aá]n") ("Baja California" "baja california|tijuana") }
  FILTER(REGEX(?loc, ?rx, "i"))
}
GROUP BY ?state ORDER BY DESC(?n)
