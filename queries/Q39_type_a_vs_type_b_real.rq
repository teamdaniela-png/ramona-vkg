PREFIX : <https://w3id.org/ratr-o#>

# Q39. Press-documented offers with at least one red flag: classic only, credible-lethal only, or
# both. Not a prevalence estimate.

SELECT ?profile (COUNT(DISTINCT ?offer) AS ?n) WHERE {
  ?offer :offerDocumentedIn ?article ; :hasRedFlag ?f .
  ?article a :PressArticle .
  BIND(EXISTS { ?offer :hasRedFlag ?a . ?a a :ClassicRedFlag } AS ?hasA)
  BIND(EXISTS { ?offer :hasRedFlag ?b . ?b a :CredibleLethalRedFlag } AS ?hasB)
  BIND(IF(?hasA && ?hasB, "both", IF(?hasA, "classic only", "credible-lethal only")) AS ?profile)
}
GROUP BY ?profile
