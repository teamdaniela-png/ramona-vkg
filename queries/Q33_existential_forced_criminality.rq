PREFIX : <https://w3id.org/ratr-o#>

# Q33. Offers that exhibit some forced-criminality scheme: the certain answers under the
# existential axioms of the ontology,
#   DirectRecruitmentPost    SubClassOf exhibitsFraudScheme some ForcedCriminalityScheme
#   CriminalRecruitmentOffer SubClassOf exhibitsFraudScheme some ForcedCriminalityScheme
# The second and third branches of the union are the rewriting of the first under those axioms:
# no row links such an offer to a scheme.

SELECT (COUNT(DISTINCT ?offer) AS ?n) WHERE {
  { ?offer :exhibitsFraudScheme ?scheme . ?scheme a :ForcedCriminalityScheme }
  UNION
  { ?offer a :DirectRecruitmentPost }
  UNION
  { ?offer a :CriminalRecruitmentOffer }
}
