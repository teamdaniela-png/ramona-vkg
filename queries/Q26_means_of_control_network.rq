PREFIX : <https://w3id.org/ratr-o#>

# Q26. Co-occurrence of means of control (CTDC).

SELECT ?means1 ?means2 (COUNT(DISTINCT ?victim) AS ?victims)
WHERE {
  ?victim a :Victim ;
          :hasMeansOfControl ?m1 , ?m2 ;
          :hasEvidenceSource ?source .
  ?source :datasetName "CTDC Global Synthetic Dataset v2025" .
  FILTER(STR(?m1) < STR(?m2))
  BIND(?m1 AS ?means1)
  BIND(?m2 AS ?means2)
}
GROUP BY ?means1 ?means2
HAVING (COUNT(DISTINCT ?victim) >= 50)
ORDER BY DESC(?victims)
LIMIT 50
