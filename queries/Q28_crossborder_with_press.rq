PREFIX : <https://w3id.org/ratr-o#>

# Q28. Cross-border CTDC corridors that also have press coverage.

SELECT ?origin ?destination ?victims ?pressArticles
WHERE {
  ?route a :TraffickingRoute ;
         :originCountry/:countryISOCode ?origin ;
         :destinationCountry/:countryISOCode ?destination ;
         :routeVictimCount ?victims .
  FILTER(?origin != ?destination)
  {
    SELECT ?route (COUNT(DISTINCT ?article) AS ?pressArticles)
    WHERE {
      ?offer :associatedWithRoute ?route ;
             :offerDocumentedIn ?article .
      ?article a :PressArticle .
    }
    GROUP BY ?route
  }
}
ORDER BY DESC(?pressArticles) DESC(?victims)
LIMIT 50
