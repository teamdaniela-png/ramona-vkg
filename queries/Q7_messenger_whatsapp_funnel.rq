PREFIX : <https://w3id.org/ratr-o#>

# Q7. Messenger-to-WhatsApp funnel with personal-data filtering.

SELECT ?offer ?platformName ?role ?posted WHERE {
  ?offer :matchesPattern <https://w3id.org/ratr-o/data/pattern/1> ,  # messenger_to_whatsapp
                         <https://w3id.org/ratr-o/data/pattern/2> ;  # filtro_datos_personales
         :postedVia ?platform ;
         :postedOn ?posted ;
         :offeredRole ?role .
  ?platform :platformName ?platformName .
}
ORDER BY DESC(?posted)
