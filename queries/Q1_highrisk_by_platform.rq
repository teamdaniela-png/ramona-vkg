PREFIX : <https://w3id.org/ratr-o#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q1. High-risk and fraudulent offers posted since 1 January 2026, grouped by platform.

SELECT ?platformName (COUNT(?offer) AS ?nOffers) WHERE {
  ?offer a :JobOffer ;
         :hasRiskClassification ?rc ;
         :postedVia ?platform ;
         :postedOn ?d .
  ?rc :riskLevel ?level .
  ?platform :platformName ?platformName .
  FILTER(?level IN ("high-risk","fraudulent"))
  FILTER(?d >= "2026-01-01"^^xsd:date)
}
GROUP BY ?platformName
ORDER BY DESC(?nOffers)
