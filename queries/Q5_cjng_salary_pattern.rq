PREFIX : <https://w3id.org/ratr-o#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q5. Offers matching the CJNG post-Rancho Izaguirre pattern.
# Weekly salary between 4,000 and 12,000 MXN, offered as private security.

SELECT ?offer ?role ?location ?salary ?posted WHERE {
  ?offer :offeredSalaryMXN ?salary ;
         :offeredRole ?role ;
         :offeredLocation ?location ;
         :postedOn ?posted .
  FILTER(?salary >= 4000 && ?salary <= 12000)
  FILTER(CONTAINS(LCASE(?role), "seguridad") || CONTAINS(LCASE(?role), "guardia"))
}
ORDER BY DESC(?salary)
