PREFIX : <https://w3id.org/ratr-o#>

# Q24. Routes documented in the press and not attested in CTDC.

SELECT DISTINCT ?origin ?destination ?source ?outletName
WHERE {
  ?source a :PressArticle ;
          :sourceOutlet ?outletName .
  ?offer :offerDocumentedIn ?source ;
         :associatedWithRoute ?route .
  ?route :originCountry/:countryISOCode ?origin ;
         :destinationCountry/:countryISOCode ?destination .
  FILTER NOT EXISTS { ?route :routeVictimCount ?ctdcVictims }
}
ORDER BY ?origin ?destination
LIMIT 100
