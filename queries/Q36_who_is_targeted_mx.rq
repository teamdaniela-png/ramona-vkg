PREFIX : <https://w3id.org/ratr-o#>

# Q36. Who the verified press-documented offers in Mexico target.

SELECT ?group (COUNT(DISTINCT ?offer) AS ?n) WHERE {
  ?offer :extractionConfidence ?confidence ; :inCountry <https://w3id.org/ratr-o/data/country/MEX> ; :offerTargetProfile ?p .
  VALUES (?group ?rx) { ("young people" "j[oó]ven") ("women" "mujer|chica") ("adolescents or minors" "adolesc|menor|ni[ñn][ao]|15|16|17")
                        ("men" "hombre|var[oó]n") ("migrants" "migrant|centroameric|extranjer") ("students" "estudiant")
                        ("Indigenous people" "indígena|indigena") }
  FILTER(REGEX(?p, ?rx, "i"))
}
GROUP BY ?group ORDER BY DESC(?n)
