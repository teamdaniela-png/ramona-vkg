PREFIX : <https://w3id.org/ratr-o#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q12 — Demographic cross-section: age-group x gender x exploitation type.
# Showcases how the ontology collapses a multi-source, multi-table query into
# a single readable SPARQL expression, which is the core argument of the VKG
# paradigm (Xiao et al., 2019).

SELECT ?ageGroup ?gender ?exploitationType (COUNT(DISTINCT ?victim) AS ?victims)
WHERE {
  ?victim a :Victim ;
          :hasDemographicProfile ?prof ;
          :victimOfExploitation ?exp .
  ?prof :hasAgeGroup ?ag ;
        :hasGender ?g .
  ?ag :ageGroupName ?ageGroup .
  ?g :genderName ?gender .
  ?exp :exploitationType ?exploitationType .
}
GROUP BY ?ageGroup ?gender ?exploitationType
HAVING (COUNT(DISTINCT ?victim) >= 3)
ORDER BY DESC(?victims)
LIMIT 200
