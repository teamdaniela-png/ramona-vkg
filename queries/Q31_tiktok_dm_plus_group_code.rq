PREFIX : <https://w3id.org/ratr-o#>

# Q31. Social-media posts that combine a call to a private channel with a coded reference to a
# criminal group.

SELECT ?item ?text WHERE {
  ?item a :SocialMediaPost ;
        :itemText ?text ;
        :itemHasSignal ?s1 , ?s2 .
  ?s1 a :PrivateChannelCallSignal .
  ?s2 a :GroupCodeSignal .
}
ORDER BY ?item
