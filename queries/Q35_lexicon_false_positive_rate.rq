PREFIX : <https://w3id.org/ratr-o#>

# Q35 (CQ31). Which lexicon terms also fire on posts that are NOT recruitment?
# Operational question: which keywords cannot be used alone as a detector
# ("jale", "plaza", "manda mensaje" appear in legitimate job ads too).

SELECT ?term ?termText (COUNT(DISTINCT ?post) AS ?nonRecruitmentHits) WHERE {
  ?post a :SocialMediaPost ;
        :itemMatchesTerm ?term .
  ?term :lexiconTermText ?termText .
  FILTER NOT EXISTS { ?post a :DirectRecruitmentPost }
  FILTER NOT EXISTS { ?post a :CriminalLifeAspirationPost }
}
GROUP BY ?term ?termText
ORDER BY DESC(?nonRecruitmentHits)
