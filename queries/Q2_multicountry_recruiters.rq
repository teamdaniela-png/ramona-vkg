PREFIX : <https://w3id.org/ratr-o#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q2. Recruiters with offers in two or more countries and more than two red flags, on offers posted
# since 1 January 2026.

SELECT ?recruiter
       (COUNT(DISTINCT ?country) AS ?nCountries)
       (COUNT(DISTINCT ?flag)    AS ?nFlags)
WHERE {
  ?offer :offeredByRecruiter ?recruiter ;
         :inCountry ?country ;
         :hasRedFlag ?flag ;
         :postedOn ?d .
  FILTER(?d >= "2026-01-01"^^xsd:date)
}
GROUP BY ?recruiter
HAVING (COUNT(DISTINCT ?country) >= 2 && COUNT(DISTINCT ?flag) > 2)
ORDER BY DESC(?nFlags)
