PREFIX : <https://w3id.org/ratr-o#>

# Q29. Offers matching credible-lethal patterns and none of the classic red flags.

SELECT ?offer ?source ?outlet ?title ?country
WHERE {
  ?offer :offerDocumentedIn ?source ;
         :matchesPattern ?patternB ;
         :inCountry/:countryISOCode ?country .
  ?patternB a :CredibleLethalPattern .
  ?source a :PressArticle ;
          :sourceOutlet ?outlet ;
          :sourceTitle ?title .
  FILTER NOT EXISTS {
    ?offer :matchesPattern ?patternA .
    ?patternA a :ClassicRedFlagPattern .
  }
}
ORDER BY ?country ?outlet
LIMIT 200
