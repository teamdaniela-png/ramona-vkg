PREFIX : <https://w3id.org/ratr-o#>

# Q25. Victims registered in CTDC by year.

SELECT ?year (COUNT(DISTINCT ?victim) AS ?victims)
WHERE {
  ?victim a :Victim ;
          :yearOfRegistration ?year ;
          :hasEvidenceSource ?source .
  ?source :datasetName "CTDC Global Synthetic Dataset v2025" .
}
GROUP BY ?year
ORDER BY ?year
