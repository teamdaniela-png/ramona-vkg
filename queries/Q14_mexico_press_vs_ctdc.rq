PREFIX : <https://ramona.ai/ont#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q14 — Mexico: press-documented victims vs CTDC-registered victims.
# The same SPARQL federates across two radically different sources (scraped
# press articles and an IOM administrative dataset) because both are mediated
# by the same Victim class in RATR-O. This is the concrete payoff of OBDA
# for a public observatory.

SELECT ?datasetOrPress (COUNT(DISTINCT ?victim) AS ?victims)
WHERE {
  ?victim a :Victim ;
          :inCountry ?country ;
          :derivedFrom ?source .
  ?country :countryISOCode "MEX" .
  ?source :datasetName ?datasetOrPress .
}
GROUP BY ?datasetOrPress
ORDER BY DESC(?victims)
