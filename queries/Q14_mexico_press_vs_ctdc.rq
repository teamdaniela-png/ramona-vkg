PREFIX : <https://w3id.org/ratr-o#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q14. Mexico: press-documented vs CTDC-registered victims (cross-source federation).

SELECT ?datasetOrPress (COUNT(DISTINCT ?victim) AS ?victims)
WHERE {
  ?victim a :Victim ;
          :exploitedInCountry ?country ;
          :hasEvidenceSource ?source .
  ?country :countryISOCode "MEX" .
  ?source :sourceKind ?datasetOrPress .
}
GROUP BY ?datasetOrPress
ORDER BY DESC(?victims)
