PREFIX : <https://w3id.org/ratr-o#>

# Q21. Pairs of patterns that co-occur on offers from the same source.

SELECT ?pattern1 ?pattern2 (COUNT(DISTINCT ?source) AS ?coOccurrences)
WHERE {
  ?offer :offerDocumentedIn ?source ;
         :matchesPattern ?p1 , ?p2 .
  ?p1 :patternName ?pattern1 .
  ?p2 :patternName ?pattern2 .
  FILTER(STR(?pattern1) < STR(?pattern2))
}
GROUP BY ?pattern1 ?pattern2
HAVING (COUNT(DISTINCT ?source) >= 3)
ORDER BY DESC(?coOccurrences)
LIMIT 50
