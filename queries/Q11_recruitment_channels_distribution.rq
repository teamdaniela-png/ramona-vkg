PREFIX : <https://w3id.org/ratr-o#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q11. First-contact communication tool distribution across all sources.

SELECT ?toolName (COUNT(DISTINCT ?victim) AS ?victims)
WHERE {
  ?victim a :Victim ;
          :contactedThrough ?tool .
  ?tool :communicationToolName ?toolName .
}
GROUP BY ?toolName
ORDER BY DESC(?victims)
