PREFIX : <https://w3id.org/ratr-o#>

# Q23. Schemes that share WhatsApp as the first channel.

SELECT ?schemeCode (COUNT(DISTINCT ?victim) AS ?victims)
WHERE {
  ?victim :victimOfFraudScheme ?scheme ;
          :contactedThrough ?tool .
  ?tool :communicationToolName "WhatsApp" .
  ?scheme :schemeCode ?schemeCode .
}
GROUP BY ?schemeCode
ORDER BY DESC(?victims)
