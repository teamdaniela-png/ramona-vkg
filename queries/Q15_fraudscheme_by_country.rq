PREFIX : <https://w3id.org/ratr-o#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q15. Fraud schemes by country.

SELECT ?countryIso ?schemeCode (COUNT(DISTINCT ?exemplar) AS ?cases)
WHERE {
  ?exemplar :exhibitsFraudScheme ?scheme ;
            :inCountry ?country .
  ?scheme a :FraudScheme .
  ?scheme :schemeCode ?schemeCode .
  ?country :countryISOCode ?countryIso .
}
GROUP BY ?countryIso ?schemeCode
ORDER BY ?countryIso DESC(?cases)
