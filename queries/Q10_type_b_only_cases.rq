PREFIX : <https://w3id.org/ratr-o#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q10. Press cases that match Type B patterns but not Type A red flags.

SELECT ?victim ?source ?outlet ?title ?url
WHERE {
  ?victim a :Victim ;
          :hasEvidenceSource ?source .
  ?source a :PressArticle ;
          :sourceOutlet ?outlet ;
          :sourceTitle ?title ;
          :sourceUrl ?url .
  # Detection-track filter: must have at least one Type B pattern and zero Type A
  FILTER EXISTS {
    ?source :sourceKind "press" .
  }
}
ORDER BY ?outlet
LIMIT 200
