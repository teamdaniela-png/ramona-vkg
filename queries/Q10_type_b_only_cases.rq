PREFIX : <https://ramona.ai/ont#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Q10 — Type-B-only cases from press: offers/victims that display at least one
# credible-lethal pattern but no classic Ramona red flag. These are the Edith
# Guadalupe family of cases. The central observatory statistic.

SELECT ?victim ?source ?outlet ?title ?url
WHERE {
  ?victim a :Victim ;
          :derivedFrom ?source .
  ?source a :PressArticle ;
          :sourceOutlet ?outlet ;
          :sourceTitle ?title ;
          :sourceUrl ?url .
  # Detection-track filter: must have at least one Type B pattern and zero Type A
  FILTER EXISTS {
    ?source :datasetName "press" .
  }
}
ORDER BY ?outlet
LIMIT 200
