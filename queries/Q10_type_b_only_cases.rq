PREFIX : <https://w3id.org/ratr-o#>

# Q10. Press-documented offers with credible-lethal red flags and no classic red flag.

SELECT DISTINCT ?offer ?outlet ?url
WHERE {
  ?offer :offerDocumentedIn ?source ;
         :hasRedFlag ?flagB .
  ?flagB a :CredibleLethalRedFlag .
  ?source a :PressArticle ;
          :sourceOutlet ?outlet .
  OPTIONAL { ?source :sourceUrl ?url }
  FILTER NOT EXISTS {
    ?offer :hasRedFlag ?flagA .
    ?flagA a :ClassicRedFlag .
  }
}
ORDER BY ?outlet ?offer
